{
  "name": "iracedeck",
  "version": "3.2.0-dev.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static",
      "keysender"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:stream-deck": "pnpm --filter \"@iracedeck/iracing-sdk\" --filter \"@iracedeck/iracing-plugin-stream-deck\" install",
    "build:ts": "turbo run build --filter=!@iracedeck/iracing-native --filter=!@iracedeck/website",
    "build:force": "turbo run build --force",
    "capture:settings": "node scripts/capture-settings-window.mjs",
    "build:native": "pnpm --filter @iracedeck/iracing-native build",
    "generate:action-comms": "tsx scripts/generate-action-comms.mjs",
    "generate:action-profiles": "node scripts/generate-action-profiles.mjs",
    "generate:callout-scripts": "pnpm --filter @iracedeck/audio-assets generate:callout-scripts",
    "generate:changelog-data": "node scripts/generate-changelog-data.mjs",
    "generate:getting-started-data": "node scripts/generate-getting-started-data.mjs",
    "generate:pack-reference": "node scripts/generate-pack-reference.mjs",
    "discord:feature-requests": "node scripts/discord/feature-requests.mjs",
    "build:with-restart": "node scripts/build-with-restart.mjs",
    "build:stream-deck": "pnpm build:ts && pnpm restart:stream-deck",
    "restart:stream-deck": "streamdeck restart com.iracedeck.sd.core",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "lint": "eslint \"packages/*/src/**\" \"scripts/**/*.mjs\" vitest.config.ts",
    "lint:fix": "eslint --fix \"packages/*/src/**\" vitest.config.ts",
    "format": "prettier --check \"**/*.ts\" \"**/*.json\"",
    "format:fix": "prettier --write \"**/*.ts\" \"**/*.json\"",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "precommit": "pnpm lint:fix && pnpm format:fix && pnpm install && pnpm clean && pnpm build && pnpm typecheck",
    "start:stream-deck": "start /B \"\" \"C:\\Program Files\\Elgato\\StreamDeck\\StreamDeck.exe",
    "stop:stream-deck": "taskkill /IM StreamDeck.exe /F || exit 0",
    "link:stream-deck": "streamdeck link .\\packages\\iracing-plugin-stream-deck\\com.iracedeck.sd.core.sdPlugin",
    "unlink:stream-deck": "streamdeck unlink -d com.iracedeck.sd.core",
    "relink:stream-deck": "streamdeck unlink -d com.iracedeck.sd.core 2>NUL & streamdeck link .\\packages\\iracing-plugin-stream-deck\\com.iracedeck.sd.core.sdPlugin",
    "start:mirabox": "node scripts/host-app.mjs start mirabox",
    "stop:mirabox": "node scripts/host-app.mjs stop mirabox",
    "link:mirabox": "node scripts/link-mirabox.mjs",
    "unlink:mirabox": "node scripts/unlink-mirabox.mjs",
    "relink:mirabox": "pnpm unlink:mirabox && pnpm link:mirabox",
    "start:ulanzi": "node scripts/host-app.mjs start ulanzi",
    "stop:ulanzi": "node scripts/host-app.mjs stop ulanzi",
    "link:ulanzi": "node scripts/link-ulanzi.mjs",
    "unlink:ulanzi": "node scripts/unlink-ulanzi.mjs",
    "relink:ulanzi": "pnpm unlink:ulanzi && pnpm link:ulanzi",
    "switch-test-env": "pnpm install && pnpm build && pnpm relink:stream-deck && pnpm relink:mirabox && pnpm relink:ulanzi",
    "switch-test-env:stream-deck": "pnpm install && pnpm build && pnpm relink:stream-deck",
    "switch-test-env:mirabox": "pnpm install && pnpm build && pnpm relink:mirabox",
    "switch-test-env:ulanzi": "pnpm install && pnpm build && pnpm relink:ulanzi",
    "telemetry-snapshot": "pnpm --filter @iracedeck/iracing-sdk telemetry-snapshot -- --include-session --output-dir=local",
    "telemetry-watch": "pnpm --filter @iracedeck/iracing-sdk telemetry-watch --output-dir=local",
    "watch:stream-deck": "pnpm --filter \"@iracedeck/iracing-plugin-stream-deck\" run watch",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "prepare": "husky || exit 0"
  },
  "devDependencies": {
    "@elgato/eslint-config": "0.3.2",
    "@elgato/prettier-config": "0.3.3",
    "@eslint/js": "9.39.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@svgdotjs/svg.js": "3.2.8",
    "@tsconfig/node22": "22.0.6",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "ffmpeg-static": "5.3.0",
    "firebase-tools": "15.28.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "node-gyp": "13.0.2",
    "prettier": "3.9.6",
    "release-it": "21.0.2",
    "semver": "7.8.5",
    "svgdom": "0.1.28",
    "svgpath": "2.6.0",
    "tsx": "4.23.12",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
