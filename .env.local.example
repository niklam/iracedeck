# Copy this file to .env.local (gitignored) and fill in your own values.
# Referenced by scripts that need per-developer configuration.

# Destination directory for the Mirabox plugin dev symlink. On Windows,
# the scripts default to the standard HotSpot StreamDock install path
# (%APPDATA%\HotSpot\StreamDock\plugins) when this is unset. Override only
# if you run a different host app (e.g. VSD Craft).
#
# Used by: pnpm link:mirabox / unlink:mirabox / relink:mirabox / switch-test-env:mirabox
#
# MIRABOX_PLUGINS_DIR=C:\Users\you\AppData\Roaming\HotSpot\StreamDock\plugins

# Destination directory for the Ulanzi plugin dev junction. On Windows the
# scripts default to %APPDATA%\Ulanzi\UlanziDeck\Plugins when this is unset.
#
# Used by: pnpm link:ulanzi / unlink:ulanzi / relink:ulanzi / switch-test-env:ulanzi
#
# ULANZI_PLUGINS_DIR=C:\Users\you\AppData\Roaming\Ulanzi\UlanziDeck\Plugins

# Host executables driven by the start/stop scripts. On Windows these default
# to %ProgramFiles(x86)%\StreamDock\StreamDock.exe and
# %ProgramFiles(x86)%\Ulanzi Studio\UlanziDeck.exe. Set MIRABOX_APP_PATH if you
# run VSD Craft rather than StreamDock — the process that gets stopped is the
# executable's own filename, so one override covers both start and stop.
#
# Used by: pnpm start:mirabox / stop:mirabox / start:ulanzi / stop:ulanzi
#
# MIRABOX_APP_PATH=C:\Program Files (x86)\VSD Craft\VSD Craft.exe
# ULANZI_APP_PATH=C:\Program Files (x86)\Ulanzi Studio\UlanziDeck.exe
