{
  "name": "@iracedeck/iracing-plugin-ulanzi",
  "version": "3.9.0-dev.0",
  "description": "Ulanzi Deck plugin for iRacing - Core driving and interface controls",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "rollup -c && pnpm run postbuild",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postbuild": "node ../../scripts/install-runtime-deps.mjs com.ulanzi.iracedeck.ulanziPlugin/bin",
    "watch": "node ../../scripts/generate-changelog-data.mjs && rollup -c -w",
    "clean": "rimraf com.ulanzi.iracedeck.ulanziPlugin/bin/plugin.js com.ulanzi.iracedeck.ulanziPlugin/bin/plugin.js.map"
  },
  "dependencies": {
    "@iracedeck/deck-adapter-ulanzi": "workspace:*",
    "@iracedeck/plugin-runtime": "workspace:*"
  },
  "devDependencies": {
    "@iracedeck/plugin-build": "workspace:*",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.6",
    "rimraf": "6.1.4",
    "rollup": "4.68.0",
    "typescript": "5.9.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
