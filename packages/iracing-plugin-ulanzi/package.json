{
  "name": "@iracedeck/iracing-plugin-ulanzi",
  "version": "2.1.0-dev.0",
  "description": "Ulanzi Deck plugin for iRacing - Core driving and interface controls",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "rollup -c && npm run postbuild",
    "postbuild": "cd com.ulanzi.iracedeck.ulanziPlugin/bin && npm install",
    "watch": "rollup -c -w",
    "clean": "rimraf com.ulanzi.iracedeck.ulanziPlugin/bin/plugin.js com.ulanzi.iracedeck.ulanziPlugin/bin/plugin.js.map",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iracedeck/audio-assets": "workspace:*",
    "@iracedeck/audio-native": "workspace:*",
    "@iracedeck/audio-scenarios": "workspace:*",
    "@iracedeck/audio-service": "workspace:*",
    "@iracedeck/deck-adapter-ulanzi": "workspace:*",
    "@iracedeck/deck-core": "workspace:*",
    "@iracedeck/event-bus": "workspace:*",
    "@iracedeck/iracing-actions": "workspace:*",
    "@iracedeck/iracing-native": "workspace:*",
    "@iracedeck/iracing-sdk": "workspace:*",
    "@iracedeck/logger": "workspace:*",
    "@iracedeck/pi-components": "workspace:*",
    "@iracedeck/sim-events-iracing": "workspace:*",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@tsconfig/node22": "22.0.5",
    "@types/node": "25.9.1",
    "rimraf": "6.1.3",
    "rollup": "4.60.4",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "license": "SEE LICENSE IN LICENSE"
}
