{
  "name": "@iracedeck/callout-script",
  "version": "3.4.0-dev.0",
  "description": "The shared contract of a Race Engineer voice pack: the callout-script grammar (types, Zod schema, parser, reference collector) and the voice-pack.json manifest schema with the pack format's rules.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.2",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
