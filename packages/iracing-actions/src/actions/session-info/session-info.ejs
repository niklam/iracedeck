<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<sdpi-item label="Mode">
			<sdpi-select id="mode-select" setting="mode" default="incidents">
				<option value="incidents">Incident Points</option>
				<option value="time-remaining">Time Remaining</option>
				<option value="laps">Laps</option>
				<option value="position">Position</option>
				<option value="irating">iRating Gain/Loss</option>
				<option value="gaps">Gaps (Ahead/Behind)</option>
				<option value="fuel">Fuel</option>
				<option value="laps-to-empty">Laps to Empty</option>
				<option value="flags">Race Flags</option>
				<option value="track-wetness">Track Wetness</option>
				<option value="wind">Wind</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item label="Font Size">
			<ird-range-input setting="fontSize" min="5" max="36" step="1" default="14" showlabels></ird-range-input>
		</sdpi-item>

		<sdpi-item id="position-type-settings" label="Position Type" class="hidden">
			<sdpi-select setting="positionType" default="class">
				<option value="class">Class</option>
				<option value="overall">Overall</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item id="position-settings" label="Show Total Cars" class="hidden">
			<sdpi-checkbox setting="positionShowTotal"></sdpi-checkbox>
		</sdpi-item>

		<sdpi-item id="fuel-submode-settings" label="Fuel Value" class="hidden">
			<sdpi-select id="fuel-submode-select" setting="fuelSubMode" default="now">
				<option value="now">Current level</option>
				<option value="lastLap">Used last lap</option>
				<option value="avgN">Average per lap</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item id="fuel-settings" label="Fuel Display" class="hidden">
			<sdpi-select setting="fuelFormat" default="amount">
				<option value="amount">Amount (L / gal)</option>
				<option value="percentage">Percentage</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item id="fuel-window-settings" label="Lap Window" class="hidden">
			<ird-range-input setting="fuelLapWindow" min="1" max="20" step="1" default="5" showlabels></ird-range-input>
		</sdpi-item>
		<div id="fuel-window-help" class="ird-supporting-text hidden">
			How many recent valid laps the average covers. Laps with a pit stop or tow are skipped.
		</div>

		<sdpi-item id="flags-settings" label="UI" class="hidden">
			<sdpi-checkbox setting="blankWhenNoFlag" label="Blank when no flag"></sdpi-checkbox>
		</sdpi-item>

		<sdpi-item id="gaps-settings" label="Show" class="hidden">
			<sdpi-checkbox setting="gapShowAhead" label="Gap ahead" default="true"></sdpi-checkbox>
			<sdpi-checkbox setting="gapShowBehind" label="Gap behind" default="true"></sdpi-checkbox>
		</sdpi-item>
		<div id="gaps-help" class="ird-supporting-text hidden">
			Time gap to the car one class position ahead/behind (race sessions only). Green = the gap is moving your way, red = against you.
		</div>

		<sdpi-item id="wind-direction-settings" label="Direction" class="hidden">
			<sdpi-select id="wind-direction-select" setting="windDirectionMode" default="relative">
				<option value="relative">Relative to car</option>
				<option value="absolute">Compass</option>
			</sdpi-select>
		</sdpi-item>
		<div id="wind-direction-help" class="ird-supporting-text hidden">
			The arrow always points the way the wind pushes you.
		</div>
		<div id="wind-relative-help" class="ird-supporting-text hidden">
			Relative to car: up is a tailwind, down is a headwind, sideways is a crosswind. Needs you to be in the car and driving.
		</div>
		<div id="wind-absolute-help" class="ird-supporting-text hidden">
			Compass: north is up, and the label names the direction the wind blows from (a north wind reads "N").
		</div>

		<sdpi-item id="wind-unit-settings" label="Wind Speed" class="hidden">
			<sdpi-select setting="windSpeedUnit" default="kmh">
				<option value="ms">m/s</option>
				<option value="kmh">km/h</option>
				<option value="mph">mph</option>
			</sdpi-select>
		</sdpi-item>

		<script>
			async function initialize() {
				await customElements.whenDefined("sdpi-select");

				const modeSelect = document.getElementById("mode-select");
				const fuelSubModeSelect = document.getElementById("fuel-submode-select");
				const windDirectionSelect = document.getElementById("wind-direction-select");
				if (!modeSelect) return;

				updateVisibility();

				modeSelect.addEventListener("change", updateVisibility);
				modeSelect.addEventListener("input", updateVisibility);
				fuelSubModeSelect?.addEventListener("change", updateVisibility);
				fuelSubModeSelect?.addEventListener("input", updateVisibility);
				windDirectionSelect?.addEventListener("change", updateVisibility);
				windDirectionSelect?.addEventListener("input", updateVisibility);

				let lastMode = modeSelect.value || "incidents";
				let lastFuelSubMode = fuelSubModeSelect?.value || "now";
				let lastWindDirection = windDirectionSelect?.value || "relative";
				window.irdPoll(() => {
					const currentMode = modeSelect.value;
					const currentFuelSubMode = fuelSubModeSelect?.value;
					const currentWindDirection = windDirectionSelect?.value;
					if (
						(currentMode && currentMode !== lastMode) ||
						(currentFuelSubMode && currentFuelSubMode !== lastFuelSubMode) ||
						(currentWindDirection && currentWindDirection !== lastWindDirection)
					) {
						lastMode = currentMode || lastMode;
						lastFuelSubMode = currentFuelSubMode || lastFuelSubMode;
						lastWindDirection = currentWindDirection || lastWindDirection;
						updateVisibility();
					}
				});
			}

			function updateVisibility() {
				const mode = document.getElementById("mode-select")?.value || "incidents";
				const fuelSubMode = document.getElementById("fuel-submode-select")?.value || "now";
				const windDirection = document.getElementById("wind-direction-select")?.value || "relative";
				const positionTypeSettings = document.getElementById("position-type-settings");
				const positionSettings = document.getElementById("position-settings");
				const fuelSubModeSettings = document.getElementById("fuel-submode-settings");
				const fuelSettings = document.getElementById("fuel-settings");
				const fuelWindowSettings = document.getElementById("fuel-window-settings");
				const fuelWindowHelp = document.getElementById("fuel-window-help");
				const flagsSettings = document.getElementById("flags-settings");
				const gapsSettings = document.getElementById("gaps-settings");
				const gapsHelp = document.getElementById("gaps-help");

				if (positionTypeSettings) {
					positionTypeSettings.classList.toggle("hidden", mode !== "position");
				}
				if (positionSettings) {
					positionSettings.classList.toggle("hidden", mode !== "position");
				}
				if (fuelSubModeSettings) {
					fuelSubModeSettings.classList.toggle("hidden", mode !== "fuel");
				}
				if (fuelSettings) {
					// The amount/percentage format only applies to the tank-level display.
					fuelSettings.classList.toggle("hidden", mode !== "fuel" || fuelSubMode !== "now");
				}
				// The lap window drives the average behind both the fuel avgN
				// sub-mode and the laps-to-empty estimate.
				const hideFuelWindow = (mode !== "fuel" || fuelSubMode !== "avgN") && mode !== "laps-to-empty";
				if (fuelWindowSettings) {
					fuelWindowSettings.classList.toggle("hidden", hideFuelWindow);
				}
				if (fuelWindowHelp) {
					fuelWindowHelp.classList.toggle("hidden", hideFuelWindow);
				}
				if (flagsSettings) {
					flagsSettings.classList.toggle("hidden", mode !== "flags");
				}
				if (gapsSettings) {
					gapsSettings.classList.toggle("hidden", mode !== "gaps");
				}
				if (gapsHelp) {
					gapsHelp.classList.toggle("hidden", mode !== "gaps");
				}

				const hideWind = mode !== "wind";
				document.getElementById("wind-direction-settings")?.classList.toggle("hidden", hideWind);
				document.getElementById("wind-direction-help")?.classList.toggle("hidden", hideWind);
				document.getElementById("wind-unit-settings")?.classList.toggle("hidden", hideWind);
				// Only the explanation for the selected direction mode is shown,
				// so the panel stays short.
				document
					.getElementById("wind-relative-help")
					?.classList.toggle("hidden", hideWind || windDirection !== "relative");
				document
					.getElementById("wind-absolute-help")
					?.classList.toggle("hidden", hideWind || windDirection !== "absolute");
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initialize);
			} else {
				initialize();
			}
		</script>

		<style>
			.hidden { display: none !important; }
		</style>

		<%- include('title-overrides') %>

		<%- include('color-overrides', { slots: ['backgroundColor', 'textColor'], defaults: { backgroundColor: '#2a3444', textColor: '#ffffff' } }) %>
		<%- include('border-overrides', { defaults: require('./data/icon-defaults.json')['session-info'] }) %>
		<%- include('graphic-overrides') %>
		<%- include('common-settings') %>

		<%- include('section-header', { title: 'Global Settings' }) %>

		<%- include('global-title-defaults') %>
		<%- include('global-color-defaults') %>
		<%- include('global-border-defaults') %>
		<%- include('global-graphic-defaults') %>
		<%- include('global-flag-flash') %>
		<%- include('global-common-settings') %>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
