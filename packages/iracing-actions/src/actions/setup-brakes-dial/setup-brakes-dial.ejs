<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<% var __comms = require('./data/action-comms.json')['setup-brakes-dial']; %>
		<%# One shared comms map drives every status line below: each ird-binding-status reads its own
		    mode-setting (setting / pressAction / longPressAction / tapAction / longTouchAction) and looks the
		    live value up in this map. The rotation modes and the gesture values (toggle-abs) are all top-level
		    keys, so the single __comms object covers all five selectors. %>

		<sdpi-item label="Setting">
			<sdpi-select setting="setting" default="brake-bias">
				<option value="abs-adjust">ABS Adjust</option>
				<option value="brake-bias">Brake Bias</option>
				<option value="brake-bias-fine">Brake Bias Fine</option>
				<option value="brake-misc">Brake Misc</option>
				<option value="engine-braking">Engine Braking</option>
				<option value="peak-brake-bias">Peak Brake Bias</option>
			</sdpi-select>
		</sdpi-item>
		<ird-binding-status mode-setting="setting" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>
		<div class="ird-supporting-text">
			Turn the dial to adjust the selected brake setting; the touch strip shows
			its live value. Both the increase and decrease key bindings must be set
			below.
		</div>

		<sdpi-item label="Press Action">
			<sdpi-select setting="pressAction" default="toggle-abs">
				<option value="toggle-abs">Toggle ABS</option>
				<option value="none">None</option>
			</sdpi-select>
		</sdpi-item>
		<ird-binding-status mode-setting="pressAction" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

		<sdpi-item label="Long Press">
			<sdpi-select setting="longPressAction" default="none">
				<option value="toggle-abs">Toggle ABS</option>
				<option value="none">None</option>
			</sdpi-select>
		</sdpi-item>
		<ird-binding-status mode-setting="longPressAction" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

		<% if (locals.platform?.features?.dialFeedback !== false) { %>
		<sdpi-item label="Tap Display">
			<sdpi-select setting="tapAction" default="none">
				<option value="none">None</option>
				<option value="toggle-abs">Toggle ABS</option>
			</sdpi-select>
		</sdpi-item>
		<ird-binding-status mode-setting="tapAction" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

		<sdpi-item label="Long Touch">
			<sdpi-select setting="longTouchAction" default="none">
				<option value="none">None</option>
				<option value="toggle-abs">Toggle ABS</option>
			</sdpi-select>
		</sdpi-item>
		<ird-binding-status mode-setting="longTouchAction" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>
		<% } %>

		<%- include('section-header', { title: 'Global Settings' }) %>

		<%- include('global-key-bindings', {
			keyBindings: require('./data/key-bindings.json').setupBrakes
		}) %>

		<%- include('global-common-settings') %>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
