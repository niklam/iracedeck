<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<% var __comms = require('./data/action-comms.json')['fuel-dial']; %>

		<sdpi-item label="Mode">
			<sdpi-select setting="dialMode" default="add-amount">
				<option value="add-amount">Add Amount</option>
				<option value="fill-to">Target Amount</option>
			</sdpi-select>
		</sdpi-item>
		<div class="ird-supporting-text">
			Add Amount dials the fuel to add.
			<br>
			Target Amount dials the total you want in the tank after the stop, kept
			topped up as you burn. In autofuel mode the turn adjusts the autofuel lap
			margin instead.
		</div>

		<sdpi-item label="Amount">
			<sdpi-textfield
				id="step-size"
				setting="stepSize"
				placeholder="1"
				type="number"
				min="0.1"
				max="50"
				step="0.1"
			></sdpi-textfield>
		</sdpi-item>

		<sdpi-item label="Unit">
			<sdpi-select setting="unitMode" default="auto">
				<option value="auto">Auto (from iRacing)</option>
				<option value="liters">Liters</option>
				<option value="gallons">Gallons</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item label="Press Action">
			<sdpi-select setting="pressAction" default="toggle-fueling">
				<option value="toggle-fueling">Toggle Fueling</option>
				<option value="fill-to-max">Toggle Full / No Fuel</option>
				<option value="toggle-autofuel-mode">Toggle Autofuel</option>
				<option value="switch-mode">Switch Mode</option>
				<option value="none">None</option>
			</sdpi-select>
		</sdpi-item>
		<ird-binding-status mode-setting="pressAction" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

		<sdpi-item label="Long Press">
			<sdpi-select setting="longPressAction" default="toggle-autofuel-mode">
				<option value="toggle-fueling">Toggle Fueling</option>
				<option value="fill-to-max">Toggle Full / No Fuel</option>
				<option value="toggle-autofuel-mode">Toggle Autofuel</option>
				<option value="switch-mode">Switch Mode</option>
				<option value="none">None</option>
			</sdpi-select>
		</sdpi-item>
		<ird-binding-status mode-setting="longPressAction" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

		<sdpi-item label="Push + Turn">
			<sdpi-select setting="pushTurnAction" default="none">
				<option value="none">None</option>
				<option value="full-empty">Full / No Fuel</option>
			</sdpi-select>
		</sdpi-item>
		<div class="ird-supporting-text">
			Press and turn the dial: clockwise fills to full, counter-clockwise empties
			(no fuel).
		</div>

		<% if (locals.platform?.features?.dialFeedback !== false) { %>
		<sdpi-item label="Tap Display">
			<sdpi-select setting="tapAction" default="none">
				<option value="none">None</option>
				<option value="toggle-fueling">Toggle Fueling</option>
				<option value="fill-to-max">Toggle Full / No Fuel</option>
				<option value="toggle-autofuel-mode">Toggle Autofuel</option>
				<option value="switch-mode">Switch Mode</option>
			</sdpi-select>
		</sdpi-item>
		<ird-binding-status mode-setting="tapAction" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

		<sdpi-item label="Long Touch">
			<sdpi-select setting="longTouchAction" default="none">
				<option value="none">None</option>
				<option value="toggle-fueling">Toggle Fueling</option>
				<option value="fill-to-max">Toggle Full / No Fuel</option>
				<option value="toggle-autofuel-mode">Toggle Autofuel</option>
				<option value="switch-mode">Switch Mode</option>
			</sdpi-select>
		</sdpi-item>
		<ird-binding-status mode-setting="longTouchAction" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>
		<% } %>

		<%- include('section-header', { title: 'Global Settings' }) %>

		<%- include('global-key-bindings', {
			keyBindings: require('./data/key-bindings.json').fuelService
		}) %>

		<%- include('global-common-settings') %>

		<script>
			async function initialize() {
				await customElements.whenDefined("sdpi-textfield");

				const stepInput = document.getElementById("step-size");

				if (stepInput) {
					stepInput.addEventListener("input", (e) => {
						e.target.value = e.target.value.replace(",", ".");
					});
				}
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initialize);
			} else {
				initialize();
			}
		</script>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
