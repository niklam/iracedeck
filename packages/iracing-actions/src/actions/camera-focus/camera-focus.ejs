<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
		<style>
			.camera-groups-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 4px 16px;
				padding: 4px 14px;
			}

			.camera-groups-grid label {
				display: flex;
				align-items: center;
				gap: 6px;
				font-family: "Segoe UI", Arial, sans-serif;
				font-size: 9pt;
				color: #d0d0d0;
				cursor: pointer;
				padding: 2px 0;
			}

			.camera-groups-grid input[type="checkbox"] {
				accent-color: #007bff;
				cursor: pointer;
			}

			.camera-groups-grid .group-heading {
				grid-column: 1 / -1;
				font-family: "Segoe UI", Arial, sans-serif;
				font-size: 8pt;
				color: #888;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				padding: 6px 0 2px 0;
				border-bottom: 1px solid #444;
				margin-bottom: 2px;
			}

			.camera-groups-grid .group-heading:first-child {
				padding-top: 0;
			}

			.camera-groups-buttons {
				display: flex;
				gap: 6px;
				padding: 6px 14px 2px 14px;
				flex-wrap: wrap;
			}

			.camera-groups-buttons button {
				background: #3a3a3a;
				border: 1px solid #555;
				color: #d0d0d0;
				padding: 3px 10px;
				font-size: 8pt;
				border-radius: 3px;
				cursor: pointer;
				font-family: "Segoe UI", Arial, sans-serif;
			}

			.camera-groups-buttons button:hover {
				background: #505050;
				color: #ffffff;
			}
		</style>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<%# The car-selector focus mode rides on Stream Deck profiles, so it is gated to Elgato (see platform-feature-flags.md). %>
		<% var showFocusSelectCar = locals.platform?.features?.profiles !== false; %>
		<%# Dial comms map (#803): the dial surface is entirely SDK-driven, so every mode is `api`. %>
		<% var __dialComms = require('./data/action-comms.json')['camera-focus-dial']; %>

		<!-- Keypad settings — hidden when this instance is a dial (#803). -->
		<div id="keypad-settings">
		<sdpi-item label="Mode">
			<sdpi-select id="target-select" setting="target" default="change-camera">
				<option value="change-camera">Change Camera</option>
				<option value="cycle-camera">Cycle Camera</option>
				<option value="cycle-sub-camera">Cycle Sub-Camera</option>
				<option value="cycle-car">Cycle Car</option>
				<option value="cycle-driving">Cycle Driving Camera</option>
				<option value="focus-your-car">Focus Your Car</option>
				<option value="focus-on-leader">Focus on Leader</option>
				<option value="focus-on-incident">Focus on Incident</option>
				<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				<% if (showFocusSelectCar) { %>
				<option value="focus-select-car">Focus Car (pick from grid)</option>
				<% } %>
				<option value="switch-by-position">Switch by Position</option>
				<option value="switch-by-car-number">Switch by Car Number</option>
				<option value="set-camera-state">Set Camera State</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item label="Direction" id="direction-item" class="hidden">
			<sdpi-select setting="direction" default="next">
				<option value="next">Next</option>
				<option value="previous">Previous</option>
			</sdpi-select>
		</sdpi-item>

		<div id="camera-groups-section" class="hidden">
			<div class="ird-section-heading">Camera Groups</div>
			<div id="camera-groups-grid" class="camera-groups-grid"></div>
			<div class="camera-groups-buttons">
				<button id="btn-select-all" type="button">Select All</button>
				<button id="btn-clear" type="button">Clear Selection</button>
			</div>
		</div>

		<sdpi-item label="Position" id="position-item" class="hidden">
			<sdpi-textfield setting="position" placeholder="1" type="number"></sdpi-textfield>
		</sdpi-item>

		<sdpi-item label="Car Number" id="car-number-item" class="hidden">
			<sdpi-textfield setting="carNumber" placeholder="0" type="number"></sdpi-textfield>
		</sdpi-item>

		<sdpi-item label="Camera State" id="camera-state-item" class="hidden">
			<sdpi-textfield setting="cameraState" placeholder="0" type="number"></sdpi-textfield>
		</sdpi-item>

		<% if (showFocusSelectCar) { %>
		<div id="focus-select-car-section" class="hidden">
			<sdpi-item label="Selector Profile">
				<ird-profile-select setting="focusSelectorProfile" profiles="_deviceProfiles" placeholder="Default (iRaceDeck Car Selector)"></ird-profile-select>
			</sdpi-item>
			<div class="ird-supporting-text">
				Opens the Car Selector profile with one key per car in the session. Press a car to focus the camera on it — the selector stays up so you can hop car to car; its Back key returns here.
			</div>
		</div>
		<% } %>

		<sdpi-item label="Camera Group" id="camera-group-item" class="hidden">
			<sdpi-select setting="cameraGroup" default="9">
				<optgroup label="Car">
					<option value="1">Nose</option>
					<option value="2">Gearbox</option>
					<option value="9">Cockpit</option>
					<option value="3">Roll Bar</option>
					<option value="6">Gyro</option>
					<option value="4">Suspension - Left Front</option>
					<option value="7">Suspension - Right Front</option>
					<option value="5">Suspension - Left Rear</option>
					<option value="8">Suspension - Right Rear</option>
				</optgroup>
				<optgroup label="Chase">
					<option value="12">Chase</option>
					<option value="13">Far Chase</option>
					<option value="14">Rear Chase</option>
				</optgroup>
				<optgroup label="Track">
					<option value="17">TV1</option>
					<option value="18">TV2</option>
					<option value="19">TV3</option>
					<option value="20">Scenic</option>
					<option value="15">Pit Lane</option>
					<option value="16">Pit Lane 2</option>
				</optgroup>
				<optgroup label="Aerial">
					<option value="11">Chopper</option>
					<option value="10">Blimp</option>
				</optgroup>
			</sdpi-select>
		</sdpi-item>
		</div>
		<%# end #keypad-settings %>

		<!-- Dial settings — shown only when this instance is a dial (#803). -->
		<div id="dial-settings" class="hidden">
			<sdpi-item label="Mode">
				<sdpi-select id="dial-mode-select" setting="dial.mode" default="car-number">
					<option value="camera">Cycle Camera</option>
					<option value="sub-camera">Cycle Sub-Camera</option>
					<option value="car-number">Cycle by Car #</option>
					<option value="race-position">Cycle by Race Position</option>
					<option value="track-order">Cycle by Track Order</option>
					<option value="driving">Cycle Driving Camera</option>
				</sdpi-select>
			</sdpi-item>
			<% if (locals.platform?.features?.dialFeedback !== false) { %>
			<div class="ird-supporting-text">
				Turn the dial to cycle the selected target — clockwise for next, counter-clockwise for previous. In Race Position mode clockwise selects the car ahead (lower position number); in Track Order mode it selects the car physically ahead on track, regardless of standings. Where previewable, the touch strip shows the current camera, sub-camera, or focused car in the centre with the target for each turn direction at its side; Cycle Driving Camera shows only the current group.
			</div>
			<% } else { %>
			<div class="ird-supporting-text">
				Turn the knob to cycle the selected target — clockwise for next, counter-clockwise for previous. In Race Position mode clockwise selects the car ahead (lower position number); in Track Order mode it selects the car physically ahead on track, regardless of standings.
			</div>
			<% } %>

			<sdpi-item label="Rotation">
				<sdpi-checkbox setting="dial.reverseRotation" label="Reverse rotation"></sdpi-checkbox>
			</sdpi-item>
			<div class="ird-supporting-text">
				Flips the turn direction of the selected mode.
			</div>

			<%# Camera-group subset for the dial's Cycle Camera mode — bound to the plugin-global cameraGroupSubset (#803). Keypad Cycle Camera buttons keep their pre-existing per-button subset and fall back to this global set only until they save one. %>
			<div id="dial-camera-groups-section" class="hidden">
				<div class="ird-section-heading">Camera Groups</div>
				<div id="dial-camera-groups-grid" class="camera-groups-grid"></div>
				<div class="camera-groups-buttons">
					<button id="dial-btn-select-all" type="button">Select All</button>
					<button id="dial-btn-clear" type="button">Clear Selection</button>
				</div>
				<div class="ird-supporting-text">
					This is the plugin-global camera set every dial rotates through. Keypad Cycle Camera buttons follow it too until a button saves its own per-button selection, which then takes precedence for that button.
				</div>
			</div>

			<sdpi-item label="Press Action">
				<sdpi-select setting="dial.pressAction" default="none">
					<option value="none">None</option>
					<option value="focus-my-car">Focus My Car</option>
					<option value="change-camera">Change Camera</option>
					<option value="focus-on-leader">Focus on Leader</option>
					<option value="focus-on-incident">Focus on Incident</option>
					<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				</sdpi-select>
			</sdpi-item>

			<sdpi-item label="Long Press">
				<sdpi-select setting="dial.longPressAction" default="none">
					<option value="none">None</option>
					<option value="focus-my-car">Focus My Car</option>
					<option value="change-camera">Change Camera</option>
					<option value="focus-on-leader">Focus on Leader</option>
					<option value="focus-on-incident">Focus on Incident</option>
					<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				</sdpi-select>
			</sdpi-item>

			<% if (locals.platform?.features?.dialFeedback !== false) { %>
			<sdpi-item label="Tap Display">
				<sdpi-select setting="dial.tapAction" default="none">
					<option value="none">None</option>
					<option value="focus-my-car">Focus My Car</option>
					<option value="change-camera">Change Camera</option>
					<option value="focus-on-leader">Focus on Leader</option>
					<option value="focus-on-incident">Focus on Incident</option>
					<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				</sdpi-select>
			</sdpi-item>

			<sdpi-item label="Long Touch">
				<sdpi-select setting="dial.longTouchAction" default="none">
					<option value="none">None</option>
					<option value="focus-my-car">Focus My Car</option>
					<option value="change-camera">Change Camera</option>
					<option value="focus-on-leader">Focus on Leader</option>
					<option value="focus-on-incident">Focus on Incident</option>
					<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				</sdpi-select>
			</sdpi-item>

			<%- include('dial-appearance') %>
			<% } %>
		</div>

		<!-- Key-icon appearance — keypad only (a dial has no key icon). -->
		<div id="keypad-appearance">
		<%- include('title-overrides') %>

		<%- include('color-overrides', { slots: ['backgroundColor', 'textColor', 'graphic1Color'], defaults: require('./data/icon-defaults.json')['camera-focus'] }) %>
		<%- include('border-overrides', { defaults: require('./data/icon-defaults.json')['camera-focus'] }) %>
		<%- include('graphic-overrides') %>
		<%- include('common-settings') %>
		</div>

		<%- include('section-header', { title: 'Global Settings' }) %>

		<div id="keypad-global-appearance">
		<%- include('global-title-defaults') %>
		<%- include('global-color-defaults') %>
		<%- include('global-border-defaults') %>
		<%- include('global-graphic-defaults') %>
		<%- include('global-flag-flash') %>
		</div>

		<%- include('global-common-settings') %>

		<script>
			(function () {
				// Camera group subset constants — duplicated from camera-controls.ts
				// (DEFAULT_CAMERA_GROUPS and DEFAULT_ENABLED_GROUPS). PI runs in a
				// separate browser context and cannot import action code.
				var ALL_GROUPS = [
					// Car cameras (0-8)
					"Nose", "Gearbox", "Cockpit", "Roll Bar",
					"LF Susp", "RF Susp", "LR Susp", "RR Susp", "Gyro",
					// Chase cameras (9-11)
					"Chase", "Far Chase", "Rear Chase",
					// Track cameras (12-17)
					"TV1", "TV2", "TV3", "Scenic", "Pit Lane", "Pit Lane 2",
					// Aerial cameras (18-19)
					"Chopper", "Blimp"
				];
				var DISPLAY_NAMES = {
					"LF Susp": "Suspension LF",
					"RF Susp": "Suspension RF",
					"LR Susp": "Suspension LR",
					"RR Susp": "Suspension RR"
				};
				var DEFAULT_ENABLED = ["Nose", "Cockpit", "Chase", "TV1", "TV2", "TV3"];
				var SETTING_KEY = "cameraGroupSubset";
				var CYCLE_TARGETS = ["cycle-camera", "cycle-sub-camera", "cycle-car", "cycle-driving"];

				var GROUP_SECTIONS = [
					{ heading: "Car", start: 0, end: 9 },
					{ heading: "Chase", start: 9, end: 12 },
					{ heading: "Track", start: 12, end: 18 },
					{ heading: "Aerial", start: 18, end: 20 }
				];

				var initialized = false;

				function isCycleTarget(target) {
					return CYCLE_TARGETS.indexOf(target) !== -1;
				}

				function isGroupEnabled(state, name) {
					if (name in state) {
						return state[name] === true;
					}
					return DEFAULT_ENABLED.indexOf(name) !== -1;
				}

				// Ensure the state has entries for ALL visible groups so saving
				// doesn't lose groups that weren't explicitly toggled.
				function ensureAllGroupsTracked(state) {
					for (var i = 0; i < ALL_GROUPS.length; i++) {
						if (!(ALL_GROUPS[i] in state)) {
							state[ALL_GROUPS[i]] = DEFAULT_ENABLED.indexOf(ALL_GROUPS[i]) !== -1;
						}
					}
				}

				// Shared grid renderer — the SAME markup for the keypad Cycle Camera
				// selector and the dial Cycle Camera selector (#803).
				function renderGroupCheckboxes(gridId, state, onToggle) {
					var grid = document.getElementById(gridId);
					if (!grid) return;

					grid.innerHTML = "";

					for (var s = 0; s < GROUP_SECTIONS.length; s++) {
						var section = GROUP_SECTIONS[s];
						var heading = document.createElement("div");
						heading.className = "group-heading";
						heading.textContent = section.heading;
						grid.appendChild(heading);

						for (var i = section.start; i < section.end && i < ALL_GROUPS.length; i++) {
							var name = ALL_GROUPS[i];
							var label = document.createElement("label");
							var checkbox = document.createElement("input");
							checkbox.type = "checkbox";
							checkbox.checked = isGroupEnabled(state, name);
							checkbox.dataset.group = name;
							checkbox.addEventListener("change", function (ev) {
								onToggle(ev.target.dataset.group, ev.target.checked);
							});
							label.appendChild(checkbox);
							label.appendChild(document.createTextNode(DISPLAY_NAMES[name] || name));
							grid.appendChild(label);
						}
					}
				}

				// A camera-group selector bound to a settings hook. The keypad uses a
				// per-action hook (with a legacy global fallback); the dial uses the
				// GLOBAL cameraGroupSubset directly — the same set the dial rotation
				// honors via getEnabledGroupNames(undefined) (#803).
				function createGroupSelector(gridId, selectAllId, clearId) {
					var state = {};
					var save = null;

					function persist() {
						if (save) save(JSON.stringify({ groups: state }));
					}
					function render() {
						renderGroupCheckboxes(gridId, state, function (name, checked) {
							ensureAllGroupsTracked(state);
							state[name] = checked;
							persist();
						});
					}
					function setAll(value) {
						ensureAllGroupsTracked(state);
						for (var i = 0; i < ALL_GROUPS.length; i++) {
							state[ALL_GROUPS[i]] = value;
						}
						render();
						persist();
					}

					return {
						setState: function (groups) { state = groups || {}; render(); },
						setSave: function (fn) { save = fn; },
						render: render,
						wireButtons: function () {
							var a = document.getElementById(selectAllId);
							if (a) a.addEventListener("click", function () { setAll(true); });
							var c = document.getElementById(clearId);
							if (c) c.addEventListener("click", function () { setAll(false); });
						}
					};
				}

				var keypadSelector = createGroupSelector("camera-groups-grid", "btn-select-all", "btn-clear");
				var dialSelector = createGroupSelector("dial-camera-groups-grid", "dial-btn-select-all", "dial-btn-clear");

				// Conditional visibility
				function updateVisibility(target) {
					var directionItem = document.getElementById("direction-item");
					var cameraGroupsSection = document.getElementById("camera-groups-section");
					var positionItem = document.getElementById("position-item");
					var carNumberItem = document.getElementById("car-number-item");
					var cameraStateItem = document.getElementById("camera-state-item");

					var isCycle = isCycleTarget(target);

					if (directionItem) {
						directionItem.classList.toggle("hidden", !isCycle);
					}
					if (cameraGroupsSection) {
						cameraGroupsSection.classList.toggle("hidden", target !== "cycle-camera");
					}
					if (positionItem) {
						positionItem.classList.toggle("hidden", target !== "switch-by-position");
					}
					if (carNumberItem) {
						carNumberItem.classList.toggle("hidden", target !== "switch-by-car-number");
					}
					if (cameraStateItem) {
						cameraStateItem.classList.toggle("hidden", target !== "set-camera-state");
					}
					var focusSelectCarSection = document.getElementById("focus-select-car-section");
					if (focusSelectCarSection) {
						focusSelectCarSection.classList.toggle("hidden", target !== "focus-select-car");
					}
					var cameraGroupItem = document.getElementById("camera-group-item");
					if (cameraGroupItem) {
						cameraGroupItem.classList.toggle("hidden", target !== "change-camera");
					}
				}

				// Which surface this instance sits on: the PI registration's
				// actionInfo.payload.controller ("Keypad" | "Encoder"; the Mirabox host
				// may report "Knob"). Anything unknown or unavailable falls back to the
				// keypad view (#803).
				async function resolveController() {
					try {
						var client = window.SDPIComponents && window.SDPIComponents.streamDeckClient;
						var info = client && (await client.getConnectionInfo());
						var controller = info && info.actionInfo && info.actionInfo.payload && info.actionInfo.payload.controller;
						return controller === "Encoder" || controller === "Knob" ? "Encoder" : "Keypad";
					} catch (err) {
						return "Keypad";
					}
				}

				function applyDialView() {
					document.getElementById("keypad-settings") && document.getElementById("keypad-settings").classList.add("hidden");
					document.getElementById("keypad-appearance") && document.getElementById("keypad-appearance").classList.add("hidden");
					document.getElementById("keypad-global-appearance") && document.getElementById("keypad-global-appearance").classList.add("hidden");
					document.getElementById("dial-settings") && document.getElementById("dial-settings").classList.remove("hidden");
				}

				// Dial Mode visibility — the shared camera-groups selector shows only
				// for the dial's Cycle Camera mode (#803).
				function updateDialVisibility(mode) {
					var section = document.getElementById("dial-camera-groups-section");
					if (section) section.classList.toggle("hidden", mode !== "camera");
				}

				async function initializePI() {
					if (initialized) return;
					initialized = true;

					await customElements.whenDefined("sdpi-select");

					if (window.SDPIComponents) {
						// Keypad selector: per-action setting with a legacy global fallback.
						var legacyGroups = null;
						window.SDPIComponents.useGlobalSettings(SETTING_KEY, function (value) {
							if (value) {
								try {
									var parsed = JSON.parse(value);
									if (parsed && parsed.groups) legacyGroups = parsed.groups;
								} catch (e) {
									// ignore
								}
							}
						});

						var keypadHook = window.SDPIComponents.useSettings(SETTING_KEY, function (value) {
							var groups = {};
							if (value) {
								try {
									var parsed = JSON.parse(value);
									if (parsed && parsed.groups) groups = parsed.groups;
								} catch (e) {
									groups = {};
								}
							} else if (legacyGroups) {
								// No per-action value yet — seed from legacy global setting
								groups = legacyGroups;
							}
							keypadSelector.setState(groups);
						});
						keypadSelector.setSave(keypadHook[1]);

						// Dial selector: the GLOBAL cameraGroupSubset (read + save).
						var dialHook = window.SDPIComponents.useGlobalSettings(SETTING_KEY, function (value) {
							var groups = {};
							if (value) {
								try {
									var parsed = JSON.parse(value);
									if (parsed && parsed.groups) groups = parsed.groups;
								} catch (e) {
									groups = {};
								}
							}
							dialSelector.setState(groups);
						});
						dialSelector.setSave(dialHook[1]);
					}

					keypadSelector.wireButtons();
					dialSelector.wireButtons();

					// Keypad target visibility
					var targetSelect = document.getElementById("target-select");
					if (targetSelect) {
						var initialValue = targetSelect.value || "change-camera";
						updateVisibility(initialValue);

						targetSelect.addEventListener("change", function (ev) {
							updateVisibility(ev.target.value || "change-camera");
						});
						targetSelect.addEventListener("input", function (ev) {
							updateVisibility(ev.target.value || "change-camera");
						});

						var lastTarget = targetSelect.value || "change-camera";
						window.irdPoll(function () {
							var currentTarget = targetSelect.value;
							if (currentTarget && currentTarget !== lastTarget) {
								lastTarget = currentTarget;
								updateVisibility(currentTarget);
							}
						});
					}

					// Dial mode visibility
					var dialModeSelect = document.getElementById("dial-mode-select");
					if (dialModeSelect) {
						updateDialVisibility(dialModeSelect.value || "car-number");

						dialModeSelect.addEventListener("change", function (ev) {
							updateDialVisibility(ev.target.value || "car-number");
						});
						dialModeSelect.addEventListener("input", function (ev) {
							updateDialVisibility(ev.target.value || "car-number");
						});

						var lastMode = dialModeSelect.value || "car-number";
						window.irdPoll(function () {
							var currentMode = dialModeSelect.value;
							if (currentMode && currentMode !== lastMode) {
								lastMode = currentMode;
								updateDialVisibility(currentMode);
							}
						});
					}

					keypadSelector.render();
					dialSelector.render();

					// Switch to the dial view last, so a slow/failed controller lookup
					// still leaves a fully functional keypad PI (the default view).
					if ((await resolveController()) === "Encoder") {
						applyDialView();
					}
				}

				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", initializePI);
				} else {
					initializePI();
				}
			})();
		</script>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
