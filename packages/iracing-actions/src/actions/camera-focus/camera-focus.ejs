<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
		<style>
			.camera-groups-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 4px 16px;
				padding: 4px 14px;
			}

			.camera-groups-grid label {
				display: flex;
				align-items: center;
				gap: 6px;
				font-family: "Segoe UI", Arial, sans-serif;
				font-size: 9pt;
				color: #d0d0d0;
				cursor: pointer;
				padding: 2px 0;
			}

			/* A remembered custom group (#1653) whose name may be long: wrap it rather than widen the grid. */
			.camera-groups-grid label {
				overflow-wrap: anywhere;
				min-width: 0;
			}

			/* A remembered group the current track's camera file does not have (#1653). */
			.camera-groups-grid label.dimmed {
				color: #808080;
			}

			.camera-groups-grid input[type="checkbox"] {
				accent-color: #007bff;
				cursor: pointer;
			}

			.camera-groups-grid .group-heading {
				grid-column: 1 / -1;
				font-family: "Segoe UI", Arial, sans-serif;
				font-size: 8pt;
				color: #888;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				padding: 6px 0 2px 0;
				border-bottom: 1px solid #444;
				margin-bottom: 2px;
			}

			.camera-groups-grid .group-heading:first-child {
				padding-top: 0;
			}

			.camera-groups-buttons {
				display: flex;
				gap: 6px;
				padding: 6px 14px 2px 14px;
				flex-wrap: wrap;
			}

			.camera-groups-buttons button {
				background: #3a3a3a;
				border: 1px solid #555;
				color: #d0d0d0;
				padding: 3px 10px;
				font-size: 8pt;
				border-radius: 3px;
				cursor: pointer;
				font-family: "Segoe UI", Arial, sans-serif;
			}

			.camera-groups-buttons button:hover {
				background: #505050;
				color: #ffffff;
			}
		</style>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<%# The car-selector focus mode rides on Stream Deck profiles, so it is gated to Elgato (see platform-feature-flags.md). %>
		<% var showFocusSelectCar = locals.platform?.features?.profiles !== false; %>
		<%# Comms maps (#612): every camera mode is an SDK command except Cycle Sub-Camera, %>
		<%# which taps iRacing's own Next / Previous Sub Camera bindings (#852), and Cycle %>
		<%# by Track Order, which taps its Next / Previous Car bindings (#1277). %>
		<% var __comms = require('./data/action-comms.json')['camera-focus']; %>
		<% var __dialComms = require('./data/action-comms.json')['camera-focus-dial']; %>

		<!-- Keypad settings — hidden when this instance is a dial (#803). -->
		<div id="keypad-settings">
		<sdpi-item label="Mode">
			<sdpi-select id="target-select" setting="target" default="change-camera">
				<option value="change-camera">Change Camera</option>
				<option value="cycle-camera">Cycle Camera</option>
				<option value="cycle-sub-camera">Cycle Sub-Camera</option>
				<option value="cycle-car">Cycle Car</option>
				<option value="cycle-track-order">Cycle by Track Order</option>
				<option value="cycle-driving">Cycle Driving Camera</option>
				<option value="focus-your-car">Focus Your Car</option>
				<option value="focus-on-leader">Focus on Leader</option>
				<option value="focus-on-incident">Focus on Incident</option>
				<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				<% if (showFocusSelectCar) { %>
				<option value="focus-select-car">Focus Car (pick from grid)</option>
				<% } %>
				<option value="switch-by-position">Switch by Position</option>
				<option value="switch-by-car-number">Switch by Car Number</option>
				<option value="set-camera-state">Set Camera State</option>
			</sdpi-select>
		</sdpi-item>

		<ird-binding-status mode-setting="<%= __comms._meta.modeSetting %>" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

		<%# The two option LABELS are swapped per mode by updateVisibility (the
		    force-feedback.ejs pattern); the stored values stay next/previous, so
		    Cycle by Track Order reads Ahead / Behind without a second setting. %>
		<sdpi-item label="Direction" id="direction-item" class="hidden">
			<sdpi-select setting="direction" default="next">
				<option id="direction-next-label" value="next">Next</option>
				<option id="direction-previous-label" value="previous">Previous</option>
			</sdpi-select>
		</sdpi-item>

		<div id="camera-groups-section" class="hidden">
			<%# #959 — per key: the group the next press selects, or the group the sim is on now. Keypad only; the dial strip already centres the current group. %>
			<sdpi-item label="Icon Shows">
				<sdpi-select setting="cycleIconMode" default="next">
					<option value="next">Next camera</option>
					<option value="current">Current camera</option>
				</sdpi-select>
			</sdpi-item>
			<div class="ird-section-heading">Camera Groups</div>
			<div id="camera-groups-grid" class="camera-groups-grid"></div>
			<div class="camera-groups-buttons">
				<button id="btn-select-all" type="button">Select All</button>
				<button id="btn-clear" type="button">Clear Selection</button>
			</div>
		</div>

		<sdpi-item label="Position" id="position-item" class="hidden">
			<sdpi-textfield setting="position" placeholder="1" type="number"></sdpi-textfield>
		</sdpi-item>

		<%# Digits as typed: 07 and 7 are different cars (#1353). sdpi-textfield is always a %>
		<%# text input, so irdDigitsOnly (below) is what keeps it to digits. Four characters %>
		<%# hold any car number (three digits) and a raw number set by hand. %>
		<sdpi-item label="Car Number" id="car-number-item" class="hidden">
			<sdpi-textfield id="car-number-field" setting="carNumber" placeholder="e.g. 07" maxlength="4"></sdpi-textfield>
		</sdpi-item>

		<sdpi-item label="Camera State" id="camera-state-item" class="hidden">
			<sdpi-textfield setting="cameraState" placeholder="0" type="number"></sdpi-textfield>
		</sdpi-item>

		<% if (showFocusSelectCar) { %>
		<div id="focus-select-car-section" class="hidden">
			<sdpi-item label="Selector Profile">
				<ird-profile-select setting="focusSelectorProfile" profiles="_deviceProfiles" placeholder="Default (iRaceDeck Car Selector)"></ird-profile-select>
			</sdpi-item>
			<div class="ird-supporting-text">
				Opens the Car Selector profile with one key per car in the session. Press a car to focus the camera on it — the selector stays up so you can hop car to car; its Back key returns here.
			</div>
		</div>
		<% } %>

		<%# Change Camera's group (#1653): any group the loaded camera file defines or an
		    earlier session showed, or a typed name. The picker writes cameraGroupName, plus
		    the plugin's own cameraGroup number (CHANGE_CAMERA_GROUPS) for the 25 standard
		    groups, so an older build still presses a standard choice; a key that stores only
		    the number shows the group it names. default is CameraGroupField's: Cockpit. %>
		<sdpi-item label="Camera Group" id="camera-group-item" class="hidden">
			<ird-camera-group-select setting="cameraGroupName" number-setting="cameraGroup" catalog="_cameraCatalog" default="9"></ird-camera-group-select>
		</sdpi-item>
		<div class="ird-supporting-text hidden" id="camera-group-note">
			On this track lists the groups of the camera file iRacing has loaded. The others are remembered from earlier sessions; on a track without the chosen group, the key does nothing. Choose Other… to type a group name.
		</div>
		</div>
		<%# end #keypad-settings %>

		<!-- Dial settings — shown only when this instance is a dial (#803). -->
		<div id="dial-settings" class="hidden">
			<sdpi-item label="Mode">
				<sdpi-select id="dial-mode-select" setting="dial.mode" default="car-number">
					<option value="camera">Cycle Camera</option>
					<option value="sub-camera">Cycle Sub-Camera</option>
					<option value="car-number">Cycle by Car #</option>
					<option value="race-position">Cycle by Race Position</option>
					<option value="track-order">Cycle by Track Order</option>
					<option value="driving">Cycle Driving Camera</option>
				</sdpi-select>
			</sdpi-item>

			<%# Restored in #852: the line was dropped in #803 as redundant when every %>
			<%# dial mode was `api`. Sub-Camera and Track Order are binding-driven now, so it says something. %>
			<ird-binding-status mode-setting="<%= __dialComms._meta.modeSetting %>" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>

			<sdpi-item label="Rotation">
				<sdpi-checkbox setting="dial.reverseRotation" label="Reverse rotation"></sdpi-checkbox>
			</sdpi-item>
			<div class="ird-supporting-text">
				Flips the turn direction of the selected mode.
			</div>

			<%# Camera-group subset for the dial's Cycle Camera mode — bound to the plugin-global cameraGroupSubset (#803). Keypad Cycle Camera buttons keep their pre-existing per-button subset and fall back to this global set only until they save one. %>
			<div id="dial-camera-groups-section" class="hidden">
				<div class="ird-section-heading">Camera Groups</div>
				<div id="dial-camera-groups-grid" class="camera-groups-grid"></div>
				<div class="camera-groups-buttons">
					<button id="dial-btn-select-all" type="button">Select All</button>
					<button id="dial-btn-clear" type="button">Clear Selection</button>
				</div>
				<div class="ird-supporting-text">
					This is the plugin-global camera set every dial rotates through. Keypad Cycle Camera buttons follow it too until a button saves its own per-button selection, which then takes precedence for that button.
				</div>
			</div>

			<sdpi-item label="Press Action">
				<sdpi-select setting="dial.pressAction" default="none">
					<option value="none">None</option>
					<option value="focus-my-car">Focus My Car</option>
					<option value="change-camera">Change Camera</option>
					<option value="focus-on-leader">Focus on Leader</option>
					<option value="focus-on-incident">Focus on Incident</option>
					<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				</sdpi-select>
			</sdpi-item>

			<% if (locals.platform?.features?.dialExtendedGestures !== false) { %>
			<sdpi-item label="Long Press">
				<sdpi-select setting="dial.longPressAction" default="none">
					<option value="none">None</option>
					<option value="focus-my-car">Focus My Car</option>
					<option value="change-camera">Change Camera</option>
					<option value="focus-on-leader">Focus on Leader</option>
					<option value="focus-on-incident">Focus on Incident</option>
					<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				</sdpi-select>
			</sdpi-item>

			<sdpi-item label="Tap Display">
				<sdpi-select setting="dial.tapAction" default="none">
					<option value="none">None</option>
					<option value="focus-my-car">Focus My Car</option>
					<option value="change-camera">Change Camera</option>
					<option value="focus-on-leader">Focus on Leader</option>
					<option value="focus-on-incident">Focus on Incident</option>
					<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				</sdpi-select>
			</sdpi-item>

			<sdpi-item label="Long Touch">
				<sdpi-select setting="dial.longTouchAction" default="none">
					<option value="none">None</option>
					<option value="focus-my-car">Focus My Car</option>
					<option value="change-camera">Change Camera</option>
					<option value="focus-on-leader">Focus on Leader</option>
					<option value="focus-on-incident">Focus on Incident</option>
					<option value="focus-on-most-exciting">Focus on Most Exciting</option>
				</sdpi-select>
			</sdpi-item>
			<% } %>

			<%- include('dial-appearance') %>
		</div>

		<%- include('action-settings-footer') %>

		<!-- Key-icon appearance — keypad only (a dial has no key icon). -->
		<div id="keypad-appearance">
		<%- include('title-overrides') %>

		<%- include('color-overrides', { slots: ['backgroundColor', 'textColor', 'graphic1Color'], defaults: require('./data/icon-defaults.json')['camera-focus'] }) %>
		<%- include('border-overrides', { defaults: require('./data/icon-defaults.json')['camera-focus'] }) %>
		<%- include('graphic-overrides') %>
		</div>
		<%- include('common-settings') %>

		<%# Two camera modes are keyboard-driven. Cycle Sub-Camera (#852): the switch %>
		<%# broadcasts cannot step a sub-camera, so iRacing's own bindings drive it %>
		<%# (B / Shift+B). Cycle by Track Order (#1277): iRacing's Next / Previous Car %>
		<%# (V / Shift+V) picks the car — the same global settings Replay Control's car %>
		<%# modes use, listed under both sections of key-bindings.json. %>
		<%- include('key-bindings-section', {
			keyBindings: require('./data/key-bindings.json').cameraControls
		}) %>

		<%- include('dial-controller') %>

		<script>
			(function () {
				// Camera group subset constants — duplicated from camera-groups.ts
				// (DEFAULT_CAMERA_GROUPS and DEFAULT_ENABLED_GROUPS). PI runs in a
				// separate browser context and cannot import action code;
				// camera-focus-pi.test.ts holds this copy and GROUP_SECTIONS to it.
				var ALL_GROUPS = [
					// Car cameras (0-8)
					"Nose", "Gearbox", "Cockpit", "Roll Bar",
					"LF Susp", "RF Susp", "LR Susp", "RR Susp", "Gyro",
					// Chase cameras (9-11)
					"Chase", "Far Chase", "Rear Chase",
					// Track cameras (12-22)
					"TV1", "TV2", "TV3", "TV4", "TV Static", "TV Mixed",
					"Scenic", "Spotter", "Spectator", "Pit Lane", "Pit Lane 2",
					// Aerial cameras (23-24)
					"Chopper", "Blimp"
				];
				var DISPLAY_NAMES = {
					"LF Susp": "Suspension LF",
					"RF Susp": "Suspension RF",
					"LR Susp": "Suspension LR",
					"RR Susp": "Suspension RR"
				};
				var DEFAULT_ENABLED = ["Nose", "Cockpit", "Chase", "TV1", "TV2", "TV3"];
				// Legacy spellings an older PI saved (camera-groups.ts LEGACY_NAMES).
				// The action reads a legacy key as its canonical group, so the grid
				// folds it in too — otherwise it shows the group off while the key
				// cycles into it, and no checkbox could clear it.
				var LEGACY_NAMES = { "Pit Lane2": "Pit Lane 2" };
				var SETTING_KEY = "cameraGroupSubset";
				// The camera catalog view the plugin publishes (#1653, CAMERA_CATALOG_KEY).
				// Its rules — which custom groups the Remembered section lists, in what
				// order, dimmed or not, and what Select All / Clear do to them — live in
				// pi-components' camera-groups-view.ts as window.irdCameraGroups, where
				// they are unit-tested; this script only draws what they return.
				var CATALOG_KEY = "_cameraCatalog";
				var REMEMBERED_HEADING = "Remembered groups";
				var catalog = null;
				var CYCLE_TARGETS = ["cycle-camera", "cycle-sub-camera", "cycle-car", "cycle-track-order", "cycle-driving"];

				// Per-mode wording for the shared Direction dropdown. Cycle by Track
				// Order (#960) walks the ROAD, not a list, so "next"/"previous" would
				// be the wrong words for it — the values are unchanged, only the
				// labels. Modes absent here use the defaults below.
				var DIRECTION_LABELS = {
					"cycle-track-order": { next: "Ahead", previous: "Behind" }
				};
				var DEFAULT_DIRECTION_LABELS = { next: "Next", previous: "Previous" };

				var GROUP_SECTIONS = [
					{ heading: "Car", start: 0, end: 9 },
					{ heading: "Chase", start: 9, end: 12 },
					{ heading: "Track", start: 12, end: 23 },
					{ heading: "Aerial", start: 23, end: 25 }
				];

				var initialized = false;

				function isCycleTarget(target) {
					return CYCLE_TARGETS.indexOf(target) !== -1;
				}

				// OWN KEYS ONLY (#1653). A camera file may name a group `constructor`,
				// `toString` or `__proto__`, so every name-keyed read checks for an own
				// key, and every name-keyed map here has a null prototype: on a plain
				// object `constructor` reads as Object's function and assigning
				// `__proto__` replaces the prototype instead of adding the group. A
				// null-prototype map still serialises as the same plain JSON object.
				function own(map, name) {
					return Object.prototype.hasOwnProperty.call(map, name);
				}

				function emptyGroupMap() {
					return Object.create(null);
				}

				function isGroupEnabled(state, name) {
					if (own(state, name)) {
						return state[name] === true;
					}
					return DEFAULT_ENABLED.indexOf(name) !== -1;
				}

				// A legacy key enables its canonical group when either is on (the
				// action's own reading), then drops out, so the next save stores only
				// the canonical name.
				function foldLegacyNames(state) {
					var folded = emptyGroupMap();
					var names = Object.keys(state);
					for (var i = 0; i < names.length; i++) {
						var name = names[i];
						var canonical = own(LEGACY_NAMES, name) ? LEGACY_NAMES[name] : name;
						folded[canonical] = (own(folded, canonical) && folded[canonical] === true) || state[name] === true;
					}
					return folded;
				}

				// Ensure the state has entries for ALL visible groups so saving
				// doesn't lose groups that weren't explicitly toggled.
				// A stored subset as the action reads it (parseGroupSubset): a JSON
				// string or an object whose `groups` is a plain map, or null for anything
				// else — which the action reads as no subset and falls back from. Only a
				// name stored true is on, so a standard group the map leaves out shows
				// off, never as its default: an explicit empty map is an empty subset
				// (#1653 review).
				function readGroups(value) {
					var subset = value;
					if (typeof value === "string") {
						if (!value) return null;
						try {
							subset = JSON.parse(value);
						} catch (e) {
							return null;
						}
					}
					if (typeof subset !== "object" || subset === null) return null;
					var groups = subset.groups;
					if (typeof groups !== "object" || groups === null || Array.isArray(groups)) return null;
					var state = foldLegacyNames(groups);
					for (var i = 0; i < ALL_GROUPS.length; i++) {
						if (!own(state, ALL_GROUPS[i])) state[ALL_GROUPS[i]] = false;
					}
					return state;
				}

				function ensureAllGroupsTracked(state) {
					for (var i = 0; i < ALL_GROUPS.length; i++) {
						if (!own(state, ALL_GROUPS[i])) {
							state[ALL_GROUPS[i]] = DEFAULT_ENABLED.indexOf(ALL_GROUPS[i]) !== -1;
						}
					}
				}

				// Shared grid renderer — the SAME markup for the keypad Cycle Camera
				// selector and the dial Cycle Camera selector (#803).
				function renderGroupCheckboxes(gridId, state, onToggle) {
					var grid = document.getElementById(gridId);
					if (!grid) return;

					// A re-render (a catalog push, #1653) replaces every checkbox; the
					// one holding keyboard focus gets it back by its group name.
					var active = document.activeElement;
					var focusedGroup = active && active !== grid && grid.contains(active) && active.dataset ? active.dataset.group : undefined;

					grid.innerHTML = "";
					drawGroupCheckboxes(grid, state, onToggle);

					if (focusedGroup === undefined) return;

					var boxes = grid.querySelectorAll("input[type=\"checkbox\"]");
					for (var b = 0; b < boxes.length; b++) {
						// By dataset, not a selector: a group may be named anything.
						if (boxes[b].dataset.group === focusedGroup) {
							boxes[b].focus();
							return;
						}
					}
				}

				function drawGroupCheckboxes(grid, state, onToggle) {

					for (var s = 0; s < GROUP_SECTIONS.length; s++) {
						var section = GROUP_SECTIONS[s];
						var heading = document.createElement("div");
						heading.className = "group-heading";
						heading.textContent = section.heading;
						grid.appendChild(heading);

						for (var i = section.start; i < section.end && i < ALL_GROUPS.length; i++) {
							var name = ALL_GROUPS[i];
							var label = document.createElement("label");
							var checkbox = document.createElement("input");
							checkbox.type = "checkbox";
							checkbox.checked = isGroupEnabled(state, name);
							checkbox.dataset.group = name;
							checkbox.addEventListener("change", function (ev) {
								onToggle(ev.target.dataset.group, ev.target.checked);
							});
							label.appendChild(checkbox);
							label.appendChild(document.createTextNode(own(DISPLAY_NAMES, name) ? DISPLAY_NAMES[name] : name));
							grid.appendChild(label);
						}
					}

					// Remembered groups (#1653): the custom groups the catalog knows plus any
					// the stored subset ticks — this track's first, the rest dimmed. Never
					// ticked by default: isGroupEnabled reads a name absent from the map as
					// off unless it is in DEFAULT_ENABLED, which holds only standard groups.
					var remembered = window.irdCameraGroups ? window.irdCameraGroups.rememberedGroups(catalog, state) : [];
					if (remembered.length === 0) return;

					var rememberedHeading = document.createElement("div");
					rememberedHeading.className = "group-heading";
					rememberedHeading.textContent = REMEMBERED_HEADING;
					grid.appendChild(rememberedHeading);

					for (var r = 0; r < remembered.length; r++) {
						var entry = remembered[r];
						var entryLabel = document.createElement("label");
						if (entry.dimmed) entryLabel.className = "dimmed";
						entryLabel.title = entry.title;
						var entryBox = document.createElement("input");
						entryBox.type = "checkbox";
						entryBox.checked = isGroupEnabled(state, entry.name);
						entryBox.dataset.group = entry.name;
						entryBox.addEventListener("change", function (ev) {
							onToggle(ev.target.dataset.group, ev.target.checked);
						});
						entryLabel.appendChild(entryBox);
						entryLabel.appendChild(document.createTextNode(entry.name));
						grid.appendChild(entryLabel);
					}
				}

				// A camera-group selector bound to a settings hook. The keypad uses a
				// per-action hook (with a legacy global fallback); the dial uses the
				// GLOBAL cameraGroupSubset directly — the same set the dial rotation
				// honors via getEnabledGroupNames(undefined) (#803).
				function createGroupSelector(gridId, selectAllId, clearId) {
					var state = emptyGroupMap();
					var save = null;
					// Whether the state is a real stored value (pushed or held) or the
					// user's choice (#1653 review). The value sdpi held before the
					// subscription is read once, late, and applies only while it is not:
					// it must never overwrite either. A grid showing only a fallback —
					// defaults, or the keypad's legacy global subset — is not known, so
					// a stored value or a later fallback can still replace it.
					var known = false;
					// Whether the subset that applies to this grid is known (#1653
					// review): until then the grid shows a provisional state, and a
					// choice made from it would save that state over the stored one, so
					// the grid takes no choice.
					var ready = false;
					// The subsets this grid saved that no delivery has confirmed yet, oldest
					// first, and the last delivery it took (#1653 review). sdpi hands every
					// hook its key's value on every push — a catalog-only push included —
					// and a push can carry a value from before an edit, or the echo of an
					// earlier save while a later edit is still unsaved. Taking either would
					// replace the newer edit, and the next save would drop it.
					var unconfirmed = [];
					var lastDelivered;

					function persist() {
						if (!save) return;
						var raw = JSON.stringify({ groups: state });
						unconfirmed.push(raw);
						save(raw);
					}
					function applyReady() {
						var grid = document.getElementById(gridId);
						if (grid) {
							var boxes = grid.querySelectorAll("input");
							for (var i = 0; i < boxes.length; i++) boxes[i].disabled = !ready;
						}
						var a = document.getElementById(selectAllId);
						if (a) a.disabled = !ready;
						var c = document.getElementById(clearId);
						if (c) c.disabled = !ready;
					}
					function render() {
						renderGroupCheckboxes(gridId, state, function (name, checked) {
							if (!ready) {
								render();
								return;
							}
							known = true;
							ensureAllGroupsTracked(state);
							// A custom group is in the map only while ticked (#1653), so
							// unticking one drops it rather than storing false.
							if (checked || ALL_GROUPS.indexOf(name) !== -1) {
								state[name] = checked;
							} else {
								delete state[name];
							}
							persist();
						});
						applyReady();
					}
					function setAll(value) {
						if (!ready) return;
						known = true;
						ensureAllGroupsTracked(state);
						for (var i = 0; i < ALL_GROUPS.length; i++) {
							state[ALL_GROUPS[i]] = value;
						}
						// Remembered groups (#1653): Select All ticks this track's custom
						// groups and leaves the rest as they are; Clear unticks them all.
						if (window.irdCameraGroups) {
							state = value
								? window.irdCameraGroups.selectAllRemembered(state, catalog)
								: window.irdCameraGroups.clearRemembered(state);
						}
						render();
						persist();
					}

					function show(groups) {
						state = foldLegacyNames(groups || {});
						render();
					}

					return {
						// A push of a stored value.
						setState: function (groups) { known = true; show(groups); },
						// A push that stores no value: the fallback shows, and is not known.
						setDefault: function (groups) { known = false; show(groups); },
						// The stored value read through the hook's getter: applied only
						// while no stored value or choice has set the state. Writes nothing.
						seedState: function (groups) {
							if (known) return;
							known = true;
							show(groups);
						},
						// A fallback that arrived late (the held value is none, or the
						// legacy subset came after the keypad's empty value): shown only
						// while no stored value or choice has set the state.
						showDefault: function (groups) {
							if (known) return;
							show(groups);
						},
						// Whether the subset that applies is known: the grid takes choices
						// only while it is.
						setReady: function (value) {
							if (ready === value) return;
							ready = value;
							applyReady();
						},
						markReady: function () {
							this.setReady(true);
						},
						// Whether a delivery (its raw value) is a change to take. While this
						// grid has unsaved edits, the echo of its latest save means it is in
						// sync again (nothing to take), and the echo of an earlier save or a
						// repeat of the value from before the edits is ignored; anything else
						// is a change made elsewhere, and is taken. With no edits pending,
						// every delivery but a repeat is taken, an explicit clear included.
						accept: function (raw) {
							if (unconfirmed.length > 0) {
								if (raw === unconfirmed[unconfirmed.length - 1]) {
									unconfirmed = [];
									lastDelivered = raw;
									return false;
								}
								if (unconfirmed.indexOf(raw) !== -1 || raw === lastDelivered) return false;
								unconfirmed = [];
							} else if (raw === lastDelivered) {
								return false;
							}
							lastDelivered = raw;
							return true;
						},
						setSave: function (fn) { save = fn; },
						render: render,
						wireButtons: function () {
							var a = document.getElementById(selectAllId);
							if (a) a.addEventListener("click", function () { setAll(true); });
							var c = document.getElementById(clearId);
							if (c) c.addEventListener("click", function () { setAll(false); });
						}
					};
				}

				var keypadSelector = createGroupSelector("camera-groups-grid", "btn-select-all", "btn-clear");
				var dialSelector = createGroupSelector("dial-camera-groups-grid", "dial-btn-select-all", "dial-btn-clear");

				// Conditional visibility
				function updateVisibility(target) {
					var directionItem = document.getElementById("direction-item");
					var cameraGroupsSection = document.getElementById("camera-groups-section");
					var positionItem = document.getElementById("position-item");
					var carNumberItem = document.getElementById("car-number-item");
					var cameraStateItem = document.getElementById("camera-state-item");

					var isCycle = isCycleTarget(target);

					if (directionItem) {
						directionItem.classList.toggle("hidden", !isCycle);
					}

					var labels = DIRECTION_LABELS[target] || DEFAULT_DIRECTION_LABELS;
					var nextOption = document.getElementById("direction-next-label");
					var previousOption = document.getElementById("direction-previous-label");
					if (nextOption) nextOption.textContent = labels.next;
					if (previousOption) previousOption.textContent = labels.previous;

					if (cameraGroupsSection) {
						cameraGroupsSection.classList.toggle("hidden", target !== "cycle-camera");
					}
					if (positionItem) {
						positionItem.classList.toggle("hidden", target !== "switch-by-position");
					}
					if (carNumberItem) {
						carNumberItem.classList.toggle("hidden", target !== "switch-by-car-number");
					}
					if (cameraStateItem) {
						cameraStateItem.classList.toggle("hidden", target !== "set-camera-state");
					}
					var focusSelectCarSection = document.getElementById("focus-select-car-section");
					if (focusSelectCarSection) {
						focusSelectCarSection.classList.toggle("hidden", target !== "focus-select-car");
					}
					var cameraGroupItem = document.getElementById("camera-group-item");
					if (cameraGroupItem) {
						cameraGroupItem.classList.toggle("hidden", target !== "change-camera");
					}
					var cameraGroupNote = document.getElementById("camera-group-note");
					if (cameraGroupNote) {
						cameraGroupNote.classList.toggle("hidden", target !== "change-camera");
					}
				}

				// Dial Mode visibility — the shared camera-groups selector shows only
				// for the dial's Cycle Camera mode (#803).
				function updateDialVisibility(mode) {
					var section = document.getElementById("dial-camera-groups-section");
					if (section) section.classList.toggle("hidden", mode !== "camera");
				}

				async function initializePI() {
					if (initialized) return;
					initialized = true;

					await customElements.whenDefined("sdpi-select");

					if (window.SDPIComponents) {
						// The camera catalog (#1653): both grids redraw their Remembered
						// section when it changes. Read on the push only, never in response
						// to a click; sdpi re-delivers every key on every push, so an
						// unchanged value is skipped.
						var lastCatalog;
						function applyCatalog(value) {
							var raw = typeof value === "string" ? value : JSON.stringify(value === undefined ? null : value);
							if (raw === lastCatalog) return;
							lastCatalog = raw;
							catalog = window.irdCameraGroups ? window.irdCameraGroups.parseCatalog(value) : null;
							keypadSelector.render();
							dialSelector.render();
						}
						var catalogHook = window.SDPIComponents.useGlobalSettings(CATALOG_KEY, applyCatalog);
						// sdpi hands a subscription only the pushes after it, and this one
						// is made late (after DOMContentLoaded and whenDefined), so the push
						// that brought the catalog may be gone. The hook's getter returns
						// the value sdpi already holds — a local read that sends nothing,
						// resolving once global settings first arrive — and lastCatalog
						// skips it when a push delivered it first.
						catalogHook[0]().then(applyCatalog);

						// Keypad selector: the per-action subset, falling back — as the action
						// does — to the legacy global one when the key has no valid subset of
						// its own. Dial selector: the GLOBAL cameraGroupSubset.
						//
						// Each grid takes choices only once the subset that applies to it is
						// known (#1653 review). Pushes and sdpi's held values arrive in any
						// order, and sdpi replays no push to these late subscriptions, so each
						// hook's getter is read too (a local read that sends nothing). A valid
						// held keypad subset applies as soon as it resolves; only a key without
						// one waits for the global fallback. A push wins over a held value, and
						// a stored value or a choice over a fallback.
						var keypadResolved = false;
						var legacyGroups = null;
						var legacyKnown = false;
						var dialKnown = false;
						// A delivery is taken only when it is a change for the grid it feeds
						// (the selector's `accept`, #1653 review): an echo of the grid's own
						// saves and a repeat of an older value never replace an unsaved edit.
						function rawOf(value) {
							return typeof value === "string" ? value : JSON.stringify(value === undefined ? null : value);
						}

						function settleKeypad() {
							if (keypadResolved && legacyKnown) keypadSelector.markReady();
						}
						function takeLegacy(value) {
							legacyKnown = true;
							legacyGroups = readGroups(value);
							// Global settings usually arrive after the keypad's own (empty)
							// value: a key with none takes the legacy subset now.
							keypadSelector.showDefault(legacyGroups || emptyGroupMap());
							settleKeypad();
						}
						function takeKeypad(value, held) {
							if (!keypadSelector.accept(rawOf(value))) return;
							keypadResolved = true;
							var groups = readGroups(value);
							if (groups) {
								if (held) keypadSelector.seedState(groups);
								else keypadSelector.setState(groups);
								keypadSelector.markReady();
								return;
							}
							if (held) keypadSelector.showDefault(legacyGroups || emptyGroupMap());
							else keypadSelector.setDefault(legacyGroups || emptyGroupMap());
							// No subset of its own (any more): the fallback applies, so the grid
							// takes choices only once it is known — not on the strength of an own
							// subset an earlier push brought and this one cleared (#1653 review).
							keypadSelector.setReady(legacyKnown);
						}
						function takeDial(value, held) {
							if (!dialSelector.accept(rawOf(value))) return;
							dialKnown = true;
							var groups = readGroups(value);
							if (groups) {
								if (held) dialSelector.seedState(groups);
								else dialSelector.setState(groups);
							} else if (held) {
								dialSelector.showDefault(emptyGroupMap());
							} else {
								dialSelector.setDefault(emptyGroupMap());
							}
							dialSelector.markReady();
						}

						var legacyHook = window.SDPIComponents.useGlobalSettings(SETTING_KEY, takeLegacy);
						var keypadHook = window.SDPIComponents.useSettings(SETTING_KEY, function (value) {
							takeKeypad(value, false);
						});
						keypadSelector.setSave(keypadHook[1]);
						var dialHook = window.SDPIComponents.useGlobalSettings(SETTING_KEY, function (value) {
							takeDial(value, false);
						});
						dialSelector.setSave(dialHook[1]);

						keypadHook[0]().then(function (held) {
							if (!keypadResolved) takeKeypad(held, true);
						});
						legacyHook[0]().then(function (held) {
							if (!legacyKnown) takeLegacy(held);
						});
						dialHook[0]().then(function (held) {
							if (!dialKnown) takeDial(held, true);
						});
					} else {
						// No settings to wait for, and none to save to.
						keypadSelector.markReady();
						dialSelector.markReady();
					}

					keypadSelector.wireButtons();
					dialSelector.wireButtons();

					// Restrict car number input to digits only (preserve leading zeros)
					var carNumberField = document.getElementById("car-number-field");
					if (carNumberField) window.irdDigitsOnly(carNumberField);

					// Keypad target visibility
					var targetSelect = document.getElementById("target-select");
					if (targetSelect) {
						var initialValue = targetSelect.value || "change-camera";
						updateVisibility(initialValue);

						targetSelect.addEventListener("change", function (ev) {
							updateVisibility(ev.target.value || "change-camera");
						});
						targetSelect.addEventListener("input", function (ev) {
							updateVisibility(ev.target.value || "change-camera");
						});

						var lastTarget = targetSelect.value || "change-camera";
						window.irdPoll(function () {
							var currentTarget = targetSelect.value;
							if (currentTarget && currentTarget !== lastTarget) {
								lastTarget = currentTarget;
								updateVisibility(currentTarget);
							}
						});
					}

					// Dial mode visibility
					var dialModeSelect = document.getElementById("dial-mode-select");
					if (dialModeSelect) {
						updateDialVisibility(dialModeSelect.value || "car-number");

						dialModeSelect.addEventListener("change", function (ev) {
							updateDialVisibility(ev.target.value || "car-number");
						});
						dialModeSelect.addEventListener("input", function (ev) {
							updateDialVisibility(ev.target.value || "car-number");
						});

						var lastMode = dialModeSelect.value || "car-number";
						window.irdPoll(function () {
							var currentMode = dialModeSelect.value;
							if (currentMode && currentMode !== lastMode) {
								lastMode = currentMode;
								updateDialVisibility(currentMode);
							}
						});
					}

					keypadSelector.render();
					dialSelector.render();

					// Switch to the dial view last, so a slow/failed controller lookup
					// still leaves a fully functional keypad PI (the default view).
					if ((await window.irdResolveController()) === "Encoder") {
						window.irdApplyDialView();
					}
				}

				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", initializePI);
				} else {
					initializePI();
				}
			})();
		</script>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
