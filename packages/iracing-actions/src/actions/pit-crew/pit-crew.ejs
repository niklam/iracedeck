<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<sdpi-item label="Mode">
			<sdpi-select id="mode-select" setting="mode" default="race-engineer">
				<option value="race-engineer">Race Engineer Toggle</option>
				<option value="radar">Radar</option>
				<option value="radar-volume">Radar Volume</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item id="direction-item" class="hidden" label="Direction">
			<sdpi-select setting="direction" default="up">
				<option value="up">Up</option>
				<option value="down">Down</option>
			</sdpi-select>
		</sdpi-item>

		<%- include('accordion', {
			title: 'Pit Crew Settings',
			accordionId: 'pitCrewSettings',
			open: true,
			content:
				'<sdpi-item label="On startup">' +
					'<sdpi-checkbox setting="raceEngineerEnabledOnStartup" label="Race Engineer enabled" global></sdpi-checkbox>' +
					'<br>' +
					'<sdpi-checkbox setting="radarEnabledOnStartup" label="Radar enabled" global></sdpi-checkbox>' +
				'</sdpi-item>' +
				'<sdpi-item label="Race Engineer Voice">' +
					'<ird-voice-select setting="raceEngineerVoice" voices="_raceEngineerVoices"></ird-voice-select>' +
				'</sdpi-item>' +
				'<sdpi-item label="Your Name">' +
					'<ird-name-select setting="driverName" names="_driverNames" default="driver"></ird-name-select>' +
				'</sdpi-item>' +
				'<sdpi-item label="Output Device">' +
					'<ird-audio-device-select setting="audioOutputDevice" devices="_audioDeviceList" default-label="System Default"></ird-audio-device-select>' +
				'</sdpi-item>' +
				'<sdpi-item label="Race Engineer Volume">' +
					'<div style="display:flex;align-items:center;gap:8px;">' +
						'<ird-range-input setting="raceEngineerVolume" global min="0" max="100" step="1" default="100" style="flex:1;"></ird-range-input>' +
						'<ird-audio-test target="test-race-engineer-voice-field" label="Test"></ird-audio-test>' +
					'</div>' +
				'</sdpi-item>' +
				'<sdpi-item label="Background Volume">' +
					'<div style="display:flex;align-items:center;gap:8px;">' +
						'<ird-range-input setting="backgroundVolume" global min="0" max="100" step="1" default="35" style="flex:1;"></ird-range-input>' +
						'<ird-audio-test target="test-background-field" label="Test"></ird-audio-test>' +
					'</div>' +
				'</sdpi-item>' +
				'<sdpi-item label="Radar Volume">' +
					'<div style="display:flex;align-items:center;gap:8px;">' +
						'<ird-range-input setting="radarVolume" global min="0" max="100" step="1" default="100" style="flex:1;"></ird-range-input>' +
						'<ird-audio-test target="test-radar-field" label="Test"></ird-audio-test>' +
					'</div>' +
				'</sdpi-item>'
		}) %>

		<%
			// Source-of-truth list for the Race Engineer flag callouts.
			// Add a new entry here and the 2-column grid below auto-rebalances
			// (rows = ceil(N / 2), grid-auto-flow: column → fills column 1 top
			// to bottom, then column 2). Stays at exactly two columns no matter
			// how the list grows.
			var flagCallouts = [
				{ setting: "calloutEnabledFlagYellowLocal",   label: "Yellow (local)" },
				{ setting: "calloutEnabledFlagYellowFull",    label: "Yellow (full course)" },
				{ setting: "calloutEnabledFlagYellowCleared", label: "Yellow cleared" },
				{ setting: "calloutEnabledFlagGreen",         label: "Green" },
				{ setting: "calloutEnabledFlagBlue",          label: "Blue" },
				{ setting: "calloutEnabledFlagWhite",         label: "White" },
				{ setting: "calloutEnabledFlagRed",           label: "Red" },
				{ setting: "calloutEnabledFlagBlack",         label: "Black" },
				{ setting: "calloutEnabledFlagCheckered",     label: "Checkered" },
				{ setting: "calloutEnabledFlagDebris",        label: "Debris" },
				{ setting: "calloutEnabledFlagMeatball",      label: "Meatball" },
			];
			var flagCalloutRowCount = Math.ceil(flagCallouts.length / 2);
			var flagCalloutCheckboxes = flagCallouts.map(function (c) {
				return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
			}).join('');

			// Pit-service readback opt-ins (issue #476). Same source-of-truth
			// 2-column grid as flag callouts — adding a row here is the only
			// place to extend.
			var pitReadbackCallouts = [
				{ setting: "calloutEnabledPitReadbackEntry", label: "Pit entry" },
				{ setting: "calloutEnabledPitReadbackExit",  label: "Pit exit" },
			];
			var pitReadbackRowCount = Math.ceil(pitReadbackCallouts.length / 2);
			var pitReadbackCheckboxes = pitReadbackCallouts.map(function (c) {
				return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
			}).join('');
		%>
		<%- include('accordion', {
			title: 'Race Engineer Callouts',
			accordionId: 'raceEngineerCallouts',
			open: false,
			content:
				'<sdpi-item label="Flags">' +
					'<div style="display:grid;grid-template-rows:repeat(' + flagCalloutRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
						flagCalloutCheckboxes +
					'</div>' +
				'</sdpi-item>' +
				'<sdpi-item label="Pit Service Readback">' +
					'<div style="display:grid;grid-template-rows:repeat(' + pitReadbackRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
						pitReadbackCheckboxes +
					'</div>' +
				'</sdpi-item>'
		}) %>

		<div style="display:none;">
			<sdpi-textfield id="test-radar-field" setting="_testRadarVolume"></sdpi-textfield>
			<sdpi-textfield id="test-race-engineer-voice-field" setting="_testRaceEngineerVoice"></sdpi-textfield>
			<sdpi-textfield id="test-background-field" setting="_testBackgroundVolume"></sdpi-textfield>
		</div>

		<script>
		(function() {
			// Direction visibility — hide unless Mode = radar-volume. sdpi-select
			// events can be flaky (see session-info.ejs precedent), so combine
			// change/input listeners with a polling fallback.
			async function initializeDirectionVisibility() {
				await customElements.whenDefined("sdpi-select");
				const modeSelect = document.getElementById("mode-select");
				const directionItem = document.getElementById("direction-item");
				if (!modeSelect || !directionItem) return;

				const update = (mode) => {
					if (mode === "radar-volume") directionItem.classList.remove("hidden");
					else directionItem.classList.add("hidden");
				};

				update(modeSelect.value || "race-engineer");
				modeSelect.addEventListener("change", (ev) => update(ev.target.value));
				modeSelect.addEventListener("input", (ev) => update(ev.target.value));

				let last = modeSelect.value || "race-engineer";
				setInterval(() => {
					const current = modeSelect.value;
					if (current && current !== last) {
						last = current;
						update(current);
					}
				}, 100);
			}
			if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initializeDirectionVisibility);
			else initializeDirectionVisibility();
		})();
		</script>

		<style>
		.hidden { display: none !important; }
		</style>

		<%- include('title-overrides') %>

		<%- include('color-overrides', { slots: ['backgroundColor', 'textColor', 'graphic1Color'], defaults: require('./data/icon-defaults.json')['pit-crew'] }) %>
		<%- include('border-overrides', { defaults: require('./data/icon-defaults.json')['pit-crew'] }) %>
		<%- include('graphic-overrides') %>
		<%- include('common-settings') %>

		<%- include('section-header', { title: 'Global Settings' }) %>

		<%- include('global-title-defaults') %>
		<%- include('global-color-defaults') %>
		<%- include('global-border-defaults') %>
		<%- include('global-graphic-defaults') %>
		<%- include('global-common-settings') %>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
