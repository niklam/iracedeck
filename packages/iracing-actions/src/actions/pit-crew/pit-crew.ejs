<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<sdpi-item label="Mode">
			<sdpi-select id="mode-select" setting="mode" default="race-engineer">
				<option value="race-engineer">Race Engineer Toggle</option>
				<option value="radar">Radar</option>
				<option value="corner-names">Corner Names</option>
				<!-- Radar Volume moved to the Audio Controls action (issue #590). The option
				     is removed from this dropdown for new buttons but kept (via JS) when a
				     button already uses it, so existing setups keep working. -->
				<option value="radar-volume" id="radar-volume-option">Radar Volume</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item id="direction-item" class="hidden" label="Direction">
			<sdpi-select setting="direction" default="up">
				<option value="up">Up</option>
				<option value="down">Down</option>
			</sdpi-select>
		</sdpi-item>

		<%# The Race Engineer voice, volumes, callout opt-ins and setup-warning
		    patterns are plugin-global, so since #1003 they live only in the
		    settings window — reachable from the button below. Their audio
		    previews moved with them: ird-audio-test sends `audioPreview` to the
		    plugin from the window, which is why the hidden `_test*` fields and
		    this action's timestamp watchers are gone too. %>

		<script>
		(function() {
			// Direction visibility — hide unless Mode = radar-volume. sdpi-select
			// events can be flaky (see session-info.ejs precedent), so combine
			// change/input listeners with a polling fallback.
			async function initializeDirectionVisibility() {
				await customElements.whenDefined("sdpi-select");
				const modeSelect = document.getElementById("mode-select");
				const directionItem = document.getElementById("direction-item");
				if (!modeSelect || !directionItem) return;

				// Radar Volume is deprecated here (issue #590) — it now lives in the
				// Audio Controls action. Keep the option only when this button already
				// uses it so existing setups keep a working PI; remove it otherwise so
				// new buttons can't pick it.
				const radarVolumeOption = modeSelect.querySelector('option[value="radar-volume"]');
				const radarVolumeOptionParent = radarVolumeOption ? radarVolumeOption.parentNode : null;
				const syncRadarVolumeOption = (mode) => {
					if (!radarVolumeOption || !radarVolumeOptionParent) return;
					const isAttached = radarVolumeOption.parentNode === radarVolumeOptionParent;
					if (mode === "radar-volume") {
						if (!isAttached) radarVolumeOptionParent.appendChild(radarVolumeOption);
					} else if (isAttached) {
						radarVolumeOption.remove();
					}
				};

				const update = (mode) => {
					syncRadarVolumeOption(mode);
					if (mode === "radar-volume") directionItem.classList.remove("hidden");
					else directionItem.classList.add("hidden");
				};

				update(modeSelect.value || "race-engineer");
				modeSelect.addEventListener("change", (ev) => update(ev.target.value));
				modeSelect.addEventListener("input", (ev) => update(ev.target.value));

				let last = modeSelect.value || "race-engineer";
				window.irdPoll(() => {
					const current = modeSelect.value;
					if (current && current !== last) {
						last = current;
						update(current);
					}
				});
			}
			if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initializeDirectionVisibility);
			else initializeDirectionVisibility();
		})();
		</script>

		<style>
		.hidden { display: none !important; }
		</style>

		<%- include('action-settings-footer') %>

		<%- include('title-overrides') %>

		<%- include('color-overrides', { slots: ['backgroundColor', 'textColor', 'graphic1Color'], defaults: require('./data/icon-defaults.json')['pit-crew'] }) %>
		<%- include('border-overrides', { defaults: require('./data/icon-defaults.json')['pit-crew'] }) %>
		<%- include('graphic-overrides') %>
		<%- include('common-settings') %>

		<%- include('key-bindings-section') %>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
