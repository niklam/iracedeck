<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<sdpi-item label="Mode">
			<sdpi-select id="mode-select" setting="mode" default="race-engineer">
				<option value="race-engineer">Race Engineer Toggle</option>
				<option value="radar">Radar</option>
				<option value="corner-names">Corner Names</option>
				<option value="telemetry-readout">Telemetry Readout</option>
				<!-- Radar Volume moved to the Audio Controls action (issue #590). The option
				     is removed from this dropdown for new buttons but kept (via JS) when a
				     button already uses it, so existing setups keep working. -->
				<option value="radar-volume" id="radar-volume-option">Radar Volume</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item id="direction-item" class="hidden" label="Direction">
			<sdpi-select setting="direction" default="up">
				<option value="up">Up</option>
				<option value="down">Down</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item id="readout-kind-item" class="hidden" label="Readout">
			<sdpi-select id="readout-kind-select" setting="readoutKind" default="fuel-last-lap">
				<option value="fuel-last-lap">Fuel Used Last Lap</option>
				<option value="fuel-average">Average Fuel per Lap</option>
				<option value="track-temp">Track Temperature</option>
				<option value="air-temp">Air Temperature</option>
			</sdpi-select>
		</sdpi-item>

		<sdpi-item id="fuel-window-item" class="hidden" label="Laps">
			<ird-range-input setting="fuelLapWindow" min="1" max="20" step="1" default="5" showlabels></ird-range-input>
		</sdpi-item>
		<div id="readout-help" class="ird-supporting-text hidden">
			The Race Engineer speaks the figure in your iRacing display units when you press the key. He must be switched on.
		</div>
		<div id="fuel-window-help" class="ird-supporting-text hidden">
			How many recent clean laps the average covers. Laps with a pit stop or tow are skipped; early in a stint he names the laps actually averaged.
		</div>

		<%# The Race Engineer voice, volumes, callout opt-ins and setup-warning
		    patterns are plugin-global, so since #1003 they live only in the
		    settings window — reachable from the button below. Their audio
		    previews moved with them: ird-audio-test sends `audioPreview` to the
		    plugin from the window, which is why the hidden `_test*` fields and
		    this action's timestamp watchers are gone too. %>

		<script>
		(function() {
			// Visibility of the per-mode items: Direction for radar-volume, the
			// Readout picker for telemetry-readout, and the Laps window for its
			// average-fuel readout only. sdpi-select events can be flaky (see the
			// session-info.ejs precedent), so combine change/input listeners with
			// the shared page poller.
			async function initializeVisibility() {
				await customElements.whenDefined("sdpi-select");
				const modeSelect = document.getElementById("mode-select");
				const kindSelect = document.getElementById("readout-kind-select");
				const directionItem = document.getElementById("direction-item");
				const kindItem = document.getElementById("readout-kind-item");
				const windowItem = document.getElementById("fuel-window-item");
				const readoutHelp = document.getElementById("readout-help");
				const windowHelp = document.getElementById("fuel-window-help");
				if (!modeSelect || !kindSelect || !directionItem || !kindItem || !windowItem) return;

				// Radar Volume is deprecated here (issue #590) — it now lives in the
				// Audio Controls action. Keep the option only when this button already
				// uses it so existing setups keep a working PI; remove it otherwise so
				// new buttons can't pick it.
				const radarVolumeOption = modeSelect.querySelector('option[value="radar-volume"]');
				const radarVolumeOptionParent = radarVolumeOption ? radarVolumeOption.parentNode : null;
				const syncRadarVolumeOption = (mode) => {
					if (!radarVolumeOption || !radarVolumeOptionParent) return;
					const isAttached = radarVolumeOption.parentNode === radarVolumeOptionParent;
					if (mode === "radar-volume") {
						if (!isAttached) radarVolumeOptionParent.appendChild(radarVolumeOption);
					} else if (isAttached) {
						radarVolumeOption.remove();
					}
				};

				const show = (el, visible) => {
					if (!el) return;
					if (visible) el.classList.remove("hidden");
					else el.classList.add("hidden");
				};

				const update = () => {
					const mode = modeSelect.value || "race-engineer";
					const kind = kindSelect.value || "fuel-last-lap";
					const readout = mode === "telemetry-readout";
					syncRadarVolumeOption(mode);
					show(directionItem, mode === "radar-volume");
					show(kindItem, readout);
					show(readoutHelp, readout);
					show(windowItem, readout && kind === "fuel-average");
					show(windowHelp, readout && kind === "fuel-average");
				};

				update();
				for (const select of [modeSelect, kindSelect]) {
					select.addEventListener("change", update);
					select.addEventListener("input", update);
				}

				let last = `${modeSelect.value}|${kindSelect.value}`;
				window.irdPoll(() => {
					const current = `${modeSelect.value}|${kindSelect.value}`;
					if (current !== last) {
						last = current;
						update();
					}
				});
			}
			if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initializeVisibility);
			else initializeVisibility();
		})();
		</script>

		<style>
		.hidden { display: none !important; }
		</style>

		<%- include('action-settings-footer') %>

		<%- include('title-overrides') %>

		<%- include('color-overrides', { slots: ['backgroundColor', 'textColor', 'graphic1Color'], defaults: require('./data/icon-defaults.json')['pit-crew'] }) %>
		<%- include('border-overrides', { defaults: require('./data/icon-defaults.json')['pit-crew'] }) %>
		<%- include('graphic-overrides') %>
		<%- include('common-settings') %>

		<%- include('key-bindings-section') %>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
