<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<% var __comms = require('./data/action-comms.json')['setup-chassis']; %>
		<% var __dialComms = require('./data/action-comms.json')['setup-chassis-dial']; %>

		<!-- Keypad settings — hidden when this instance is a dial (#800). -->
		<div id="keypad-settings">
			<sdpi-item label="Mode">
				<sdpi-select id="setting-select" setting="setting" default="differential-preload">
					<optgroup label="Adjust">
						<option value="differential-entry">Differential Entry</option>
						<option value="differential-exit">Differential Exit</option>
						<option value="differential-middle">Differential Middle</option>
						<option value="differential-preload">Differential Preload</option>
						<option value="front-arb">Front ARB</option>
						<option value="lr-spring">LR Spring</option>
						<option value="lf-shock">LF Shock</option>
						<option value="lr-shock">LR Shock</option>
						<option value="power-steering">Power Steering</option>
						<option value="rear-arb">Rear ARB</option>
						<option value="rf-shock">RF Shock</option>
						<option value="rr-spring">RR Spring</option>
						<option value="rr-shock">RR Shock</option>
					</optgroup>
					<optgroup label="Display value">
						<option value="view-anti-roll-front">View Anti-Roll Front</option>
						<option value="view-anti-roll-rear">View Anti-Roll Rear</option>
						<option value="view-diff-entry">View Diff Entry</option>
						<option value="view-diff-exit">View Diff Exit</option>
						<option value="view-diff-middle">View Diff Middle</option>
						<option value="view-diff-preload">View Diff Preload</option>
						<option value="view-lr-spring-offset">View LR Spring Offset</option>
						<option value="view-power-steering">View Power Steering</option>
						<option value="view-rr-spring-offset">View RR Spring Offset</option>
						<option value="view-weight-jacker-left">View Weight Jacker Left</option>
						<option value="view-weight-jacker-right">View Weight Jacker Right</option>
					</optgroup>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="<%= __comms._meta.modeSetting %>" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

			<sdpi-item label="Direction" id="direction-item">
				<sdpi-select setting="direction" default="increase">
					<option value="increase">Increase</option>
					<option value="decrease">Decrease</option>
				</sdpi-select>
			</sdpi-item>

			<%- include('dual-press-overrides') %>

			<%- include('adjust-style', {
				modeSelectId: 'setting-select',
				pairedModes: ['differential-preload', 'differential-entry', 'differential-middle', 'differential-exit', 'front-arb', 'rear-arb', 'lr-spring', 'rr-spring', 'power-steering'],
				viewModes: ['view-diff-preload', 'view-diff-entry', 'view-diff-middle', 'view-diff-exit', 'view-anti-roll-front', 'view-anti-roll-rear', 'view-power-steering', 'view-weight-jacker-left', 'view-weight-jacker-right', 'view-lr-spring-offset', 'view-rr-spring-offset']
			}) %>

			<sdpi-item label="Units" id="units-item" class="hidden">
				<sdpi-select setting="units" default="auto">
					<option value="auto">Auto (follow iRacing)</option>
					<option value="metric">Metric (mm)</option>
					<option value="imperial">Imperial (inches)</option>
				</sdpi-select>
			</sdpi-item>

			<sdpi-item label="Show black box">
				<sdpi-checkbox
					id="show-black-box"
					setting="showBlackBox"
					label="Show the matching black box when this key is pressed"
				></sdpi-checkbox>
			</sdpi-item>
			<div class="ird-supporting-text">
				Lets you see the value change in iRacing — In-Car Adjustments for the
				differential, ARBs, power steering, and weight jackers; Pit Stop Adjustments
				for the springs and shocks. iRacing never says which black box is open, so
				iRaceDeck switches through another box first; both keypresses are sent
				together, so you effectively never see it.
			</div>
			<%
			var __primeCandidates = require('./data/key-bindings.json').blackBox
				.filter(function (b) { return b.id !== 'cycleNext' && b.id !== 'cyclePrevious'; })
				.map(function (b) { return b.setting; });
			%>
			<ird-black-box-caveat
				id="chassis-black-box-caveat"
				enabled-setting="showBlackBox"
				target="blackBoxInCar"
				candidates='<%= JSON.stringify(__primeCandidates) %>'
				message="Showing the black box needs keyboard bindings for the In-Car black box and at least one other black box. Set them under Related Key Bindings. The value still changes without them."
			></ird-black-box-caveat>
		</div>

		<!-- Dial settings — shown only when this instance is a dial (#800). Setup
		     Chassis dial: rotation Mode, gestures, units, and appearance. -->
		<div id="dial-settings" class="hidden">
			<sdpi-item label="Mode">
				<sdpi-select setting="dial.setting" default="differential-preload">
					<optgroup label="Differential">
						<option value="differential-preload">Differential Preload</option>
						<option value="differential-entry">Differential Entry</option>
						<option value="differential-middle">Differential Middle</option>
						<option value="differential-exit">Differential Exit</option>
					</optgroup>
					<optgroup label="Anti-Roll Bars">
						<option value="front-arb">Front ARB</option>
						<option value="rear-arb">Rear ARB</option>
					</optgroup>
					<optgroup label="Springs">
						<option value="lr-spring">LR Spring</option>
						<option value="rr-spring">RR Spring</option>
					</optgroup>
					<optgroup label="Shocks">
						<option value="lf-shock">LF Shock</option>
						<option value="rf-shock">RF Shock</option>
						<option value="lr-shock">LR Shock</option>
						<option value="rr-shock">RR Shock</option>
					</optgroup>
					<optgroup label="Steering">
						<option value="power-steering">Power Steering</option>
					</optgroup>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="<%= __dialComms._meta.modeSetting %>" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>
			<% if (locals.platform?.features?.dialFeedback !== false) { %>
			<div class="ird-supporting-text">
				Turn the dial to adjust the selected chassis component; the touch strip shows
				its live value. The LR/RR springs show the pending next-pit-stop offset;
				shocks have no telemetry, so their strips show the label only. Both the
				increase and decrease key bindings must be set below.
			</div>
			<% } else { %>
			<div class="ird-supporting-text">
				Turn the knob to adjust the selected chassis component. Both the increase and
				decrease key bindings must be set below.
			</div>
			<% } %>

			<sdpi-item label="Units">
				<sdpi-select setting="dial.units" default="auto">
					<option value="auto">Auto (follow iRacing)</option>
					<option value="metric">Metric (mm)</option>
					<option value="imperial">Imperial (inches)</option>
				</sdpi-select>
			</sdpi-item>
			<div class="ird-supporting-text">
				Applies to the spring offset readout on the touch strip.
			</div>

			<sdpi-item label="Press Action">
				<sdpi-select setting="dial.pressAction" default="none">
					<option value="none">None</option>
					<option value="show-pit-stop-black-box">Show Pit Stop Black Box</option>
					<option value="toggle-spring-side">Switch LR / RR Spring</option>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="dial.pressAction" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>

			<sdpi-item label="Long Press">
				<sdpi-select setting="dial.longPressAction" default="none">
					<option value="none">None</option>
					<option value="show-pit-stop-black-box">Show Pit Stop Black Box</option>
					<option value="toggle-spring-side">Switch LR / RR Spring</option>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="dial.longPressAction" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>

			<% if (locals.platform?.features?.dialFeedback !== false) { %>
			<sdpi-item label="Tap Display">
				<sdpi-select setting="dial.tapAction" default="none">
					<option value="none">None</option>
					<option value="show-pit-stop-black-box">Show Pit Stop Black Box</option>
					<option value="toggle-spring-side">Switch LR / RR Spring</option>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="dial.tapAction" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>

			<sdpi-item label="Long Touch">
				<sdpi-select setting="dial.longTouchAction" default="none">
					<option value="none">None</option>
					<option value="show-pit-stop-black-box">Show Pit Stop Black Box</option>
					<option value="toggle-spring-side">Switch LR / RR Spring</option>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="dial.longTouchAction" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>
			<% } %>

			<% if (locals.platform?.features?.dialFeedback !== false) { %>
			<%- include('dial-appearance') %>
			<% } %>
		</div>

		<!-- Key-icon appearance — keypad only (a dial has no key icon). -->
		<div id="keypad-appearance">
			<%- include('title-overrides') %>

			<%- include('color-overrides', { slots: ['backgroundColor', 'textColor', 'graphic1Color', 'graphic2Color'], defaults: require('./data/icon-defaults.json')['setup-chassis'] }) %>
			<%- include('border-overrides', { defaults: require('./data/icon-defaults.json')['setup-chassis'] }) %>
			<%- include('graphic-overrides') %>
			<%- include('common-settings') %>
		</div>

		<%- include('section-header', { title: 'Global Settings', openSettings: true }) %>

		<%
		var __kb = require('./data/key-bindings.json');
		// The black-box rows are here so this PI SEEDS their defaults (#818/#953):
		// ird-key-binding writes its `default` into global settings the first time
		// it renders. Lap Timing is the preferred prime, In-Car and Pit Stop are
		// this action's Show-Black-Box / dial-gesture targets.
		var __blackBoxRows = __kb.blackBox
			.filter(function (b) { return b.id === 'lapTiming' || b.id === 'inCar' || b.id === 'pitStop'; })
			.map(function (b) {
				return { id: b.id, label: 'Black Box: ' + b.label, default: b.default, setting: b.setting };
			});
		%>
		<%- include('global-key-bindings', {
			keyBindings: __kb.setupChassis.concat(__blackBoxRows)
		}) %>

		<div id="keypad-global-appearance">
			<%- include('global-title-defaults') %>
			<%- include('global-color-defaults') %>
			<%- include('global-border-defaults') %>
			<%- include('global-graphic-defaults') %>
			<%- include('global-flag-flash') %>
		</div>

		<%- include('global-common-settings') %>

		<script>
			// View sub-modes are read-only displays — hide Direction; show the dual-press opt-in.
			function isViewSetting(setting) {
				return typeof setting === "string" && setting.startsWith("view-");
			}

			// Modes whose value lives in the F7 Pit Stop box (springs and shocks);
			// everything else shows in the F8 In-Car box. Mirrors blackBoxForSetting.
			const PIT_STOP_BOX_MODES = new Set([
				"lr-spring",
				"rr-spring",
				"lf-shock",
				"rf-shock",
				"lr-shock",
				"rr-shock",
				"view-lr-spring-offset",
				"view-rr-spring-offset",
			]);

			// Only the spring modes have a unit-bearing value (mm/inches).
			const SPRING_UNIT_MODES = new Set([
				"lr-spring",
				"rr-spring",
				"view-lr-spring-offset",
				"view-rr-spring-offset",
			]);

			function updateVisibility(setting) {
				const directionItem = document.getElementById("direction-item");
				const dualEnabledItem = document.getElementById("dual-press-enabled-item");
				const unitsItem = document.getElementById("units-item");

				const view = isViewSetting(setting);
				directionItem?.classList.toggle("hidden", view);
				dualEnabledItem?.classList.toggle("hidden", !view);
				unitsItem?.classList.toggle("hidden", !SPRING_UNIT_MODES.has(setting));

				// The Show-Black-Box caveat re-reads its attributes every poll, so
				// retargeting it per mode keeps one element covering both boxes.
				const caveat = document.getElementById("chassis-black-box-caveat");
				if (caveat) {
					const pitStop = PIT_STOP_BOX_MODES.has(setting);
					const boxName = pitStop ? "Pit Stop" : "In-Car";
					caveat.setAttribute("target", pitStop ? "blackBoxPitStop" : "blackBoxInCar");
					caveat.setAttribute(
						"message",
						"Showing the black box needs keyboard bindings for the " + boxName + " black box and at least one other black box. Set them under Related Key Bindings. The value still changes without them.",
					);
				}
			}

			// Which surface this instance sits on: the PI registration's
			// actionInfo.payload.controller ("Keypad" | "Encoder"; the Mirabox host
			// may report "Knob"). Anything unknown or unavailable falls back to the
			// keypad view (#800).
			async function resolveController() {
				try {
					const client = window.SDPIComponents && window.SDPIComponents.streamDeckClient;
					const info = client && (await client.getConnectionInfo());
					const controller = info && info.actionInfo && info.actionInfo.payload && info.actionInfo.payload.controller;
					return controller === "Encoder" || controller === "Knob" ? "Encoder" : "Keypad";
				} catch (err) {
					return "Keypad";
				}
			}

			function applyDialView() {
				document.getElementById("keypad-settings")?.classList.add("hidden");
				document.getElementById("keypad-appearance")?.classList.add("hidden");
				document.getElementById("keypad-global-appearance")?.classList.add("hidden");
				document.getElementById("dial-settings")?.classList.remove("hidden");
			}

			async function initialize() {
				await customElements.whenDefined("sdpi-select");

				const settingSelect = document.getElementById("setting-select");

				if (settingSelect) {
					const initialValue = settingSelect.value || "differential-preload";
					updateVisibility(initialValue);

					const onChange = (ev) => updateVisibility(ev.target.value || "differential-preload");
					settingSelect.addEventListener("change", onChange);
					settingSelect.addEventListener("input", onChange);

					let lastValue = settingSelect.value || "differential-preload";
					window.irdPoll(() => {
						const currentValue = settingSelect.value;
						if (currentValue && currentValue !== lastValue) {
							lastValue = currentValue;
							updateVisibility(currentValue);
						}
					});
				}

				if ((await resolveController()) === "Encoder") {
					applyDialView();
				}
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initialize);
			} else {
				initialize();
			}
		</script>

		<style>
			.hidden { display: none !important; }
		</style>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
