<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<%
		var __allComms = require('./data/action-comms.json');
		var __comms = __allComms['audio-controls'];
		var __dialComms = __allComms['audio-controls-dial'];
		%>

		<!-- Keypad settings — hidden when this instance is a dial (#782). -->
		<div id="keypad-settings">
			<sdpi-item label="Mode">
				<sdpi-select id="category-select" setting="category" default="push-to-talk">
					<optgroup label="iRacing audio">
						<option value="push-to-talk">Push to Talk</option>
						<option value="voice-chat">Voice Chat</option>
						<option value="master">Master</option>
					</optgroup>
					<optgroup label="iRaceDeck audio">
						<option value="race-engineer">Race Engineer Volume</option>
						<option value="radar">Radar Volume</option>
					</optgroup>
				</sdpi-select>
			</sdpi-item>

			<ird-binding-status mode-setting="<%= __comms._meta.modeSetting %>" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

			<sdpi-item label="Action" id="action-item">
				<sdpi-select id="action-select" setting="action" default="volume-up">
					<option value="volume-up">Volume Up</option>
					<option value="volume-down">Volume Down</option>
					<option value="mute" id="mute-option">Mute</option>
					<option value="mute-driver">Mute a Driver</option>
				</sdpi-select>
			</sdpi-item>

			<div class="ird-supporting-text hidden" id="internal-volume-note">
				Adjusts iRaceDeck's own audio level.
			</div>
		</div>

		<!-- Dial settings — shown only when this instance is a dial (#782). -->
		<div id="dial-settings" class="hidden">
			<sdpi-item label="Mode">
				<sdpi-select id="dial-category-select" setting="dial.category" default="voice-chat">
					<optgroup label="iRacing audio">
						<option value="voice-chat">Voice Chat</option>
						<option value="master">Master</option>
						<option value="spotter">Spotter</option>
					</optgroup>
					<optgroup label="iRaceDeck audio">
						<option value="race-engineer">Race Engineer</option>
						<option value="radar">Radar</option>
					</optgroup>
				</sdpi-select>
			</sdpi-item>
			<div class="ird-supporting-text hidden" id="dial-internal-note">
				Adjusts iRaceDeck's own audio level — the touch display shows the live level.
			</div>
			<ird-binding-status mode-setting="dial.category" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>

			<sdpi-item label="Press Action">
				<sdpi-select id="dial-press-select" setting="dial.pressAction" default="none">
					<option value="push-to-talk">Push to Talk</option>
					<option value="mute-unmute" id="dial-mute-option">Mute / Unmute</option>
					<option value="mute-driver">Mute a Driver</option>
					<option value="skip-call">Skip Spotter Call</option>
					<option value="none">None</option>
				</sdpi-select>
			</sdpi-item>
			<div id="dial-press-status">
				<ird-binding-status mode-setting="dial.pressAction" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>
			</div>
		</div>

		<%- include('action-settings-footer') %>

		<!-- Key-icon appearance — keypad only (a dial has no key icon). -->
		<div id="keypad-appearance">
			<%- include('title-overrides') %>

			<%- include('color-overrides', { slots: ['backgroundColor', 'textColor', 'graphic1Color', 'graphic2Color'], defaults: require('./data/icon-defaults.json')['audio-controls'] }) %>
			<%- include('border-overrides', { defaults: require('./data/icon-defaults.json')['audio-controls'] }) %>
			<%- include('graphic-overrides') %>
			<%- include('common-settings') %>
		</div>

		<%
		var __kb = require('./data/key-bindings.json');
		// Some DIAL modes tap bindings owned by another action — the Spotter mode
		// (#809) uses the AI Spotter Controls louder / quieter / silence keys. Those
		// rows must exist here too, or the dial's binding-status line reads an
		// absent input and its "set it here" link has nowhere to land. Derive them
		// from the dial comms entry (rather than a hand-kept list) so the accordion
		// always covers exactly what the status line looks up, and take each row
		// from the shared catalog so its label stays owned by one place. They are
		// marked dial-only and hidden unless this instance IS a dial (see
		// applyDialView) - a keypad Audio Controls key can't use them.
		var __ownKeys = {};
		__kb.audioControls.forEach(function (row) { __ownKeys[row.setting] = true; });
		var __catalogRows = [];
		Object.keys(__kb).forEach(function (group) { __catalogRows = __catalogRows.concat(__kb[group]); });
		var __borrowedKeys = [];
		Object.keys(__dialComms).forEach(function (mode) {
			if (mode === '_meta') return;
			var ref = (__dialComms[mode] || {}).binding;
			if (!ref) return;
			var keys = ref.key ? [ref.key] : (ref.keys || []);
			if (ref.keyBy) {
				keys = keys.concat(Object.keys(ref.keyBy.map).map(function (k) { return ref.keyBy.map[k]; }));
			}
			keys.forEach(function (key) {
				if (!__ownKeys[key] && __borrowedKeys.indexOf(key) === -1) __borrowedKeys.push(key);
			});
		});
		var __borrowedRows = __borrowedKeys.map(function (key) {
			var row = __catalogRows.filter(function (b) { return b.setting === key; })[0];
			if (!row) throw new Error('audio-controls PI: no key-bindings.json row for dial binding ' + key);
			return Object.assign({}, row, { class: 'dial-only-binding hidden' });
		});
		%>
		<%- include('key-bindings-section', {
			keyBindings: __kb.audioControls.concat(__borrowedRows)
		}) %>

		<script>
			// Only Voice Chat supports mute — channel-wide Mute and Mute a Driver
			// (#863) alike. For every other category those options are removed from
			// the DOM (style.display is ignored by sdpi-select, which re-renders
			// options from the source list via a MutationObserver). The "iRaceDeck
			// audio" categories (Race Engineer / Radar) also show a supporting note.
			const MUTE_CATEGORIES = new Set(["voice-chat"]);
			const INTERNAL_VOLUME_CATEGORIES = new Set(["race-engineer", "radar"]);

			// An option a select offers only for some categories: `option` is the
			// element, `parent` is where it lives when attached, `categories` is the
			// set that may see it, and `following` is every option that originally
			// sat AFTER it. Populated in initialize() once sdpi-select exists.
			// Both surfaces run the same rule over their list (#863 generalised the
			// one-option pair into this shape rather than copying it).
			function conditionalOption(option, categories) {
				if (!option) return null;

				const parent = option.parentNode;
				const siblings = Array.from(parent.children);

				return { option, parent, categories, following: siblings.slice(siblings.indexOf(option) + 1) };
			}

			// Put a detached option back WHERE IT STARTED. A plain appendChild moved
			// the dial's Mute / Unmute past None the first time a Mode switch
			// detached it, and #863 adds a second such option.
			//
			// insertBefore alone does NOT fix it: sdpi-select renders from its
			// MutationObserver's `items` array (getItemsFromChildNodes reduces over
			// `this._mutationObserver.items`), and that array is append-ordered —
			// handleMutation does items.push() for an added node and items.splice()
			// for a removed one, never re-reading document order. It only matches
			// the document initially because the component is defined in <head> and
			// upgrades before its children are parsed.
			//
			// So the option order has to be rebuilt through the observer: detach
			// every option that originally followed this one, append this one, then
			// re-append those in their original order. All of it is synchronous, so
			// the whole sequence lands in ONE observer batch and costs one refresh.
			function reattachOption(entry) {
				const trailing = entry.following.filter((el) => el.parentNode === entry.parent);

				for (const el of trailing) el.remove();

				entry.parent.appendChild(entry.option);

				for (const el of trailing) entry.parent.appendChild(el);
			}

			// Attach or detach each conditional option for `category`. When the
			// select currently shows an option about to be detached, the selection is
			// switched to `fallback` FIRST — dispatching both input and change so
			// sdpi persists it — and only then is the option removed, so the setting
			// stored for THIS category can never name an option it does not offer.
			//
			// Deliberately not a whole-PI invariant: the keypad's push-to-talk branch
			// returns before calling this, which LEAVES `action` as it was. That is
			// what lets a user visit Push to Talk and come back to Voice Chat with
			// their Mute / Mute a Driver choice intact; resetting it there would
			// discard a choice the category change never asked about. The resulting
			// {push-to-talk, mute-driver} blob is inert — PTT ignores `action` — and
			// the next non-PTT category selection resolves it through this loop.
			function applyConditionalOptions(select, entries, category, fallback) {
				for (const entry of entries) {
					if (!entry) continue;

					if (!entry.categories.has(category)) {
						if (select && select.value === entry.option.value) {
							select.value = fallback;
							select.dispatchEvent(new Event("input", { bubbles: true }));
							select.dispatchEvent(new Event("change", { bubbles: true }));
						}
						// Attachment is read HERE, not before the dispatch: the select's
						// own change/input listener re-enters this function, so a flag
						// captured earlier is stale by the time we act on it.
						if (entry.option.parentNode === entry.parent) entry.option.remove();
					} else if (entry.option.parentNode !== entry.parent) {
						reattachOption(entry);
					}
				}
			}

			let keypadConditionalOptions = [];

			function updateVisibility(category) {
				const actionItem = document.getElementById("action-item");
				const actionSelect = document.getElementById("action-select");
				const internalNote = document.getElementById("internal-volume-note");

				if (internalNote) {
					internalNote.classList.toggle("hidden", !INTERNAL_VOLUME_CATEGORIES.has(category));
				}

				if (category === "push-to-talk") {
					// Hide the entire action dropdown for PTT
					if (actionItem) actionItem.classList.add("hidden");
					return;
				}

				if (actionItem) actionItem.classList.remove("hidden");

				// Master / Race Engineer / Radar have neither mute: both Voice-Chat-only
				// options fall back to volume-up.
				applyConditionalOptions(actionSelect, keypadConditionalOptions, category, "volume-up");
			}

			// ── Dial surface (#782) ─────────────────────────────────────────────

			// Which surface this instance sits on: the PI registration's
			// actionInfo.payload.controller ("Keypad" | "Encoder"; the Mirabox host
			// may report "Knob"). Anything unknown or unavailable falls back to the
			// keypad view (#759 pattern).
			async function resolveController() {
				try {
					const client = window.SDPIComponents && window.SDPIComponents.streamDeckClient;
					const info = client && (await client.getConnectionInfo());
					const controller = info && info.actionInfo && info.actionInfo.payload && info.actionInfo.payload.controller;
					return controller === "Encoder" || controller === "Knob" ? "Encoder" : "Keypad";
				} catch (err) {
					return "Keypad";
				}
			}

			function applyDialView() {
				document.getElementById("keypad-settings")?.classList.add("hidden");
				document.getElementById("keypad-appearance")?.classList.add("hidden");
				document.getElementById("dial-settings")?.classList.remove("hidden");
				// Bindings only a DIAL mode taps (the Spotter mode's spotter keys, #809)
				// ship hidden and appear here, so they show on exactly the surface that
				// can use them - on every host, whether or not it has a touch strip.
				document.querySelectorAll(".dial-only-binding").forEach(function (el) {
					el.classList.remove("hidden");
				});
			}

			// Which categories offer Mute / Unmute, derived from the same comms entry
			// the plugin generates from its dial tables: a category with a mute
			// binding (voice chat) plus the iRaceDeck-internal ones (they
			// flip a feature gate, so they mute with no binding at all). Master is
			// absent - iRacing has no master-mute keybind - and for it the option is
			// detached (same sdpi-select re-render caveat as the keypad mute option).
			// The press status line is hidden for internal-category Mute / Unmute:
			// that mute is plugin-internal, there is nothing to configure.
			const DIAL_MUTABLE_CATEGORIES = new Set(
				<%- JSON.stringify(
					Object.keys((__dialComms['mute-unmute'].binding.keyBy || {}).map || {})
						.concat(Object.keys(__dialComms).filter(function (mode) {
							return mode !== '_meta' && !__dialComms[mode].binding;
						}))
				) %>
			);
			// Which categories offer Mute a Driver (#863): only those with a
			// driver-mute binding in the dial tables (voice chat). Derived from the
			// generated entry for the same reason as DIAL_MUTABLE_CATEGORIES, and a
			// separate set because the two presses are offered for different Modes.
			// Its status line is never hidden - the driver mute is a real binding.
			const DIAL_MUTE_DRIVER_CATEGORIES = new Set(
				<%- JSON.stringify(Object.keys((__dialComms['mute-driver'].binding.keyBy || {}).map || {})) %>
			);
			// Which categories offer Skip Spotter Call (#1015): only those with a
			// skip-call binding in the dial tables (spotter). Derived the same way;
			// its status line is never hidden - Spotter Silence is a real binding.
			const DIAL_SKIP_CALL_CATEGORIES = new Set(
				<%- JSON.stringify(Object.keys((__dialComms['skip-call'].binding.keyBy || {}).map || {})) %>
			);
			let dialConditionalOptions = [];

			function updateDialVisibility() {
				const categorySelect = document.getElementById("dial-category-select");
				const pressSelect = document.getElementById("dial-press-select");
				const category = (categorySelect && categorySelect.value) || "voice-chat";
				const press = (pressSelect && pressSelect.value) || "none";
				const internalNote = document.getElementById("dial-internal-note");
				const pressStatus = document.getElementById("dial-press-status");

				if (internalNote) {
					internalNote.classList.toggle("hidden", !INTERNAL_VOLUME_CATEGORIES.has(category));
				}

				if (pressStatus) {
					const hideStatus = press === "mute-unmute" && INTERNAL_VOLUME_CATEGORIES.has(category);
					pressStatus.classList.toggle("hidden", hideStatus);
				}

				// A press the current Mode cannot fire falls back to None (blind-safe).
				applyConditionalOptions(pressSelect, dialConditionalOptions, category, "none");
			}

			async function initialize() {
				await customElements.whenDefined("sdpi-select");

				const categorySelect = document.getElementById("category-select");
				keypadConditionalOptions = [
					conditionalOption(document.querySelector('#action-select option[value="mute"]'), MUTE_CATEGORIES),
					conditionalOption(document.querySelector('#action-select option[value="mute-driver"]'), MUTE_CATEGORIES),
				];

				if (categorySelect) {
					const initialValue = categorySelect.value || "push-to-talk";
					updateVisibility(initialValue);

					categorySelect.addEventListener("change", (ev) => {
						updateVisibility(ev.target.value || "push-to-talk");
					});
					categorySelect.addEventListener("input", (ev) => {
						updateVisibility(ev.target.value || "push-to-talk");
					});

					// Polling fallback for reliable detection
					let lastValue = categorySelect.value || "push-to-talk";
					window.irdPoll(() => {
						const currentValue = categorySelect.value;
						if (currentValue && currentValue !== lastValue) {
							lastValue = currentValue;
							updateVisibility(currentValue);
						}
					});
				}

				// Dial section wiring — polling fallback covers both selects at once.
				dialConditionalOptions = [
					conditionalOption(
						document.querySelector('#dial-press-select option[value="mute-unmute"]'),
						DIAL_MUTABLE_CATEGORIES,
					),
					conditionalOption(
						document.querySelector('#dial-press-select option[value="mute-driver"]'),
						DIAL_MUTE_DRIVER_CATEGORIES,
					),
					conditionalOption(
						document.querySelector('#dial-press-select option[value="skip-call"]'),
						DIAL_SKIP_CALL_CATEGORIES,
					),
				];

				for (const id of ["dial-category-select", "dial-press-select"]) {
					const el = document.getElementById(id);
					if (!el) continue;
					el.addEventListener("change", updateDialVisibility);
					el.addEventListener("input", updateDialVisibility);
				}
				updateDialVisibility();
				window.irdPoll(updateDialVisibility);

				if ((await resolveController()) === "Encoder") {
					applyDialView();
				}
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initialize);
			} else {
				initialize();
			}
		</script>

		<style>
			.hidden { display: none !important; }
		</style>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
