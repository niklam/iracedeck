<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
	</head>
	<body>
		<%- include('section-header', { title: 'Action Settings' }) %>

		<% var __comms = require('./data/action-comms.json')['black-box-selector']; %>
		<% var __dialComms = require('./data/action-comms.json')['black-box-selector-dial']; %>

		<!-- Keypad settings — hidden when this instance is a dial (#808). -->
		<div id="keypad-settings">
			<sdpi-item label="Mode">
				<sdpi-select id="mode-select" setting="mode" default="direct">
					<option value="direct">Direct</option>
					<option value="next">Next</option>
					<option value="previous">Previous</option>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="<%= __comms._meta.modeSetting %>" comms='<%= JSON.stringify(__comms) %>'></ird-binding-status>

			<!-- Direct mode: black box selector -->
			<sdpi-item label="Black Box" id="blackbox-item">
				<sdpi-select id="blackbox-select" setting="blackBox" default="lap-timing">
					<option value="lap-timing">Lap Timing</option>
					<option value="standings">Standings</option>
					<option value="relative">Relative</option>
					<option value="fuel">Fuel</option>
					<option value="tires">Tires</option>
					<option value="tire-info">Tire Info</option>
					<option value="pit-stop">Pit-stop Adjustments</option>
					<option value="in-car">In-car Adjustments</option>
					<option value="mirror">Mirror Adjustments</option>
					<option value="radio">Radio Adjustments</option>
					<option value="weather">Weather</option>
				</sdpi-select>
			</sdpi-item>
		</div>

		<!-- Dial settings — shown only when this instance is a dial (#808). Rotation
		     always cycles next/previous; there is no rotation Setting to pick. -->
		<div id="dial-settings" class="hidden">
			<ird-binding-status mode-setting="<%= __dialComms._meta.modeSetting %>" default-mode="cycle" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>
			<div class="ird-supporting-text">
				Turn the dial to step through iRacing's black boxes — clockwise for the next
				box, counter-clockwise for the previous. Set the Cycle Next and Cycle Previous
				bindings below. iRacing reports no open-box state, so the touch strip shows the
				action's identity only.
			</div>

			<sdpi-item label="Box to Open">
				<sdpi-select setting="dial.pressBox" default="lap-timing">
					<option value="lap-timing">Lap Timing</option>
					<option value="standings">Standings</option>
					<option value="relative">Relative</option>
					<option value="fuel">Fuel</option>
					<option value="tires">Tires</option>
					<option value="tire-info">Tire Info</option>
					<option value="pit-stop">Pit-stop Adjustments</option>
					<option value="in-car">In-car Adjustments</option>
					<option value="mirror">Mirror Adjustments</option>
					<option value="radio">Radio Adjustments</option>
					<option value="weather">Weather</option>
				</sdpi-select>
			</sdpi-item>
			<div class="ird-supporting-text">
				Which box a press opens directly, when a gesture below is set to Open Selected
				Box. Like a Direct keypad button, opening a box toggles it — pressing again
				while it is already shown closes it.
			</div>

			<sdpi-item label="Press Action">
				<sdpi-select setting="dial.pressAction" default="none">
					<option value="none">None</option>
					<option value="open-selected-box">Open Selected Box</option>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="dial.pressAction" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>

			<sdpi-item label="Long Press">
				<sdpi-select setting="dial.longPressAction" default="none">
					<option value="none">None</option>
					<option value="open-selected-box">Open Selected Box</option>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="dial.longPressAction" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>

			<% if (locals.platform?.features?.dialFeedback !== false) { %>
			<sdpi-item label="Tap Display">
				<sdpi-select setting="dial.tapAction" default="none">
					<option value="none">None</option>
					<option value="open-selected-box">Open Selected Box</option>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="dial.tapAction" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>

			<sdpi-item label="Long Touch">
				<sdpi-select setting="dial.longTouchAction" default="none">
					<option value="none">None</option>
					<option value="open-selected-box">Open Selected Box</option>
				</sdpi-select>
			</sdpi-item>
			<ird-binding-status mode-setting="dial.longTouchAction" comms='<%= JSON.stringify(__dialComms) %>'></ird-binding-status>

			<%- include('dial-appearance') %>
			<% } %>
		</div>

		<!-- Key-icon appearance — keypad only (a dial has no key icon). -->
		<div id="keypad-appearance">
			<%- include('title-overrides') %>

			<%- include('color-overrides', { slots: ['backgroundColor', 'textColor', 'graphic1Color', 'graphic2Color'], defaults: require('./data/icon-defaults.json')['black-box-selector'] }) %>
			<%- include('border-overrides', { defaults: require('./data/icon-defaults.json')['black-box-selector'] }) %>
			<%- include('graphic-overrides') %>
			<%- include('common-settings') %>
		</div>

		<%- include('section-header', { title: 'Global Settings' }) %>

		<%- include('global-key-bindings', {
			keyBindings: require('./data/key-bindings.json').blackBox
		}) %>

		<div id="keypad-global-appearance">
			<%- include('global-title-defaults') %>
			<%- include('global-color-defaults') %>
			<%- include('global-border-defaults') %>
			<%- include('global-graphic-defaults') %>
			<%- include('global-flag-flash') %>
		</div>

		<%- include('global-common-settings') %>

		<script>
			function updateVisibility(mode) {
				const blackboxItem = document.getElementById("blackbox-item");
				if (!blackboxItem) return;

				// Show black box selector only in Direct mode
				blackboxItem.classList.toggle("hidden", mode !== "direct");
			}

			// Which surface this instance sits on: the PI registration's
			// actionInfo.payload.controller ("Keypad" | "Encoder"; the Mirabox host
			// may report "Knob"). Anything unknown or unavailable falls back to the
			// keypad view (#808).
			async function resolveController() {
				try {
					const client = window.SDPIComponents && window.SDPIComponents.streamDeckClient;
					const info = client && (await client.getConnectionInfo());
					const controller = info && info.actionInfo && info.actionInfo.payload && info.actionInfo.payload.controller;
					return controller === "Encoder" || controller === "Knob" ? "Encoder" : "Keypad";
				} catch (err) {
					return "Keypad";
				}
			}

			function applyDialView() {
				document.getElementById("keypad-settings")?.classList.add("hidden");
				document.getElementById("keypad-appearance")?.classList.add("hidden");
				document.getElementById("keypad-global-appearance")?.classList.add("hidden");
				document.getElementById("dial-settings")?.classList.remove("hidden");
			}

			// Wait for web components to be defined
			async function initialize() {
				await customElements.whenDefined("sdpi-select");

				const modeSelect = document.getElementById("mode-select");

				if (modeSelect) {
					// Get initial value and update visibility
					const initialMode = modeSelect.value || "direct";
					updateVisibility(initialMode);

					const onChange = (ev) => updateVisibility(ev.target.value || "direct");
					modeSelect.addEventListener("change", onChange);
					modeSelect.addEventListener("input", onChange);

					let lastMode = modeSelect.value || "direct";
					window.irdPoll(() => {
						const currentMode = modeSelect.value;
						if (currentMode && currentMode !== lastMode) {
							lastMode = currentMode;
							updateVisibility(currentMode);
						}
					});
				}

				if ((await resolveController()) === "Encoder") {
					applyDialView();
				}
			}

			// Initialize when DOM is ready
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initialize);
			} else {
				initialize();
			}
		</script>

		<style>
			.hidden { display: none !important; }
		</style>

		<%- include('docs-link') %>

		<%- include('version') %>
	</body>
</html>
