<!doctype html>
<html lang="en">
	<head>
		<%- include('head-common') %>
		<title>iRaceDeck Settings</title>
		<%#
		  The dedicated settings window (issue #992). Served by the plugin process
		  over loopback and opened as a chromeless browser app window; NOT a
		  Property Inspector, though it reuses the PI framework verbatim. The plugin
		  injects settings-window-bridge.js before sdpi-components.js at build time
		  (same mechanism as the Ulanzi PI bridge), which redirects sdpi's socket to
		  the plugin's fake host and drives connectElgatoStreamDeckSocket.

		  Every control here is `global`, so only the global-settings subset of the
		  PI protocol is ever exercised. The REAL global-*.ejs partials and ird-*
		  components render inside this shell — a header, a sidebar, and one pane
		  per section — with two deliberate differences from the action PIs:
		    - ALL key-binding categories in one searchable table, not one action's
		      subset in an accordion. Every row hosts a real ird-key-binding, so
		      each cell saves exactly as it does in a PI.
		    - No Stream Deck Profiles accordion: switchToProfile targets the device
		      whose PI is open, and this window has no device.
		  Passing `settingsWindow: true` at each top-level include makes accordion.ejs
		  render flat cards (inherited by nested includes — see accordion.ejs).
		%>
		<style>
			:root {
				--sw-bg: #2d2d2d; --sw-bg-alt: #262626; --sw-bg-nav: #232323; --sw-panel: #333333;
				--sw-fg: #ffffff; --sw-fg-dim: #c8c8c8; --sw-fg-mute: #808080;
				--sw-line: #3a3a3a; --sw-accent: #4a90d9;
				--sw-font: "Segoe UI", Arial, Roboto, Helvetica, sans-serif;
			}
			html, body { height: 100%; margin: 0; }
			body {
				background: var(--sw-bg); color: var(--sw-fg);
				font-family: var(--sw-font); font-size: 9pt;
				display: grid; grid-template-rows: auto 1fr; overflow: hidden;
			}
			.sw-header {
				display: flex; align-items: center; gap: 12px;
				padding: 12px 20px; border-bottom: 1px solid var(--sw-line); background: var(--sw-bg-alt);
			}
			.sw-mark {
				width: 26px; height: 26px; border-radius: 5px; flex: none;
				background: linear-gradient(135deg, #4a90d9, #2c5f96);
				display: grid; place-items: center; font-weight: 700; font-size: 11px;
			}
			.sw-header h1 { font-size: 12pt; font-weight: 600; margin: 0; letter-spacing: .2px; }
			.sw-version { color: var(--sw-fg-mute); font-size: 8pt; margin-left: auto; }
			.sw-main { display: grid; grid-template-columns: 200px 1fr; min-height: 0; }
			.sw-nav {
				background: var(--sw-bg-nav); border-right: 1px solid var(--sw-line);
				padding: 12px 8px; display: flex; flex-direction: column; gap: 2px; overflow-y: auto;
			}
			.sw-nav-item {
				display: flex; align-items: center; width: 100%; text-align: left;
				background: none; border: 0; color: var(--sw-fg-dim); font: inherit;
				padding: 8px 12px; border-radius: 5px; cursor: pointer;
			}
			.sw-nav-item:hover { background: #2e2e2e; color: var(--sw-fg); }
			.sw-nav-item.active { background: var(--sw-accent); color: #fff; }
			.sw-badge {
				margin-left: auto; background: rgba(255,255,255,.14);
				border-radius: 9px; padding: 1px 7px; font-size: 7.5pt;
			}
			.sw-pane { padding: 18px 24px 32px; overflow-y: auto; min-height: 0; }
			.sw-pane[hidden] { display: none; }
			.sw-pane h2 {
				font-size: 10pt; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; margin: 0 0 4px;
			}
			.sw-sub { color: var(--sw-fg-mute); margin: 0 0 14px; }
			.sw-toolbar { display: flex; gap: 8px; margin-bottom: 10px; }
			.sw-toolbar input, .sw-toolbar select {
				background: var(--sw-panel); border: 1px solid var(--sw-line); color: var(--sw-fg);
				font: inherit; padding: 6px 10px; border-radius: 4px;
			}
			.sw-toolbar input { flex: 1; }
			.sw-table { width: 100%; border-collapse: collapse; }
			.sw-table thead th {
				position: sticky; top: 0; z-index: 1; background: var(--sw-bg);
				text-align: left; font-size: 8pt; text-transform: uppercase; letter-spacing: .4px;
				color: var(--sw-fg-mute); font-weight: 600; padding: 6px 10px; border-bottom: 1px solid var(--sw-line);
			}
			.sw-table tbody td { padding: 4px 10px; border-bottom: 1px solid #303030; vertical-align: middle; }
			.sw-table tbody tr:hover { background: #313131; }
			.sw-table td.cat { color: var(--sw-fg-mute); width: 200px; white-space: nowrap; }
			.sw-table td.act { width: 220px; }
			.sw-table td.bind ird-key-binding { display: block; max-width: 420px; }
			.sw-table tr[hidden] { display: none; }
			.sw-empty { color: var(--sw-fg-mute); padding: 18px 10px; }
			.sw-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 24px; align-items: start; }
			.sw-grid.single { grid-template-columns: minmax(0, 1fr); }
			/* accordion.ejs in settingsWindow mode renders these */
			.ird-sw-card { background: var(--sw-bg-alt); border: 1px solid var(--sw-line); border-radius: 6px; padding: 12px 16px 6px; }
			.ird-sw-card-title {
				font-family: var(--sw-font); font-size: 9pt; text-transform: uppercase; letter-spacing: .4px;
				color: var(--sw-fg-dim); margin: 0 0 8px; font-weight: 600;
			}
			/* Inside a card the PI's per-item label column can be a little wider */
			.ird-sw-card sdpi-item { --sdpi-item-label-width: 110px; }
		</style>
	</head>
	<body>
		<header class="sw-header">
			<div class="sw-mark">iR</div>
			<h1>iRaceDeck Settings</h1>
			<span class="sw-version">v<%= version %></span>
		</header>

		<main class="sw-main">
			<%
			  var __allBindings = require('./data/key-bindings.json');
			  var __categories = Object.keys(__allBindings);
			  var __total = __categories.reduce(function (n, c) { return n + __allBindings[c].length; }, 0);
			  var __labels = {
			    blackBox: 'Black Box', splitsDelta: 'Splits & Delta', toggleUi: 'Toggle UI',
			    lookDirection: 'Look Direction', carControl: 'Car Control',
			    cameraControls: 'Camera Controls', cameraEditorControls: 'Camera Editor Controls',
			    cameraEditorAdjustments: 'Camera Editor Adjustments', setupChassis: 'Setup — Chassis',
			    setupBrakes: 'Setup — Brakes', replayNavigation: 'Replay Navigation',
			    audioControls: 'Audio Controls'
			  };
			  var __label = function (k) {
			    return __labels[k] || k.replace(/([A-Z])/g, ' $1').replace(/^./, function (c) { return c.toUpperCase(); });
			  };
			%>
			<nav class="sw-nav" aria-label="Settings sections">
				<button class="sw-nav-item active" data-pane="bindings" type="button">Key Bindings<span class="sw-badge"><%= __total %></span></button>
				<button class="sw-nav-item" data-pane="appearance" type="button">Appearance</button>
				<button class="sw-nav-item" data-pane="general" type="button">General</button>
			</nav>

			<%# ---- Key Bindings: one searchable table, every row a real ird-key-binding ---- %>
			<section class="sw-pane" id="pane-bindings">
				<h2>Key Bindings</h2>
				<p class="sw-sub">All <%= __total %> bindings across <%= __categories.length %> categories. Each row saves as you change it, exactly like the Property Inspector.</p>
				<%#
				  Page-local filter UI, not settings — so plain form controls rather than
				  sdpi-* (which bind to a setting). The window is not a Property Inspector.
				%>
				<div class="sw-toolbar">
					<input type="search" id="sw-q" placeholder="Search bindings…" aria-label="Search bindings" autocomplete="off" />
					<select id="sw-cat" aria-label="Filter by category">
						<option value="">All categories</option>
						<% __categories.forEach(function (c) { %><option value="<%= c %>"><%= __label(c) %></option><% }); %>
					</select>
				</div>
				<table class="sw-table">
					<thead><tr><th>Category</th><th>Action</th><th>Binding</th></tr></thead>
					<tbody id="sw-rows">
					<% __categories.forEach(function (c) { __allBindings[c].forEach(function (b) { %>
						<tr data-cat="<%= c %>" data-text="<%= (__label(c) + ' ' + b.label).toLowerCase() %>">
							<td class="cat"><%= __label(c) %></td>
							<td class="act"><%= b.label %></td>
							<td class="bind"><ird-key-binding setting="<%= b.setting %>" default="<%= b.default %>" global></ird-key-binding></td>
						</tr>
					<% }); }); %>
					</tbody>
				</table>
				<div class="sw-empty" id="sw-empty" hidden>No bindings match.</div>
			</section>

			<%# ---- Appearance: the real global-* partials, rendered as flat cards ---- %>
			<section class="sw-pane" id="pane-appearance" hidden>
				<h2>Appearance</h2>
				<p class="sw-sub">Plugin-wide defaults. Any key can still override these individually in its Property Inspector.</p>
				<div class="sw-grid">
					<%- include('global-title-defaults', { settingsWindow: true }) %>
					<%- include('global-color-defaults', { settingsWindow: true }) %>
					<%- include('global-border-defaults', { settingsWindow: true }) %>
					<%- include('global-graphic-defaults', { settingsWindow: true }) %>
					<%- include('global-flag-flash', { settingsWindow: true }) %>
				</div>
			</section>

			<%# ---- General: the common settings partial (window focus, SimHub, dual-press, replay, chat, updates, diagnostics) ---- %>
			<section class="sw-pane" id="pane-general" hidden>
				<h2>General</h2>
				<p class="sw-sub">Behaviour that applies to every key.</p>
				<div class="sw-grid single">
					<%- include('global-common-settings', { settingsWindow: true }) %>
				</div>
			</section>
		</main>

		<script>
			(function () {
				var panes = Array.prototype.slice.call(document.querySelectorAll(".sw-pane"));
				var items = Array.prototype.slice.call(document.querySelectorAll(".sw-nav-item"));
				items.forEach(function (btn) {
					btn.addEventListener("click", function () {
						items.forEach(function (b) { b.classList.remove("active"); });
						btn.classList.add("active");
						panes.forEach(function (p) { p.hidden = p.id !== "pane-" + btn.dataset.pane; });
					});
				});
				var q = document.getElementById("sw-q"), cat = document.getElementById("sw-cat");
				var rows = Array.prototype.slice.call(document.querySelectorAll("#sw-rows tr"));
				var empty = document.getElementById("sw-empty");
				function filter() {
					var term = q.value.trim().toLowerCase(), c = cat.value, shown = 0;
					rows.forEach(function (tr) {
						var ok = (!c || tr.dataset.cat === c) && (!term || tr.dataset.text.indexOf(term) !== -1);
						tr.hidden = !ok;
						if (ok) shown++;
					});
					empty.hidden = shown !== 0;
				}
				q.addEventListener("input", filter);
				cat.addEventListener("change", filter);
			})();
		</script>
	</body>
</html>
