{
  "name": "@iracedeck/settings",
  "version": "3.6.0-dev.0",
  "description": "The plugin's global settings: the schema and cache, the one-shot migrations, the plugin-owned settings store, run-scoped keys, PI warnings, the first-run check and the per-feature startup gates. Sits below the deck layer and reaches the host only through SettingsHost.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "dependencies": {
    "@iracedeck/app-constants": "workspace:*",
    "@iracedeck/callout-script": "workspace:*",
    "@iracedeck/callout-settings": "workspace:*",
    "@iracedeck/logger": "workspace:*",
    "semver": "7.8.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.4",
    "@types/semver": "7.8.0",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
