<%#
  Race Engineer per-callout opt-ins (issue #992 split). Authored inline in
  pit-crew.ejs until the settings window needed them too. Emits items only —
  pit-crew.ejs wraps them in its "Race Engineer Callouts" accordion, the
  window in a card. The per-family { setting, label } lists below are the
  ONLY place the callout ids are authored for the PI/window (they mirror the
  `calloutEnabled*` schema fields and the audio-scenarios setting-key maps —
  add a new callout in all of them); both surfaces include this one partial,
  so they cannot drift from each other. See .claude/rules/global-settings.md
  (per-callout opt-in convention).
%>
		<%
// Source-of-truth list for the Race Engineer flag callouts.
// Add a new entry here and the 2-column grid below auto-rebalances
// (rows = ceil(N / 2), grid-auto-flow: column → fills column 1 top
// to bottom, then column 2). Stays at exactly two columns no matter
// how the list grows.
var flagCallouts = [
	{ setting: "calloutEnabledFlagYellowLocal",   label: "Yellow (local)" },
	{ setting: "calloutEnabledFlagYellowFull",    label: "Yellow (full course)" },
	{ setting: "calloutEnabledFlagYellowCleared", label: "Yellow cleared" },
	{ setting: "calloutEnabledFlagGreen",         label: "Green" },
	{ setting: "calloutEnabledFlagBlue",          label: "Blue" },
	{ setting: "calloutEnabledFlagWhite",         label: "White" },
	{ setting: "calloutEnabledFlagRed",           label: "Red" },
	{ setting: "calloutEnabledFlagBlack",         label: "Black" },
	{ setting: "calloutEnabledFlagCheckered",     label: "Checkered" },
	{ setting: "calloutEnabledFlagDebris",        label: "Debris" },
	{ setting: "calloutEnabledFlagMeatball",      label: "Meatball" },
	{ setting: "calloutEnabledFlagYellowWaving",  label: "Yellow waving" },
	{ setting: "calloutEnabledFlagCautionWaving", label: "Caution waving" },
	{ setting: "calloutEnabledFlagCrossed",       label: "Crossed flags" },
	{ setting: "calloutEnabledFlagOnePaceLapToGo", label: "One pace lap to go" },
	{ setting: "calloutEnabledFlagGreenHeld",     label: "Green held" },
	{ setting: "calloutEnabledFlagTenToGo",       label: "Ten to go" },
	{ setting: "calloutEnabledFlagFiveToGo",      label: "Five to go" },
	{ setting: "calloutEnabledFlagDisqualify",    label: "Disqualified" },
	{ setting: "calloutEnabledFlagFurled",        label: "Black flag furled" },
	{ setting: "calloutEnabledFlagFurledCleared", label: "Furled cleared" },
	{ setting: "calloutEnabledFlagDqScoringInvalid", label: "DQ (scoring)" },
];
var flagCalloutRowCount = Math.ceil(flagCallouts.length / 2);
var flagCalloutCheckboxes = flagCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Start-light callouts (issue #480). Two grouped opt-ins: "Lights & go"
// covers the standing-start gantry lines (ready / red / go); "Countdown"
// covers the numeric pre-start countdown (60/30/15/10/5). Same
// 2-column auto-balancing grid as the families above.
var startLightCallouts = [
	{ setting: "calloutEnabledStartLights",    label: "Lights & go" },
	{ setting: "calloutEnabledStartCountdown", label: "Countdown" },
];
var startLightRowCount = Math.ceil(startLightCallouts.length / 2);
var startLightCheckboxes = startLightCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Rolling-start callout (issue #660). Single subject — the engineer
// calls out once when the pace car starts moving and the field begins
// to roll into the formation lap. Distinct from "one pace lap to go",
// which fires near the END of the formation lap. Same 2-column
// auto-balancing grid as the families above.
var rollingStartCallouts = [
	{ setting: "calloutEnabledRollingStartPaceCar", label: "Pace car moving" },
];
var rollingStartRowCount = Math.ceil(rollingStartCallouts.length / 2);
var rollingStartCheckboxes = rollingStartCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Pit-window callout (issue #655). Single subject — one toggle covers
// both "pits are open" and "pits are closed". Distinct from the
// pit-service-status family; this is the strategic open/closed cue
// during a caution. Same 2-column auto-balancing grid as above.
var pitWindowCallouts = [
	{ setting: "calloutEnabledPitOpenClosed", label: "Pit open/closed" },
];
var pitWindowRowCount = Math.ceil(pitWindowCallouts.length / 2);
var pitWindowCheckboxes = pitWindowCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Pit-limiter callouts (issue #1051) — cars that HAVE a pit limiter. Gated on
// `hasPitLimiter` per #639, so every line here may name the limiter.
var pitLimiterCallouts = [
	{ setting: "calloutEnabledLimiterMissing",  label: "Limiter off on pit road" },
	{ setting: "calloutEnabledLimiterDropped",  label: "Limiter dropped" },
	{ setting: "calloutEnabledLimiterSpeeding", label: "Speeding (limiter car)" },
	{ setting: "calloutEnabledLimiterOnTrack",  label: "Limiter still on after pit exit" },
];
var pitLimiterRowCount = Math.ceil(pitLimiterCallouts.length / 2);
var pitLimiterCheckboxes = pitLimiterCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// No-limiter callouts (issue #1051) — the mirror family, for cars with NO
// limiter, so none of its lines mentions one. Separate from the family above
// because the two differ by remedy: a limiter car presses the button, a car
// without one has to lift.
var noLimiterCallouts = [
	{ setting: "calloutEnabledNoLimiterSpeeding", label: "Speeding (no limiter)" },
	{ setting: "calloutEnabledNoLimiterEntry",    label: "Pit entry speed reminder" },
];
var noLimiterRowCount = Math.ceil(noLimiterCallouts.length / 2);
var noLimiterCheckboxes = noLimiterCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Opponent-pit callouts (issue #622). Two subjects — the leader
// entering the pits, and nearby (±2 positions, same lap) competitors
// incl. the aggregate "other cars pitting" tail. Same 2-column
// auto-balancing grid as above.
var opponentPitCallouts = [
	{ setting: "calloutEnabledOpponentPitLeader", label: "Leader pitting" },
	{ setting: "calloutEnabledOpponentPitNearby", label: "Nearby competitor pitting" },
];
var opponentPitRowCount = Math.ceil(opponentPitCallouts.length / 2);
var opponentPitCheckboxes = opponentPitCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Opponent-flag callouts (issue #936). Four subjects — penalty flags
// on cars near us. Same 2-column auto-balancing grid as above.
var opponentFlagCallouts = [
	{ setting: "calloutEnabledOpponentFlagFurled", label: "Furled black flag (warning)" },
	{ setting: "calloutEnabledOpponentFlagBlack", label: "Black flag" },
	{ setting: "calloutEnabledOpponentFlagMeatball", label: "Meatball (repairs)" },
	{ setting: "calloutEnabledOpponentFlagDisqualify", label: "Disqualified" },
];
var opponentFlagRowCount = Math.ceil(opponentFlagCallouts.length / 2);
var opponentFlagCheckboxes = opponentFlagCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Pit-service callouts (readback entry/exit from issue #476, plus
// the family-wide pit-service-requests toggle from issue #468).
// Same source-of-truth 2-column grid as flag callouts — adding a
// row here is the only place to extend.
var pitServiceCallouts = [
	{ setting: "calloutEnabledPitReadbackEntry",   label: "Pit entry readback" },
	{ setting: "calloutEnabledPitReadbackExit",    label: "Pit exit readback" },
	{ setting: "calloutEnabledPitServiceRequests", label: "Pit service requests" },
];
var pitServiceRowCount = Math.ceil(pitServiceCallouts.length / 2);
var pitServiceCheckboxes = pitServiceCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Damage callouts (issue #489). One subject today; the same
// 2-column auto-balancing grid scales when more land later.
var damageCallouts = [
	{ setting: "calloutEnabledDamageRepairNeeded", label: "Repair needed" },
];
var damageRowCount = Math.ceil(damageCallouts.length / 2);
var damageCheckboxes = damageCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Pit-service status callouts (issue #479). One subject per non-None
// PlayerCarPitSvStatus value (the silent idle state has no opt-out
// because it never reaches the bus). Same 2-column auto-balancing
// grid as the families above.
var pitStatusCallouts = [
	{ setting: "calloutEnabledPitStatusInProgress",    label: "In progress" },
	{ setting: "calloutEnabledPitStatusComplete",       label: "Complete" },
	{ setting: "calloutEnabledPitStatusTooFarLeft",    label: "Too far left" },
	{ setting: "calloutEnabledPitStatusTooFarRight",   label: "Too far right" },
	{ setting: "calloutEnabledPitStatusTooFarForward", label: "Too far forward" },
	{ setting: "calloutEnabledPitStatusTooFarBack",    label: "Too far back" },
	{ setting: "calloutEnabledPitStatusBadAngle",       label: "Bad angle" },
	{ setting: "calloutEnabledPitStatusCantFixThat",   label: "Can't fix that" },
];
var pitStatusRowCount = Math.ceil(pitStatusCallouts.length / 2);
var pitStatusCheckboxes = pitStatusCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Track-conditions callouts (issue #526). Single subject for v1
// (`Wetness`); future track-related callouts will append cleanly
// under the same family.
var trackConditionsCallouts = [
	{ setting: "calloutEnabledTrackWetness", label: "Wetness changes" },
];
var trackConditionsRowCount = Math.ceil(trackConditionsCallouts.length / 2);
var trackConditionsCheckboxes = trackConditionsCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Per-incident-type callouts (issue #530). One subject per
// IncidentFlags report category surfaced by the bus. Every category
// defaults on so a fresh install gets full feedback; users can
// silence individual categories from the PI.
var incidentCallouts = [
	{ setting: "calloutEnabledIncidentOffTrack",       label: "Off track" },
	{ setting: "calloutEnabledIncidentOutOfControl",   label: "Out of control" },
	{ setting: "calloutEnabledIncidentContactWorld",   label: "Contact (wall)" },
	{ setting: "calloutEnabledIncidentCollisionWorld", label: "Collision (wall)" },
	{ setting: "calloutEnabledIncidentContactCar",     label: "Contact (car)" },
	{ setting: "calloutEnabledIncidentCollisionCar",   label: "Collision (car)" },
];
var incidentRowCount = Math.ceil(incidentCallouts.length / 2);
var incidentCheckboxes = incidentCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Session-start readout (issues #542, #668). Single subject —
// one toggle for the whole greeting + conditions brief fired when a
// practice or qualifying session starts (on session.changed, ~3 s in),
// whether or not the driver leaves the garage.
var sessionStartCallouts = [
	{ setting: "calloutEnabledSessionStart", label: "Session start conditions" },
];
var sessionStartRowCount = Math.ceil(sessionStartCallouts.length / 2);
var sessionStartCheckboxes = sessionStartCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Race Engineer toggle acknowledgment (issue #554). UI-side ack —
// not a sim-event-driven callout. Single subject covers both the
// "going silent" line on disable and "resuming communication" on
// enable.
var toggleAckCallouts = [
	{ setting: "calloutEnabledToggleRaceEngineer", label: "Toggle on/off acknowledgment" },
];
var toggleAckRowCount = Math.ceil(toggleAckCallouts.length / 2);
var toggleAckCheckboxes = toggleAckCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Telemetry-connect radio check (issue #554 follow-up). Single subject
// — the "<name>, radio check. Standing by." line the engineer fires
// when iRacing telemetry first connects.
var telemetryConnectCallouts = [
	{ setting: "calloutEnabledTelemetryConnectRadioCheck", label: "Confirm Race Engineer on telemetry connect" },
];
var telemetryConnectRowCount = Math.ceil(telemetryConnectCallouts.length / 2);
var telemetryConnectCheckboxes = telemetryConnectCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Lap-time best-lap callout (issue #555). Single subject — engineer
// announces the lap time when the driver sets a new personal best (or
// completes the first valid lap of the session).
var lapTimeCallouts = [
	{ setting: "calloutEnabledLapTimeBestLap", label: "New best lap" },
];
var lapTimeRowCount = Math.ceil(lapTimeCallouts.length / 2);
var lapTimeCheckboxes = lapTimeCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Corner-name callouts (issue #888). Single subject — engineer
// announces the upcoming corner's name in practice/test sessions.
var cornerNameCallouts = [
	{ setting: "calloutEnabledCornerNames", label: "Corner names (practice/test)" },
	{ setting: "calloutEnabledToggleCornerNames", label: "Toggle on/off acknowledgment" },
];
var cornerNameRowCount = Math.ceil(cornerNameCallouts.length / 2);
var cornerNameCheckboxes = cornerNameCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Position-change callout (issue #566). Single subject — engineer
// announces the driver's current position after each lap when it
// changed since the previous lap. Fires in race + qualifying only.
var positionCallouts = [
	{ setting: "calloutEnabledPositionChange", label: "Position changed" },
];
var positionRowCount = Math.ceil(positionCallouts.length / 2);
var positionCheckboxes = positionCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Qualifying lap-invalidation callout (issue #567). Single subject —
// engineer announces "This lap will be invalidated." plus a per-N tail
// when an incident occurs during a qualifying lap. Fires in qualifying
// only; race / practice stay silent.
var qualifyingInvalidationCallouts = [
	{ setting: "calloutEnabledQualifyingLapInvalidated", label: "Lap invalidated" },
];
var qualifyingInvalidationRowCount = Math.ceil(qualifyingInvalidationCallouts.length / 2);
var qualifyingInvalidationCheckboxes = qualifyingInvalidationCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Race-specific callouts (issues #568 + #569). Race-start fires the
// grid-position greeting ~3 s after the session changes to a race
// (replaces session-start in race sessions); race-status fires the
// every-3-laps position update during races; race-end fires the
// final-result callout once when the driver crosses S/F under
// the checkered flag.
var raceCallouts = [
	{ setting: "calloutEnabledRaceStart",  label: "Race start" },
	{ setting: "calloutEnabledRaceStatus", label: "Position status (every 3 laps)" },
	{ setting: "calloutEnabledRaceEnd",    label: "Final result" },
];
var raceRowCount = Math.ceil(raceCallouts.length / 2);
var raceCheckboxes = raceCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Overtake callouts (issue #574). Two subjects — gained / lost —
// independently toggleable so a driver who wants the
// congratulations but not the chastisement (or vice versa) gets
// per-direction control.
var overtakeCallouts = [
	{ setting: "calloutEnabledOvertakeGained", label: "Gained position" },
	{ setting: "calloutEnabledOvertakeLost",   label: "Lost position" },
];
var overtakeRowCount = Math.ceil(overtakeCallouts.length / 2);
var overtakeCheckboxes = overtakeCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Gap callouts (issue #933). Two subjects — the sustained trend flip
// ("we're gaining on the car ahead") and the threshold crossing
// ("we've caught the car ahead") — independently toggleable.
var gapCallouts = [
	{ setting: "calloutEnabledGapTrend",     label: "Gap trend (gaining/losing)" },
	{ setting: "calloutEnabledGapThreshold", label: "Gap under threshold" },
];
var gapRowCount = Math.ceil(gapCallouts.length / 2);
var gapCheckboxes = gapCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Spotter callouts (issue #651). Two subjects — the per-lap "cars
// around you" announcement and the "still there" reminder repeated
// while alongside — independently toggleable. Same 2-column
// auto-balancing grid as the families above.
var spotterCallouts = [
	{ setting: "calloutEnabledSpotterCars",       label: "Announce cars around you" },
	{ setting: "calloutEnabledSpotterStillThere", label: "Repeat reminder while alongside" },
];
var spotterRowCount = Math.ceil(spotterCallouts.length / 2);
var spotterCheckboxes = spotterCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Pit-box count-in (issue #600). Single subject — one toggle for the
// whole five → pit-now distance countdown to the pit box.
var pitBoxCallouts = [
	{ setting: "calloutEnabledPitBoxCountIn", label: "Count-in to pit box" },
];
var pitBoxRowCount = Math.ceil(pitBoxCallouts.length / 2);
var pitBoxCheckboxes = pitBoxCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Pit-road speeding cue (issue #912). Single subject — a repeating tick
// while the car is over the pit-lane speed limit, not a spoken line.
var pitSpeedingCallouts = [
	{ setting: "calloutEnabledPitSpeedingCue", label: "Pit road speeding" },
];
var pitSpeedingRowCount = Math.ceil(pitSpeedingCallouts.length / 2);
var pitSpeedingCheckboxes = pitSpeedingCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Laps-of-fuel-left callouts (issue #838). One checkbox per spoken
// count 10 → 1 plus the count-0 "Box this lap" call. Defaults are NOT
// uniform (5, 3, 2, 1 and Box ship ON, the rest OFF — the Discord-
// request baseline), so each item carries its own `on` flag. An OFF
// default must OMIT the `default` attribute entirely — `default="false"`
// renders CHECKED (the truthy-attribute sdpi-checkbox trap).
var fuelCallouts = [
	{ setting: "calloutEnabledFuelLapsLeft10",  label: "10 laps of fuel left", on: false },
	{ setting: "calloutEnabledFuelLapsLeft9",   label: "9 laps of fuel left",  on: false },
	{ setting: "calloutEnabledFuelLapsLeft8",   label: "8 laps of fuel left",  on: false },
	{ setting: "calloutEnabledFuelLapsLeft7",   label: "7 laps of fuel left",  on: false },
	{ setting: "calloutEnabledFuelLapsLeft6",   label: "6 laps of fuel left",  on: false },
	{ setting: "calloutEnabledFuelLapsLeft5",   label: "5 laps of fuel left",  on: true },
	{ setting: "calloutEnabledFuelLapsLeft4",   label: "4 laps of fuel left",  on: false },
	{ setting: "calloutEnabledFuelLapsLeft3",   label: "3 laps of fuel left",  on: true },
	{ setting: "calloutEnabledFuelLapsLeft2",   label: "2 laps of fuel left",  on: true },
	{ setting: "calloutEnabledFuelLapsLeft1",   label: "1 lap of fuel left",   on: true },
	{ setting: "calloutEnabledFuelLapsLeftBox", label: "Box this lap",         on: true },
	{ setting: "calloutEnabledFuelLapsLeftRaceCovered", label: "Enough fuel to finish", on: true },
];
var fuelRowCount = Math.ceil(fuelCallouts.length / 2);
var fuelCheckboxes = fuelCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global' + (c.on ? ' default="true"' : '') + '></sdpi-checkbox>';
}).join('');

// Setup-name mismatch warning (issue #625). Single subject — one toggle
// covers both the qualifying and race warnings. The editable patterns
// that drive it live in their own accordion below.
var setupWarningCallouts = [
	{ setting: "calloutEnabledSetupWarning", label: "Setup looks wrong for session" },
];
var setupWarningRowCount = Math.ceil(setupWarningCallouts.length / 2);
var setupWarningCheckboxes = setupWarningCallouts.map(function (c) {
	return '<sdpi-checkbox setting="' + c.setting + '" label="' + c.label + '" global default="true"></sdpi-checkbox>';
}).join('');

// Reset-button style — mirrors the Title Defaults reset
// (global-title-defaults.ejs) so the setup-warning pattern resets look
// consistent with the rest of the PI.
		%>
<%- (
'<sdpi-item label="Flags">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + flagCalloutRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		flagCalloutCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Start Lights">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + startLightRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		startLightCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Rolling Start">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + rollingStartRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		rollingStartCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Pit Window">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + pitWindowRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		pitWindowCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Pit Limiter">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + pitLimiterRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		pitLimiterCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="No Pit Limiter">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + noLimiterRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		noLimiterCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Opponent Pits">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + opponentPitRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		opponentPitCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Opponent Flags">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + opponentFlagRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		opponentFlagCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Pit Service">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + pitServiceRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		pitServiceCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Pit Service Status">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + pitStatusRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		pitStatusCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Damage">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + damageRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		damageCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Track Conditions">' +
  	'<div style="display:grid;grid-template-rows:repeat(' + trackConditionsRowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		trackConditionsCheckboxes +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Incidents">' +
