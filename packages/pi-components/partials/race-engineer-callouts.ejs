<%#
  Race Engineer per-callout opt-ins (issue #992 split). Authored inline in
  pit-crew.ejs until the settings window needed them; since #1003 only the
  window includes it, wrapping these items in its "Callouts" card. The
  headings, their rows, labels and defaults come from the
  @iracedeck/callout-settings registry (#1350), which pi-template-plugin.mjs
  flattens into `calloutPiGroups`; this partial only lays them out and places
  the non-callout items (ranges, thresholds) between them. See
  .claude/rules/global-settings.md (per-callout opt-in convention).
%>
		<%
if (typeof calloutPiGroups === "undefined") {
	throw new Error("race-engineer-callouts.ejs needs `calloutPiGroups` in the render data (pi-template-plugin.mjs provides it)");
}

// One PI heading of callout opt-ins, from @iracedeck/callout-settings (#1350):
// the group's rows in a 2-column grid (rows = ceil(N / 2), grid-auto-flow:
// column → fills column 1 top to bottom, then column 2), so it stays at
// exactly two columns however the family grows.
// An OFF default must OMIT the `default` attribute entirely — `default="false"`
// renders CHECKED (the truthy-attribute sdpi-checkbox trap).
function calloutGroupItem(id) {
	var group = calloutPiGroups.find(function (g) { return g.id === id; });
	if (!group) throw new Error("race-engineer-callouts.ejs: unknown callout group " + id);
	var rowCount = Math.ceil(group.rows.length / 2);
	var boxes = group.rows.map(function (r) {
		return '<sdpi-checkbox setting="' + r.setting + '" label="' + r.label + '" global' + (r.on ? ' default="true"' : '') + '></sdpi-checkbox>';
	}).join('');
	return '<sdpi-item label="' + group.title + '">' +
		'<div style="display:grid;grid-template-rows:repeat(' + rowCount + ',auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
			boxes +
		'</div>' +
	'</sdpi-item>';
}
		%>
<%- (
  calloutGroupItem('flags') +
  calloutGroupItem('start-lights') +
  calloutGroupItem('rolling-start') +
  calloutGroupItem('pit-window') +
  calloutGroupItem('pit-limiter') +
  calloutGroupItem('no-pit-limiter') +
  calloutGroupItem('opponent-pits') +
  calloutGroupItem('opponent-flags') +
  '<sdpi-item label="Opponent flag range (s)">' +
  	'<ird-range-input setting="opponentFlagRangeSeconds" min="1" max="10" step="1" default="3" global showlabels></ird-range-input>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">Only cars in your class this close ahead or behind in the race are announced.</div>' +
  calloutGroupItem('pit-service') +
  calloutGroupItem('pit-service-status') +
  calloutGroupItem('damage') +
  calloutGroupItem('track-conditions') +
  calloutGroupItem('incidents') +
  calloutGroupItem('session-start') +
  calloutGroupItem('race-engineer-toggle') +
  calloutGroupItem('telemetry-connect') +
  calloutGroupItem('lap-time') +
  calloutGroupItem('position') +
  calloutGroupItem('qualifying') +
  calloutGroupItem('race') +
  calloutGroupItem('overtakes') +
  calloutGroupItem('gaps') +
  '<sdpi-item label="Gap alert threshold (s)">' +
  	'<ird-range-input setting="gapAlertThresholdSeconds" min="0.5" max="3" step="0.1" default="1" global showlabels></ird-range-input>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">The engineer calls out when the gap to the car ahead or behind first drops under this. Re-arms once the gap opens about half a second beyond it.</div>' +
  '<sdpi-item label="Gap callout cooldown (s)">' +
  	'<ird-range-input setting="gapCalloutCooldownSeconds" min="1" max="360" step="1" default="30" global showlabels></ird-range-input>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">Minimum quiet time between any two gap callouts.</div>' +
  '<sdpi-item label="Gap change to re-announce (s)">' +
  	'<ird-range-input setting="gapCalloutMinChangeSeconds" min="0" max="10" step="0.1" default="1.5" global showlabels></ird-range-input>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">A new call must agree with the story: closing-in needs the gap down this much from its high point since the last call, pulling-away up this much from its low point. Stops back-and-forth announcements while a gap hovers. 0 disables.</div>' +
  calloutGroupItem('spotter') +
  '<sdpi-item label="Reminder interval (s)">' +
  	'<ird-range-input setting="spotterStillThereSeconds" min="1" max="10" step="1" default="3" global showlabels></ird-range-input>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">How often the still-there reminder repeats while a car is alongside.</div>' +
  calloutGroupItem('pit-box') +
  calloutGroupItem('pit-speeding') +
  calloutGroupItem('fuel') +
  '<div class="ird-supporting-text">Estimated laps of fuel left, announced mid-lap once each count is reached. "Box this lap" fires when the tank won\'t cover another full lap. Warnings stay silent when the fuel covers what\'s left of the race — lap-limited and timed races both — and "Enough fuel to finish" confirms it once, inside the last 10 laps.</div>' +
  '<sdpi-item label="Fuel margin (laps)">' +
  	'<ird-range-input setting="fuelCalloutMarginLaps" min="0" max="3" step="0.1" default="0.3" global showlabels></ird-range-input>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">Safety margin subtracted from the estimate before it is spoken — higher values make the engineer call you in earlier.</div>' +
  calloutGroupItem('corner-names') +
  '<div class="ird-supporting-text">Announces the upcoming corner\'s name in practice and test sessions. Corner data &copy; 2025 <a href="https://github.com/Lovely-Sim-Racing/lovely-track-data" target="_blank" rel="noopener noreferrer">Lovely Sim Racing</a> (lovely-track-data, modified: pruned and normalized), corner names by Racing Circuits &mdash; <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a>, used with permission.</div>' +
  '<sdpi-item label="Corner call lead (seconds)">' +
  	'<ird-range-input setting="cornerCalloutLeadSeconds" min="0" max="5" step="0.5" default="1" global showlabels></ird-range-input>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">How far before the corner the name is spoken, scaled by your speed. Keep it short &mdash; long leads blur together through consecutive corners.</div>' +
  calloutGroupItem('setup-warning') +
  calloutGroupItem('caution')
) %>
