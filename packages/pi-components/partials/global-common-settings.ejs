<%#
  Global Common Settings

  Plugin-wide common settings in a collapsible "Common Settings" accordion,
  collapsed by default. Since #992 each group lives in its own partial
  (global-common-<group>.ejs, items only) so the dedicated settings window can
  place them on separate tabs; this partial adds the group headings and wraps
  them in the one accordion the 35 action PIs have always shown.
%>
<%- include('accordion', {
  title: 'Common Settings',
  accordionId: 'Global Common Settings',
  open: false,
  content: [
    ['Window Focus', include('global-common-window-focus')],
    ['SimHub Server', include('global-common-simhub')],
    ['Dual-Press', include('global-common-dual-press')],
    ['Replay', include('global-common-replay')],
    ['Chat', include('global-common-chat')],
    ['Updates', include('global-common-updates')],
    ['Diagnostics', include('global-common-diagnostics')],
  ].map(function (g) { return '<div class="ird-section-subtitle">' + g[0] + '</div>' + g[1]; }).join('')
}) %>

<%#
  Rendered here so every action's Global Settings section gets the Stream Deck
  Profiles accordion via a single include (all action PIs include this partial).
  The accordion self-gates to Elgato via the `profiles` feature flag, and to
  "not the settings window" via the forwarded `settingsWindow` flag (#992). See
  .claude/rules/profiles-and-devices.md. EJS comment so it isn't emitted.
%>
<%- include('global-stream-deck-profiles', { settingsWindow: !!locals.settingsWindow }) %>
