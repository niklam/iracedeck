<%#
  Common settings — Diagnostics (issue #992 split). Emits items only.
%>
<sdpi-item label="Debug Logging">
  <sdpi-checkbox
    setting="debugLogging"
    label="Enable debug logging"
    global
  ></sdpi-checkbox>
</sdpi-item>
<div class="ird-supporting-text">
  Writes verbose debug detail to the plugin log. Leave it off for normal use; enable it
  only to capture a log when troubleshooting or reporting an issue, then turn it back off.
  Production logs at info level by default. Takes effect immediately — no restart needed.
</div>
<sdpi-item label="Settings file">
  <sdpi-textfield setting="_settingsStorePath" global disabled></sdpi-textfield>
</sdpi-item>
<div class="ird-supporting-text">Where iRaceDeck stores every setting on this page. Back this file up to keep your configuration.</div>
<%# Renders nothing unless the catalog override is set (#1100). %>
<ird-dev-base-url></ird-dev-base-url>
<% if (locals.settingsWindow) { %>
<div class="ird-open-settings"><ird-open-folder></ird-open-folder></div>
<%# Capture CPU profile (#1338): window only, like Open folder above — a PI's sendToPlugin goes to its action. %>
<sdpi-item label="CPU profile">
  <div class="ird-cpu-profile-buttons">
    <ird-capture-cpu-profile></ird-capture-cpu-profile>
    <ird-open-profiles-folder></ird-open-profiles-folder>
  </div>
</sdpi-item>
<ird-cpu-profile-status></ird-cpu-profile-status>
<div class="ird-supporting-text">
  Records 30 seconds of what the plugin is doing and saves it to the profiles folder next to the plugin log.
  Capture while the problem is happening, then attach both files (.cpuprofile and .txt) to your report.
  The folder keeps the five newest captures.
</div>
<% } %>
