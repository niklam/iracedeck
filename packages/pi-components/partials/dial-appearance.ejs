<!--
  Dial Dash-Box Appearance (issue #811)

  Per-dial-instance colors for the dash box the dial surfaces draw on the dial's
  own screen. Every color picker starts "not set" (empty), meaning inherit the
  setting's accent (border/label/value) or the dark default (background).

  Include this inside the `#dial-settings` block, outside the
  `dialExtendedGestures` gate: it is shown on every host with a dial screen —
  the Stream Deck+ strip and the Mirabox knob both take these colours (#1013).
-->
<%- include('accordion', {
  title: 'Dash Box Appearance',
  open: false,
  content:
    '<sdpi-item label="Border Color">' +
      '<ird-color-picker setting="dial.colors.borderColor"></ird-color-picker>' +
    '</sdpi-item>' +
    '<sdpi-item label="Label Color">' +
      '<ird-color-picker setting="dial.colors.labelColor"></ird-color-picker>' +
    '</sdpi-item>' +
    '<sdpi-item label="Value Color">' +
      '<ird-color-picker setting="dial.colors.valueColor"></ird-color-picker>' +
    '</sdpi-item>' +
    '<sdpi-item label="Background Color">' +
      '<ird-color-picker setting="dial.colors.backgroundColor"></ird-color-picker>' +
    '</sdpi-item>'
}) %>
