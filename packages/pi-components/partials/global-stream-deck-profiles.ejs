<%#
  Stream Deck Profiles (Elgato-only, issues #736/#753). An EJS comment so this
  documentation is never emitted into the shipped HTML.

  A "Stream Deck Profiles" accordion with one button per bundled profile
  TEMPLATE (clean display name, no device suffix). Each ird-profile-switch
  button sends sendToPlugin { event: "switchToProfile", profile } with the
  display name; the Elgato adapter appends the pressing device's suffix (#753)
  and routes to streamDeck.profiles.switchToProfile. Switching prompts the
  Stream Deck app to install the profile if it isn't installed yet — the
  mechanism that installs and updates iRaceDeck's bundled profiles.

  Gated to Elgato via the `profiles` platform feature flag: the Mirabox and Ulanzi
  hosts have no profile system. See .claude/rules/profiles-and-devices.md — this is
  the home for switch buttons for ALL bundled profiles; a new profile template
  gets a row automatically once its files are registered in the manifest.

  Inside the dedicated settings window (#992) the same accordion renders as a
  card WITH a device picker: switchToProfile resolves its target from the device
  whose PI is open, and the window has no device, so the page names one via
  ird-deck-device-select (populated from the `_deckDevices` global the Elgato
  plugin publishes) and each button carries it (`device-from`). The plugin's
  command handler drops a switch without a device.

  Not every deck has a variant of every template (#1457). In the window each
  row carries the device types its template ships for (`data-device-types`,
  from profiles.json) and the rows sit inside ird-profile-variants, which hides
  a row the chosen deck has no variant of and, when it has none at all, shows
  the one-line note in their place. With no deck chosen every row shows. The
  Property Inspector rendering has no picker, so its markup is unchanged.
%>
<% if (locals.platform?.features?.profiles !== false) { %>
<%
  // Unique bundled profile templates (display names), sourced from the
  // generated (manifest-derived) profiles.json so this list can't drift — add
  // a profile via the manifest + `pnpm generate:action-profiles`, not by
  // editing here. Device variants of one template collapse into a single row;
  // the plugin resolves the device-suffixed manifest name at switch time.
  // Each row also collects the device types its template has a variant for.
  var profiles = [];
  var __byName = {};
  require('./data/profiles.json').forEach(function (p) {
    var name = p.displayName || p.name;
    if (!__byName[name]) {
      __byName[name] = { name: name, deviceTypes: [] };
      profiles.push(__byName[name]);
    }
    if (typeof p.deviceType === 'number' && __byName[name].deviceTypes.indexOf(p.deviceType) < 0) {
      __byName[name].deviceTypes.push(p.deviceType);
    }
  });
  var __rows = profiles.map(function (p) {
    var device = locals.settingsWindow ? ' device-from="sw-deck-device"' : '';
    var types = locals.settingsWindow ? ' data-device-types="' + p.deviceTypes.join(',') + '"' : '';
    return '<sdpi-item label="' + p.name + '"' + types + '><ird-profile-switch profile="' + p.name + '" label="Switch"' + device + '></ird-profile-switch></sdpi-item>';
  }).join('');
%>
<%- include('accordion', {
  title: 'Stream Deck Profiles',
  accordionId: 'Global Stream Deck Profiles',
  open: false,
  content: `
    <div class="ird-supporting-text">
      Switch your Stream Deck to a ready-made iRaceDeck profile. The Stream Deck app
      asks to install the profile the first time you switch to it.
    </div>
    ${locals.settingsWindow
      ? '<sdpi-item label="Stream Deck"><ird-deck-device-select select-id="sw-deck-device"></ird-deck-device-select></sdpi-item>'
      : ''}
    ${locals.settingsWindow
      ? '<ird-profile-variants device-from="sw-deck-device">' + __rows +
        '<div class="ird-supporting-text" data-no-variants hidden>' +
        'iRaceDeck has no ready-made profiles for this Stream Deck yet.' +
        '</div></ird-profile-variants>'
      : __rows}
  `
}) %>
<% } %>
