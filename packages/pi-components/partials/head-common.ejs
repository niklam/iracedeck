<meta charset="UTF-8" />
<script src="sdpi-components.js"></script>
<script src="pi-components.js"></script>
<style>
  .hidden {
    display: none !important;
  }

  /* Shared accent for PI links (Documentation, Downloads). Single source so a
     restyle changes every link at once. */
  :root {
    --ird-link-color: #4a90d9;
  }

  /* Collapsible section styles */
  .ird-collapsible {
    margin-top: 12px;
  }

  .ird-collapsible-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0 4px 0;
    cursor: pointer;
    user-select: none;
    list-style: none;
    border-top: 1px solid #3a3a3a;
  }

  .ird-collapsible-header::-webkit-details-marker {
    display: none;
  }

  .ird-collapsible-icon {
    font-size: 8px;
    color: #808080;
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  .ird-collapsible[open] > .ird-collapsible-header > .ird-collapsible-icon {
    transform: rotate(90deg);
  }

  .ird-collapsible-title {
    font-family: "Segoe UI", Arial, Roboto, Helvetica, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    font-size: 9pt;
    font-weight: 600;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ird-collapsible-content {
    padding-top: 4px;
  }

  /* Nested sub-collapsible (inside an accordion) — smaller, indented, no border */
  .ird-collapsible.ird-subcollapsible {
    margin-top: 2px;
    margin-left: 12px;
  }
  .ird-subcollapsible > .ird-collapsible-header {
    border-top: none;
    padding: 4px 0 2px 0;
  }
  .ird-subcollapsible > .ird-collapsible-header .ird-collapsible-icon {
    font-size: 7px;
  }
  .ird-subcollapsible > .ird-collapsible-header .ird-collapsible-title {
    font-size: 8pt;
    font-weight: 500;
    color: #c8c8c8;
    letter-spacing: 0.3px;
  }

  .ird-section-subtitle {
    font-family: "Segoe UI", Arial, Roboto, Helvetica, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    font-size: 9pt;
    color: #d0d0d0;
    margin: 8px 0 4px 14px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  /* Supporting/help text shown beneath an sdpi-item. The 95px left padding aligns
     the text under the control column (not the label), matching the sdpi-item
     layout. Use this class for every help blurb instead of inline styles. */
  .ird-supporting-text {
    padding: 0 20px 8px 95px;
    font-family: "Segoe UI", Arial, Roboto, Helvetica, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    font-size: 9pt;
    color: #888;
  }

  /* Documentation link */
  .ird-docs-link {
    text-align: center;
    margin-top: 16px;
    padding-top: 8px;
    border-top: 1px solid #3a3a3a;
  }
  /* "iRaceDeck Settings", closing an action's own settings (#992, #1003,
     #1024): a centred block like .ird-docs-link, not an sdpi-item (no label
     column). Reused verbatim as the wrapper for the Storage card's Open Folder
     button (#993, ird-open-folder) — narrow both to an inline pill. */
  .ird-open-settings {
    text-align: center;
    margin: 6px 0 10px;
  }
  .ird-open-settings ird-open-settings,
  .ird-open-settings ird-open-folder,
  .ird-open-settings ird-voice-pack-refresh,
  .ird-open-settings ird-open-voice-packs-folder {
    display: inline-block;
    width: auto;
  }
  /* Divider above a block that CLOSES a section — the same rule .ird-docs-link
     uses, so the settings button and the docs link read as siblings. It sits on
     the block WRAPPING .ird-open-settings (see open-settings.ejs), so the two
     never compete for the same element's margin. */
  .ird-section-footer {
    margin-top: 16px;
    padding-top: 8px;
    border-top: 1px solid #3a3a3a;
  }
  .ird-docs-link a {
    color: var(--ird-link-color);
    font-family: "Segoe UI", Arial, Roboto, Helvetica, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    font-size: 9pt;
    text-decoration: none;
  }
  .ird-docs-link a:hover {
    color: #6fb0f0;
    text-decoration: underline;
  }
  .ird-docs-link a:focus-visible {
    color: #6fb0f0;
    text-decoration: underline;
    outline: 2px solid var(--ird-link-color);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Version footer */
  .ird-version {
    font-family: "Segoe UI", Arial, Roboto, Helvetica, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    font-size: 9pt;
    color: #888;
    text-align: center;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #3a3a3a;
  }
  .ird-version a {
    color: var(--ird-link-color);
  }

  /* Key bindings section styles */
  .ird-section-heading {
    padding: 8px 0 4px 0;
    border-top: 1px solid #3a3a3a;
    font-family: "Segoe UI", Arial, Roboto, Helvetica, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    font-size: 9pt;
    font-weight: 600;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Section header (divides Action Settings from Key Bindings) */
  .ird-section-header {
    margin: 20px 0 10px 0;
  }

  .ird-section-header:first-child {
    margin-top: 4px;
  }

  .ird-section-header-label {
    font-family: "Segoe UI", Arial, Roboto, Helvetica, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    font-size: 8pt;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #999;
  }

  .ird-section-header-rule {
    height: 1px;
    background: #555;
    margin-top: 6px;
  }
</style>
<script>
  // Accordion state persistence — store open/closed state in Stream Deck global
  // settings so it survives PI reloads (SD wipes the webview on each key selection).
  // Keyed by accordion title so state is shared across all action types.
  (function() {
    var SETTING_KEY = '_accordionState';
    var accordionState = {};
    var saveFn = null;

    function restoreAccordions() {
      document.querySelectorAll('.ird-collapsible[data-accordion-id]').forEach(function(el) {
        var id = el.getAttribute('data-accordion-id');
        if (id in accordionState) {
          if (accordionState[id]) {
            el.setAttribute('open', '');
          } else {
            el.removeAttribute('open');
          }
        }
      });
    }

    function saveState() {
      if (saveFn) saveFn(JSON.stringify(accordionState));
    }

    function initAccordions() {
      // Attach toggle listeners to each accordion
      document.querySelectorAll('.ird-collapsible[data-accordion-id]').forEach(function(el) {
        el.addEventListener('toggle', function() {
          var id = el.getAttribute('data-accordion-id');
          accordionState[id] = el.open;
          saveState();
        });
      });

      // Subscribe to the global setting via SDPIComponents
      if (window.SDPIComponents) {
        var hook = window.SDPIComponents.useGlobalSettings(
          SETTING_KEY,
          function(value) {
            if (value) {
              try { accordionState = JSON.parse(value); } catch (_) {}
            }
            restoreAccordions();
          },
          null
        );
        saveFn = hook[1];
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAccordions);
    } else {
      initAccordions();
    }
  })();

  // Inject the global warnings banner (issue #610) at the very top of every
  // PI body. head-common is included by every PI and loads pi-components.js,
  // so this covers all current and future Property Inspectors with no
  // per-template markup. The <ird-warnings> element subscribes to the
  // `_warnings` global setting and renders itself; it collapses to nothing
  // when there are no warnings.
  (function() {
    function injectWarnings() {
      if (!document.body) return;
      if (document.querySelector('ird-warnings[data-auto]')) return;
      var el = document.createElement('ird-warnings');
      // Marked so the guard above matches THIS strip only: `open-settings.ejs`
      // places its own <ird-warnings> in the body, and an unqualified selector
      // would see that one and skip injecting the top strip entirely (#1005).
      el.setAttribute('data-auto', '');
      // The settings-window OPEN failure has a dedicated home directly above
      // the iRaceDeck Settings button (see open-settings.ejs); excluding it
      // here is what keeps it from rendering twice on one page. Its sibling, the
      // SERVER failure, is page-wide (nothing the PI changes reaches the
      // plugin) and stays in this strip, so it is deliberately not listed.
      el.setAttribute('except', 'settings-window-open');
      document.body.insertBefore(el, document.body.firstChild);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', injectWarnings);
    } else {
      injectWarnings();
    }
  })();

  // sdpi-textfield and sdpi-textarea don't reliably apply the default attribute
  // for new action instances. Wait for settings to load, then fill empty fields.
  setTimeout(() => {
    document.querySelectorAll("sdpi-textfield[default][setting], sdpi-textarea[default][setting]").forEach((el) => {
      if (!el.value) {
        el.value = el.getAttribute("default");
      }
    });
  }, 500);

  // Per-action override preset buttons
  document.addEventListener('click', function(ev) {
    var btn = ev.target.closest('.ird-override-preset');
    if (!btn) return;
    var mapping = {
      bg: 'color-override-backgroundColor',
      text: 'color-override-textColor',
      g1: 'color-override-graphic1Color',
      g2: 'color-override-graphic2Color'
    };
    ['bg', 'text', 'g1', 'g2'].forEach(function(key) {
      var color = btn.getAttribute('data-' + key);
      var el = document.getElementById(mapping[key]);
      if (el && color !== null) {
        el.value = color;
        el.save();
      }
    });
  });

  // Custom position visibility: per-action title position select
  (function() {
    function updateTitleCustomPosition(value) {
      var item = document.getElementById('title-custom-position-item');
      if (!item) return;
      if (value === 'custom') {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    }

    async function initTitlePosition() {
      await customElements.whenDefined('sdpi-select');
      var select = document.getElementById('title-override-position');
      if (!select) return;
      updateTitleCustomPosition(select.value || 'inherit');
      select.addEventListener('change', function(e) { updateTitleCustomPosition(e.target.value); });
      select.addEventListener('input', function(e) { updateTitleCustomPosition(e.target.value); });
      // Polling fallback on the shared page poller (window.irdPoll from
      // pi-components.js) — sdpi-select events can be unreliable (#903).
      var lastVal = select.value || 'inherit';
      window.irdPoll(function() {
        var cur = select.value;
        if (cur && cur !== lastVal) {
          lastVal = cur;
          updateTitleCustomPosition(cur);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTitlePosition);
    } else {
      initTitlePosition();
    }
  })();

  // Font Size checkbox gate: sdpi-checkbox (persists via setting attribute) + ird-range-input.
  // Visibility only during init/polling — the ird-range-input default attribute handles display.
  // Value clearing only on explicit user uncheck (change listener).
  (function() {
    async function initFontSizeToggle() {
      await customElements.whenDefined('sdpi-checkbox');
      var toggle = document.getElementById('title-override-fontSize-toggle');
      var item = document.getElementById('title-fontSize-item');
      var range = document.getElementById('title-override-fontSize');
      if (!toggle || !item || !range) return;

      function isChecked() {
        return toggle.checked === true || toggle.value === true || toggle.value === 'true';
      }

      function setVisibility(show) {
        if (show) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      }

      // User interaction: clear fontSize on uncheck so it falls back to defaults
      toggle.addEventListener('change', function() {
        var checked = isChecked();
        setVisibility(checked);
        if (!checked) {
          range.value = '';
          range.save();
        }
      });

      // Initial state — visibility only, no value manipulation
      setVisibility(isChecked());

      // Polling fallback for checkbox state (sdpi-checkbox loads asynchronously)
      var lastChecked = isChecked();
      window.irdPoll(function() {
        var cur = isChecked();
        if (cur !== lastChecked) {
          lastChecked = cur;
          setVisibility(cur);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFontSizeToggle);
    } else {
      initFontSizeToggle();
    }
  })();

  // Note: titleOverrides.titleText uses sdpi-textarea with setting attribute.
  // Persistence is handled automatically by sdpi-components.

</script>
