<div class="ird-section-header">
  <div class="ird-section-header-label"><%= title %></div>
  <div class="ird-section-header-rule"></div>
</div>
<%# Optional "iRaceDeck Settings" button under the header (issue #992). Only
    `settings.ejs` passes `openSettings: true`, and there the button IS the
    page. An action PI gets it from `action-settings-footer.ejs` instead, which
    renders it itself so it can close the action's own settings with it rather
    than sit under a heading (#1003, #1024). %>
<% if (locals.openSettings) { %>
<%- include('open-settings') %>
<% } %>
