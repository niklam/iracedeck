<div class="ird-section-header">
  <div class="ird-section-header-label"><%= title %></div>
  <div class="ird-section-header-rule"></div>
</div>
<%# Optional "Open iRaceDeck Settings" button under the header (issue #992). Pass
    `openSettings: true` — the Global Settings header does, so every action's PI
    links to the dedicated settings window from one place. %>
<% if (locals.openSettings) { %>
<div class="ird-open-settings">
  <ird-open-settings></ird-open-settings>
</div>
<% } %>
