<%#
  Race Engineer / Pit Crew plugin-wide settings (issue #992 split): the live
  master toggles and their startup policies (issue #1007), voice, driver name,
  output device, volumes and their Test buttons, and the radio-frame opt-outs
  (issue #1064: Radio beeps, Pit ambience).
  The per-callout opt-ins AND the tuning sliders (gap alert, spotter
  still-there, fuel margin, corner lead) live in race-engineer-callouts.ejs.
  Emits items only — the settings window wraps them in a card. Since #1003 it
  is the sole consumer: the Pit Crew Property Inspector no longer renders any
  of these plugin-global controls.
%>
<%- (
'<sdpi-item label="Race Engineer">' +
  	'<sdpi-checkbox setting="pitCrewRaceEngineerEnabled" label="Enabled" global></sdpi-checkbox>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">' +
  	'Turns the engineer on or off right now — the same as a Pit Crew Race Engineer Toggle key.' +
  '</div>' +
  '<sdpi-item label="On startup">' +
  	'<sdpi-select setting="pitCrewRaceEngineerStartupPolicy" default="remember-last" global>' +
  		'<option value="remember-last">Remember last used</option>' +
  		'<option value="always-on">Always on</option>' +
  		'<option value="always-off">Always off</option>' +
  	'</sdpi-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Radar">' +
  	'<sdpi-checkbox setting="pitCrewRadarEnabled" label="Enabled" global></sdpi-checkbox>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">' +
  	'Turns the proximity ticks on or off right now — the same as a Pit Crew Radar Toggle key.' +
  '</div>' +
  '<sdpi-item label="On startup">' +
  	'<sdpi-select setting="pitCrewRadarStartupPolicy" default="remember-last" global>' +
  		'<option value="remember-last">Remember last used</option>' +
  		'<option value="always-on">Always on</option>' +
  		'<option value="always-off">Always off</option>' +
  	'</sdpi-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Race Engineer Voice">' +
  	'<ird-voice-select setting="raceEngineerVoice" voices="_raceEngineerVoices" labels="_voiceLabels" default="default"></ird-voice-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Your Name">' +
  	'<ird-name-select setting="driverName" names="_driverNames" default="driver"></ird-name-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Output Device">' +
  	'<ird-audio-device-select setting="audioOutputDevice" devices="_audioDeviceList" default-label="System Default"></ird-audio-device-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Race Engineer Volume">' +
  	'<div style="display:flex;align-items:center;gap:8px;">' +
  		'<ird-range-input setting="raceEngineerVolume" global min="0" max="100" step="1" default="50" style="flex:1;"></ird-range-input>' +
  		'<ird-audio-test preview="voice" label="Test"></ird-audio-test>' +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Background Volume">' +
  	'<div style="display:flex;align-items:center;gap:8px;">' +
  		'<ird-range-input setting="backgroundVolume" global min="0" max="100" step="1" default="25" style="flex:1;"></ird-range-input>' +
  		'<ird-audio-test preview="background" label="Test"></ird-audio-test>' +
  	'</div>' +
  '</sdpi-item>' +
  // The two halves of the radio frame (issue #1064), as opt-OUTs: both default
  // on, so `default="true"` is the one value that renders checked. Placed
  // directly under Background Volume because that slider stays the level
  // control for both — the help line says so, so nobody hunts for a third
  // slider. Two stacked rows (the callouts partial's grid, one column).
  '<sdpi-item label="Radio Frame">' +
  	'<div style="display:grid;grid-template-rows:repeat(2,auto);grid-auto-flow:column;gap:4px 12px;width:100%;">' +
  		'<sdpi-checkbox setting="raceEngineerRadioBeeps" label="Radio beeps" global default="true"></sdpi-checkbox>' +
  		'<sdpi-checkbox setting="raceEngineerPitAmbience" label="Pit ambience" global default="true"></sdpi-checkbox>' +
  	'</div>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">' +
  	'Background Volume sets the level of both.' +
  '</div>' +
  '<sdpi-item label="Radar Volume">' +
  	'<div style="display:flex;align-items:center;gap:8px;">' +
  		'<ird-range-input setting="radarVolume" global min="0" max="100" step="1" default="50" style="flex:1;"></ird-range-input>' +
  		'<ird-audio-test preview="radar" label="Test"></ird-audio-test>' +
  	'</div>' +
  '</sdpi-item>'
) %>
<%#
  Installed voice packs (issue #1034), and downloadable ones from iRaceDeck's
  own catalog (issue #1100). Settings-window only: every command below
  (voicePackRefresh / voicePackInstall / voicePackRemove /
  openVoicePacksFolder) is handled by the settings-window command handler,
  and a Property Inspector's `sendToPlugin` goes to its own action instead —
  the same reason `ird-open-folder` is gated in global-common-diagnostics.ejs.
%>
<% if (locals.settingsWindow) { %>
<sdpi-item label="Installed Voices">
  <ird-voice-pack-list packs="_voicePacks"></ird-voice-pack-list>
</sdpi-item>
<div class="ird-supporting-text">
  Voice packs live in <code>%LOCALAPPDATA%\iRaceDeck\Race Engineer\Voices</code> and survive plugin updates.
  Add a pack folder there, then rescan. A pack that cannot be loaded is listed with the reason. A pack you no
  longer want can be removed here too.
</div>
<div class="ird-open-settings">
  <ird-voice-pack-refresh></ird-voice-pack-refresh>
  <ird-open-voice-packs-folder></ird-open-voice-packs-folder>
</div>
<sdpi-item label="Available to Download">
  <ird-voice-pack-catalog status="_voicePackStatus"></ird-voice-pack-catalog>
</sdpi-item>
<div class="ird-supporting-text">
  Packs iRaceDeck publishes itself. Press Install (or Update, once a newer version is out) and iRaceDeck
  downloads, verifies and installs it for you — this can happen while iRacing is running.
</div>
<% } %>
