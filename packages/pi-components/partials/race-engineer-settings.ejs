<%#
  Race Engineer / Pit Crew plugin-wide settings (issue #992 split): the live
  master toggles and their startup policies (issue #1007), voice, driver name,
  output device, volumes and their Test buttons.
  The per-callout opt-ins AND the tuning sliders (gap alert, spotter
  still-there, fuel margin, corner lead) live in race-engineer-callouts.ejs.
  Emits items only — pit-crew.ejs wraps them in its "Pit Crew Settings"
  accordion, the settings window in a card.
%>
<%- (
'<sdpi-item label="Race Engineer">' +
  	'<sdpi-checkbox setting="pitCrewRaceEngineerEnabled" label="Enabled" global></sdpi-checkbox>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">' +
  	'Turns the engineer on or off right now — the same as a Pit Crew Race Engineer Toggle key.' +
  '</div>' +
  '<sdpi-item label="On startup">' +
  	'<sdpi-select setting="pitCrewRaceEngineerStartupPolicy" default="remember-last" global>' +
  		'<option value="remember-last">Remember last used</option>' +
  		'<option value="always-on">Always on</option>' +
  		'<option value="always-off">Always off</option>' +
  	'</sdpi-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Radar">' +
  	'<sdpi-checkbox setting="pitCrewRadarEnabled" label="Enabled" global></sdpi-checkbox>' +
  '</sdpi-item>' +
  '<div class="ird-supporting-text">' +
  	'Turns the proximity ticks on or off right now — the same as a Pit Crew Radar Toggle key.' +
  '</div>' +
  '<sdpi-item label="On startup">' +
  	'<sdpi-select setting="pitCrewRadarStartupPolicy" default="remember-last" global>' +
  		'<option value="remember-last">Remember last used</option>' +
  		'<option value="always-on">Always on</option>' +
  		'<option value="always-off">Always off</option>' +
  	'</sdpi-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Race Engineer Voice">' +
  	'<ird-voice-select setting="raceEngineerVoice" voices="_raceEngineerVoices"></ird-voice-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Your Name">' +
  	'<ird-name-select setting="driverName" names="_driverNames" default="driver"></ird-name-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Output Device">' +
  	'<ird-audio-device-select setting="audioOutputDevice" devices="_audioDeviceList" default-label="System Default"></ird-audio-device-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Race Engineer Volume">' +
  	'<div style="display:flex;align-items:center;gap:8px;">' +
  		'<ird-range-input setting="raceEngineerVolume" global min="0" max="100" step="1" default="50" style="flex:1;"></ird-range-input>' +
  		'<ird-audio-test preview="voice" label="Test"></ird-audio-test>' +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Background Volume">' +
  	'<div style="display:flex;align-items:center;gap:8px;">' +
  		'<ird-range-input setting="backgroundVolume" global min="0" max="100" step="1" default="25" style="flex:1;"></ird-range-input>' +
  		'<ird-audio-test preview="background" label="Test"></ird-audio-test>' +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Radar Volume">' +
  	'<div style="display:flex;align-items:center;gap:8px;">' +
  		'<ird-range-input setting="radarVolume" global min="0" max="100" step="1" default="50" style="flex:1;"></ird-range-input>' +
  		'<ird-audio-test preview="radar" label="Test"></ird-audio-test>' +
  	'</div>' +
  '</sdpi-item>'
) %>
