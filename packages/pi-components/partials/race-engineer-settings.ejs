<%#
  Race Engineer / Pit Crew plugin-wide settings (issue #992 split): on-startup
  toggles, voice, driver name, output device, volumes and their Test buttons,
  spotter/gap/fuel/corner tuning. Emits items only — pit-crew.ejs wraps them in
  its "Pit Crew Settings" accordion, the settings window in a card.
%>
<%- (
'<sdpi-item label="On startup">' +
  	'<sdpi-checkbox setting="pitCrewRaceEngineerEnabledOnStartup" label="Race Engineer enabled" global></sdpi-checkbox>' +
  	'<br>' +
  	'<sdpi-checkbox setting="pitCrewRadarEnabledOnStartup" label="Radar enabled" global></sdpi-checkbox>' +
  '</sdpi-item>' +
  '<sdpi-item label="Race Engineer Voice">' +
  	'<ird-voice-select setting="raceEngineerVoice" voices="_raceEngineerVoices"></ird-voice-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Your Name">' +
  	'<ird-name-select setting="driverName" names="_driverNames" default="driver"></ird-name-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Output Device">' +
  	'<ird-audio-device-select setting="audioOutputDevice" devices="_audioDeviceList" default-label="System Default"></ird-audio-device-select>' +
  '</sdpi-item>' +
  '<sdpi-item label="Race Engineer Volume">' +
  	'<div style="display:flex;align-items:center;gap:8px;">' +
  		'<ird-range-input setting="raceEngineerVolume" global min="0" max="100" step="1" default="50" style="flex:1;"></ird-range-input>' +
  		'<ird-audio-test target="test-race-engineer-voice-field" preview="voice" label="Test"></ird-audio-test>' +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Background Volume">' +
  	'<div style="display:flex;align-items:center;gap:8px;">' +
  		'<ird-range-input setting="backgroundVolume" global min="0" max="100" step="1" default="25" style="flex:1;"></ird-range-input>' +
  		'<ird-audio-test target="test-background-field" preview="background" label="Test"></ird-audio-test>' +
  	'</div>' +
  '</sdpi-item>' +
  '<sdpi-item label="Radar Volume">' +
  	'<div style="display:flex;align-items:center;gap:8px;">' +
  		'<ird-range-input setting="radarVolume" global min="0" max="100" step="1" default="50" style="flex:1;"></ird-range-input>' +
  		'<ird-audio-test target="test-radar-field" preview="radar" label="Test"></ird-audio-test>' +
  	'</div>' +
  '</sdpi-item>'
) %>
