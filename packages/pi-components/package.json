{
  "name": "@iracedeck/pi-components",
  "version": "3.8.0-dev.0",
  "description": "Shared Property Inspector assets for iRaceDeck plugins: web components, EJS templates and partials, template data, and the Rollup EJS compile plugin",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "exports": {
    "./build": "./src/build/index.mjs"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf browser/pi-components.js browser/ulanzi-pi-bridge.js browser/settings-window-bridge.js browser/pi-settings-bridge.js",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "devDependencies": {
    "@iracedeck/app-constants": "workspace:*",
    "@iracedeck/callout-script": "workspace:*",
    "@iracedeck/callout-settings": "workspace:*",
    "@iracedeck/fetch-utils": "workspace:*",
    "@iracedeck/settings": "workspace:*",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@tsconfig/node22": "22.0.6",
    "@types/ejs": "3.1.5",
    "@types/node": "26.6.6",
    "ejs": "7.0.2",
    "rimraf": "6.1.3",
    "rollup": "4.67.2",
    "tslib": "2.9.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "license": "SEE LICENSE IN LICENSE"
}
