{
  "name": "@iracedeck/deck-adapter-elgato",
  "version": "3.8.0-dev.0",
  "description": "Elgato Stream Deck adapter for @iracedeck/deck-core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3",
    "@iracedeck/app-constants": "workspace:*",
    "@iracedeck/deck-core": "workspace:*",
    "@iracedeck/logger": "workspace:*"
  },
  "devDependencies": {
    "@elgato/utils": "0.6.1",
    "@iracedeck/settings": "workspace:*",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.5",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
