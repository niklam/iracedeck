{
  "name": "@iracedeck/audio-assets",
  "version": "3.2.0",
  "description": "Shared audio assets (MP3) for iRaceDeck plugins",
  "type": "module",
  "exports": {
    "./build": {
      "types": "./src/build/index.d.ts",
      "default": "./src/build/index.mjs"
    },
    "./manifest.json": "./manifest.json",
    "./catalog/*.json": "./catalog/*.json",
    "./voice/*/callouts.json": "./voice/*/callouts.json",
    "./presets": "./src/presets.mjs"
  },
  "scripts": {
    "build": "node src/build/prebuild.mjs",
    "generate": "tsx src/generate/generate.ts",
    "generate:dry-run": "tsx src/generate/generate.ts --dry-run",
    "generate:manifest": "node scripts/generate-audio-manifest.mjs",
    "generate:callout-scripts": "tsx scripts/generate-callout-scripts.mjs",
    "pack:voice": "node scripts/pack-voice.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@iracedeck/callout-script": "workspace:*",
    "@iracedeck/deck-core": "workspace:*",
    "@types/node": "26.4.0",
    "fflate": "0.8.3",
    "ffmpeg-static": "5.3.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  }
}
