{
  "name": "@iracedeck/race-engineer-wiring",
  "version": "3.6.0-dev.0",
  "description": "The Race Engineer's wiring: the bus caches its conditions read, every registerPitCrew dependency, and the call — shared by the three plugins and the scenario harness.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "dependencies": {
    "@iracedeck/audio-scenarios": "workspace:*",
    "@iracedeck/deck-core": "workspace:*",
    "@iracedeck/event-bus": "workspace:*",
    "@iracedeck/logger": "workspace:*",
    "@iracedeck/sim-events-iracing": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.4",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
