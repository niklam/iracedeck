{
  "name": "@iracedeck/website",
  "version": "3.3.0-dev.0",
  "private": true,
  "description": "Documentation website for iRaceDeck Stream Deck plugins",
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:gallery && pnpm generate:changelog-json && pnpm generate:voice-catalog-json && astro dev",
    "build": "pnpm generate:gallery && pnpm generate:changelog-json && pnpm generate:voice-catalog-json && astro build",
    "generate:gallery": "tsx scripts/generate-icon-gallery.mts",
    "generate:changelog-json": "node scripts/generate-changelog-json.mjs",
    "generate:voice-catalog-json": "tsx scripts/generate-voice-catalog-json.mjs",
    "preview": "astro preview",
    "typecheck": "pnpm generate:gallery && astro check",
    "deploy": "pnpm build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.9",
    "astro": "7.2.8",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.17.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@iracedeck/audio-scenarios": "workspace:*",
    "@iracedeck/audio-service": "workspace:*",
    "@iracedeck/deck-core": "workspace:*",
    "@iracedeck/icon-composer": "workspace:*",
    "firebase-tools": "15.28.1",
    "tsx": "4.23.12"
  }
}
