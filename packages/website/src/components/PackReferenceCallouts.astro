---
// packages/website/src/components/PackReferenceCallouts.astro
// Every callout the Race Engineer can make, grouped by family, from the
// generated pack-author reference (src/data/pack-reference.json, issue #1066).
// Nothing here is hand-typed: the contract's description, trigger, frame,
// weight and scheduling come from the code, the comment and test from the
// bundled voice's script, and the references from walking that entry.
import raw from "../data/pack-reference.json";
import { parseCallouts } from "../pack-reference-types.js";
import {
  caseHref,
  condHref,
  describeScheduling,
  describeTrigger,
  describeWeight,
  groupByFamily,
  lineHref,
  NO_FAMILY_LABEL,
  varHref,
} from "../pack-reference-view.js";

const callouts = parseCallouts(raw.callouts);
const groups = groupByFamily(callouts);
const scripted = callouts.filter((c) => !c.skip).length;

/** Whether the entry references anything at all — a `skip: true` entry, or a pure-clip one, may not. */
function hasReferences(c: (typeof callouts)[number]): boolean {
  const r = c.references;

  return (
    r.pools.length + r.vars.length + r.conds.length + r.cases.length + r.includes.length + r.frames.length > 0
  );
}
---

<p class="pack-ref-count">
  {callouts.length} callouts in {groups.length} groups; the bundled voice scripts {scripted} of them.
</p>

{
  groups.map((group) => (
    <section class="pack-ref-family">
      <h2 id={group.anchor}>{group.family === null ? NO_FAMILY_LABEL : <code>{group.family}</code>}</h2>
      {group.family === null ? (
        <p>
          These callouts belong to no family: each neither replaces nor is replaced by a family-mate, and only its
          weight decides what it yields to and what yields to it.
        </p>
      ) : (
        <p>
          Callouts in the <code>{group.family}</code> family preempt each other: a newer one replaces one of the same
          family that is still playing, whatever their weights.
        </p>
      )}

      {group.callouts.map((c) => (
        <article class="pack-ref-callout">
          <h3 id={c.id}>
            <code>{c.id}</code>
          </h3>
          <p>{c.description}</p>
          <dl class="pack-ref-facts">
            <dt>Trigger</dt>
            <dd>{c.event === null ? describeTrigger(c) : <code>{c.event}</code>}</dd>
            <dt>Default frame</dt>
            <dd>{c.frame === "none" ? "none — plays unframed" : <code>{c.frame}</code>}</dd>
            <dt>Weight</dt>
            <dd>{describeWeight(c.weight)}</dd>
            <dt>Scheduling</dt>
            <dd>{describeScheduling(c)}</dd>
          </dl>
          {c.skip ? (
            <p>
              <strong>Bundled entry:</strong> <code>skip: true</code> — the bundled voice is deliberately silent here.
            </p>
          ) : (
            <>
              {c.comment !== null && (
                <p>
                  <strong>Says:</strong> {c.comment}
                </p>
              )}
              {c.test !== null && (
                <p>
                  <strong>Hear it:</strong> {c.test}
                </p>
              )}
              {hasReferences(c) && (
                <dl class="pack-ref-refs">
                  {c.references.pools.length > 0 && (
                    <>
                      <dt>Pools</dt>
                      <dd>
                        {c.references.pools.map((pool, i) => (
                          <>
                            {i > 0 && ", "}
                            {pool.includes("/") ? (
                              <a href={lineHref(pool)}>
                                <code>{pool}</code>
                              </a>
                            ) : (
                              <code>{pool}</code>
                            )}
                          </>
                        ))}
                      </dd>
                    </>
                  )}
                  {c.references.vars.length > 0 && (
                    <>
                      <dt>Variables</dt>
                      <dd>
                        {c.references.vars.map((name, i) => (
                          <>
                            {i > 0 && ", "}
                            <a href={varHref(name)}>
                              <code>{`{{${name}}}`}</code>
                            </a>
                          </>
                        ))}
                      </dd>
                    </>
                  )}
                  {c.references.conds.length > 0 && (
                    <>
                      <dt>Conditions</dt>
                      <dd>
                        {c.references.conds.map((name, i) => (
                          <>
                            {i > 0 && ", "}
                            <a href={condHref(name)}>
                              <code>{name}</code>
                            </a>
                          </>
                        ))}
                      </dd>
                    </>
                  )}
                  {c.references.cases.length > 0 && (
                    <>
                      <dt>Cases</dt>
                      <dd>
                        {c.references.cases.map((item, i) => (
                          <>
                            {i > 0 && "; "}
                            <a href={caseHref(item.name)}>
                              <code>{item.name}</code>
                            </a>
                            {item.keys.length > 0 && (
                              <>
                                {" → "}
                                {item.keys.map((key, k) => (
                                  <>
                                    {k > 0 && ", "}
                                    <code>{key}</code>
                                  </>
                                ))}
                              </>
                            )}
                          </>
                        ))}
                      </dd>
                    </>
                  )}
                  {c.references.includes.length > 0 && (
                    <>
                      <dt>Fragments</dt>
                      <dd>
                        {c.references.includes.map((name, i) => (
                          <>
                            {i > 0 && ", "}
                            <code>{`@${name}`}</code>
                          </>
                        ))}
                      </dd>
                    </>
                  )}
                  {c.references.frames.length > 0 && (
                    <>
                      <dt>Frame override</dt>
                      <dd>
                        {c.references.frames.map((name, i) => (
                          <>
                            {i > 0 && ", "}
                            <code>{name}</code>
                          </>
                        ))}
                      </dd>
                    </>
                  )}
                </dl>
              )}
            </>
          )}
        </article>
      ))}
    </section>
  ))
}

<style>
  .pack-ref-count {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .pack-ref-callout {
    margin-top: 1.5rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--sl-color-hairline-light);
  }
  .pack-ref-facts,
  .pack-ref-refs {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 1rem;
    row-gap: 0.25rem;
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .pack-ref-facts dt,
  .pack-ref-refs dt {
    color: var(--sl-color-gray-3);
    font-weight: 500;
  }
  .pack-ref-facts dd,
  .pack-ref-refs dd {
    margin: 0;
  }
</style>
