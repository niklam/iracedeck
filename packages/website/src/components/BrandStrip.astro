---
// Renders the hardware brands of one or more ecosystems as a row of uniform
// tiles — the visual answer to "will iRaceDeck work with my device?".
//
// A brand with a logo asset renders the logo; a brand without one renders a
// styled wordmark in the same box and the same tone. Both are drawn in a single
// neutral colour per theme (see the `.brand-strip` rules in custom.css) so the
// row reads as a compatibility statement rather than a sponsor wall.
//
// Brand data — including which ecosystems have brands we cannot name — comes
// from src/data/brands.ts. Do not hardcode brand names here.
import { BRAND_LOGO_EXTENSIONS, brandGroupsFor, type Ecosystem } from "../data/brands";

interface Props {
  /** Ecosystem(s) to render, in the order given. */
  ecosystem: Ecosystem | Ecosystem[];
  /** Accessible name for the list. */
  label?: string;
  /** Optional CSS class forwarded to the list element. */
  class?: string;
}

const { ecosystem, label = "Supported hardware brands", class: className } = Astro.props;

// Logo assets go through Vite so they are content-hashed and cache-busted. The
// `?url` query keeps SVG and raster assets on one code path (an unqueried .svg
// import would resolve to a component instead of a URL).
//
// The extension list has to be a literal here (Vite needs a static pattern);
// BRAND_LOGO_EXTENSIONS mirrors it so brands.test.ts can catch a logo declared
// with an extension this glob would skip.
const logoUrls = import.meta.glob<string>("../assets/brands/*.{svg,png,webp,avif}", {
  eager: true,
  query: "?url",
  import: "default",
});

// A declared-but-missing asset would silently degrade to a wordmark, which is
// indistinguishable from a brand that never had a logo. Fail the build instead.
function resolveLogo(name: string, logo: string): string {
  const logoUrl = logoUrls[`../assets/brands/${logo}`];
  if (logoUrl) return logoUrl;

  const reason = BRAND_LOGO_EXTENSIONS.some((extension) => logo.endsWith(extension))
    ? `no such file exists in src/assets/brands/`
    : `its extension is not one of ${BRAND_LOGO_EXTENSIONS.join(", ")}`;

  throw new Error(`Brand "${name}" declares logo "${logo}", but ${reason}.`);
}

// Each ecosystem keeps its own "and more" tile, so the open-ended list is marked
// next to the brands it applies to however the caller orders the ecosystems.
const groups = brandGroupsFor(ecosystem).map((group) => ({
  listIsComplete: group.listIsComplete,
  tiles: group.brands.map((brand) => ({
    brand,
    logoUrl: brand.logo ? resolveLogo(brand.name, brand.logo) : undefined,
  })),
}));
---

<ul class:list={["brand-strip", className]} role="list" aria-label={label}>
  {
    groups.map(({ listIsComplete, tiles }) => (
      <Fragment>
        {tiles.map(({ brand, logoUrl }) => (
          <li class="brand-tile">
            {logoUrl && (
              <img
                class:list={[
                  "brand-logo",
                  brand.logoNeedsName && "brand-logo-inline",
                  brand.preserveBrandColor && "brand-logo-color",
                ]}
                src={logoUrl}
                alt={brand.logoNeedsName ? "" : brand.name}
              />
            )}
            {(!logoUrl || brand.logoNeedsName) && <span class="brand-wordmark">{brand.name}</span>}
          </li>
        ))}
        {!listIsComplete && (
          <li class="brand-tile brand-tile-more">
            <span class="brand-wordmark">and more</span>
          </li>
        )}
      </Fragment>
    ))
  }
</ul>
