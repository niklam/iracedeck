---
// packages/website/src/components/IconGallery.astro
// Renders the generated icon inventory (src/data/icon-gallery.json) as a
// searchable, action-group-centric gallery. Assets live in /icon-gallery/.
import entries from "../data/icon-gallery.json";
import type { GalleryEntry } from "../gallery-gen/lib.js";
import {
  buildTemplateGroups,
  categoryRemainder,
  CLASS_SECTIONS,
  dialRemainder,
  dynamicSectionEntries,
  keyRemainder,
  SIZE_FACTS,
  type TemplateGroup,
} from "../gallery-gen/sections.js";
import IconGalleryCard from "./IconGalleryCard.astro";

const all = entries as GalleryEntry[];

const templateSection = CLASS_SECTIONS.find((s) => s.id === "template")!;
const dynamicSection = CLASS_SECTIONS.find((s) => s.id === "dynamic")!;

// One group per template family PLUS one synthetic "action group" for each
// of the three dynamic-only actions (Pit Crew, Session Info, Telemetry
// Display), sorted together alphabetically by display name (item 2, gallery
// restructure wave).
const templateGroups = buildTemplateGroups(all);

// The flat "Dynamic templates" grid only shows templates whose action ALSO
// has a group above (item 4) — the three dynamic-only actions' entries were
// pulled into their own group's grid instead (item 2).
const dynamicEntries = dynamicSectionEntries(all);

// Dial assets (dial.svg + dash sample) that couldn't be matched to any group
// — expected empty; kept as a safety-net rump section rather than silently
// dropping a real asset (item 3).
const orphanDials = dialRemainder(all);

// Build-time warnings for silently-dropped orphans (key/category that couldn't
// be matched to any group).
const orphanKeys = keyRemainder(all);
const orphanCategories = categoryRemainder(all);

if (orphanKeys.length > 0) {
  console.warn(
    `IconGallery: ${orphanKeys.length} default key image(s) have no group and are not rendered: ${orphanKeys.map((e) => e.name).join(", ")}`,
  );
}
if (orphanCategories.length > 0) {
  console.warn(
    `IconGallery: ${orphanCategories.length} category icon(s) have no group and are not rendered: ${orphanCategories.map((e) => e.name).join(", ")}`,
  );
}

function dialLabel(e: GalleryEntry): string {
  return e.family === "touch-strip" ? "dial screen (sample)" : "dial icon";
}

function groupCount(group: TemplateGroup): number {
  return group.entries.length + (group.defaultKey ? 1 : 0) + group.dialEntries.length;
}
---

<div class="icon-gallery not-content">
  <p>
    <input id="icon-gallery-filter" type="search" placeholder="Filter by name, family, action, or title…" aria-label="Filter icons" />
    <span id="icon-gallery-count">{all.length} icons</span>
  </p>

  <div class="gallery-size-facts">
    <p>Sizes at a glance</p>
    <ul>
      {SIZE_FACTS.map((fact) => <li>{fact}</li>)}
    </ul>
  </div>

  {templateGroups.length > 0 && (
    <section class="gallery-class" data-class="template">
      <h2 id={`class-${templateSection.id}`}>{templateSection.label}</h2>
      <p>{templateSection.blurb}</p>
      <p class="section-size">{templateSection.blurbSize}</p>

      {templateGroups.map((group) => (
        <div class="gallery-family">
          <h3 id={group.anchor}>
            <span class="family-name">
              {group.categoryIcon && (
                <span class="family-category-chip">
                  <img src={group.categoryIcon.file} alt="" loading="lazy" width="26" height="26" />
                </span>
              )}
              {group.displayName} <span class="family-count">({groupCount(group)})</span>
            </span>
            <span class="family-slug">{group.slug}</span>
          </h3>

          {group.blurb && <p class="group-blurb">{group.blurb}</p>}

          {group.defaultKey && (
            <div class="gallery-default-row">
              <IconGalleryCard entry={group.defaultKey} label="default icon" />
            </div>
          )}

          <div class="gallery-grid">
            {group.entries.map((e) => <IconGalleryCard entry={e} />)}
          </div>

          {group.dialEntries.length > 0 && (
            <div class="gallery-dial-row">
              <div class="gallery-dial-label">Dial</div>
              <div class="gallery-grid">
                {group.dialEntries.map((e) => <IconGalleryCard entry={e} label={dialLabel(e)} />)}
              </div>
            </div>
          )}
        </div>
      ))}
    </section>
  )}

  {dynamicEntries.length > 0 && (
    <section class="gallery-class" data-class="dynamic">
      <h2 id={`class-${dynamicSection.id}`}>{dynamicSection.label}</h2>
      <p>{dynamicSection.blurb}</p>
      <p class="section-size">{dynamicSection.blurbSize}</p>
      <div class="gallery-grid">
        {dynamicEntries.map((e) => <IconGalleryCard entry={e} />)}
      </div>
    </section>
  )}

  {orphanDials.length > 0 && (
    <section class="gallery-class" data-class="dial">
      <h2 id="class-dial">Dials</h2>
      <p>Dial assets (encoder icons and touch-strip dash-box samples) that couldn't be matched to an action group above.</p>
      <div class="gallery-grid">
        {orphanDials.map((e) => <IconGalleryCard entry={e} label={dialLabel(e)} />)}
      </div>
    </section>
  )}
</div>

<script>
  const filter = document.getElementById("icon-gallery-filter") as HTMLInputElement | null;
  const count = document.getElementById("icon-gallery-count");

  filter?.addEventListener("input", () => {
    const q = filter.value.trim().toLowerCase();
    let visible = 0;

    for (const card of document.querySelectorAll<HTMLElement>(".icon-card")) {
      const hit = !q || (card.dataset.search ?? "").includes(q);
      card.hidden = !hit;
      if (hit) visible++;
    }
    for (const group of document.querySelectorAll<HTMLElement>(".gallery-family")) {
      group.hidden = !group.querySelector(".icon-card:not([hidden])");
    }
    for (const section of document.querySelectorAll<HTMLElement>(".gallery-class")) {
      section.hidden = !section.querySelector(".icon-card:not([hidden])");
    }
    if (count) count.textContent = `${visible} icons`;
  });
</script>

<style>
  .icon-gallery h2 {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .icon-gallery h2:first-of-type {
    margin-top: 0.5rem;
  }
  .icon-gallery h3 {
    margin: 1rem 0 0.5rem;
  }
  .icon-gallery p {
    margin: 0.5rem 0;
  }
  #icon-gallery-filter {
    width: 100%;
    max-width: 24rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
  #icon-gallery-count {
    margin-left: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .section-size {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.5rem;
  }
  .gallery-default-row {
    margin-bottom: 0.5rem;
  }
  .family-name {
    display: block;
  }
  .family-category-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #0d0d0d;
    border-radius: 0.3rem;
    padding: 0.2rem;
    margin-right: 0.4rem;
    vertical-align: middle;
  }
  .family-count {
    color: var(--sl-color-gray-3);
    font-weight: normal;
  }
  .family-slug {
    display: block;
    margin-top: 0.1rem;
    font-size: var(--sl-text-xs);
    font-weight: normal;
    color: var(--sl-color-gray-3);
  }
  .group-blurb {
    /* Styled like section blurbs: plain paragraph formatting */
  }
  .gallery-dial-row {
    margin-top: 0.75rem;
  }
  .gallery-dial-label {
    text-transform: uppercase;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.3rem;
  }
  .gallery-size-facts {
    margin: 0.5rem 0 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .gallery-size-facts p {
    margin: 0 0 0.4rem;
    font-weight: 600;
    text-transform: uppercase;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-2);
  }
  .gallery-size-facts ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .gallery-size-facts li {
    margin: 0.2rem 0;
  }
</style>
