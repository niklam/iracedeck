---
// packages/website/src/components/IconGallery.astro
// Renders the generated icon inventory (src/data/icon-gallery.json) as a
// searchable, per-family grouped gallery. Assets live in /icon-gallery/.
import entries from "../data/icon-gallery.json";
import type { GalleryEntry } from "../gallery-gen/lib.js";
import {
  categoryRemainder,
  CLASS_SECTIONS,
  defaultCategoryFor,
  defaultKeyFor,
  familiesOf,
  familyAnchor,
  familyDisplayName,
  keyRemainder,
} from "../gallery-gen/sections.js";
import IconGalleryCard from "./IconGalleryCard.astro";

const all = entries as GalleryEntry[];

// The standalone "Static default key images" / "Category icons" sections only
// show the remainder — entries that couldn't be placed into a template family
// group (item 10) or beside a family heading (item 15).
const keyRemainderEntries = keyRemainder(all);
const categoryRemainderEntries = categoryRemainder(all);

function entriesForSection(sectionId: string): GalleryEntry[] {
  if (sectionId === "key") return keyRemainderEntries;
  if (sectionId === "category") return categoryRemainderEntries;

  return all.filter((e) => e.class === sectionId);
}
---

<div class="icon-gallery not-content">
  <p>
    <input id="icon-gallery-filter" type="search" placeholder="Filter by name, family, action, or title…" aria-label="Filter icons" />
    <span id="icon-gallery-count">{all.length} icons</span>
  </p>

  {CLASS_SECTIONS.map((section) => {
    const sectionEntries = entriesForSection(section.id);

    // The remainder-only "key" section disappears entirely once every key
    // entry has been placed into its template family group (item 10).
    if (sectionEntries.length === 0) return null;

    return (
      <section class="gallery-class" data-class={section.id}>
        <h2 id={`class-${section.id}`}>{section.label}</h2>
        <p>{section.blurb}</p>
        <p class="section-size">{section.blurbSize}</p>

        {section.flat ? (
          <div class="gallery-grid">
            {sectionEntries.map((e) => <IconGalleryCard entry={e} />)}
          </div>
        ) : (
          familiesOf(all, section.id).map(([family, icons]) => {
            const defaultKey = defaultKeyFor(all, family);
            const categoryIcon = defaultCategoryFor(all, family);
            const count = icons.length + (defaultKey ? 1 : 0);

            return (
              <div class="gallery-family">
                <h3 id={familyAnchor(section.id, family)}>
                  <span class="family-name">
                    {categoryIcon && (
                      <span class="family-category-chip">
                        <img src={categoryIcon.file} alt="" loading="lazy" width="26" height="26" />
                      </span>
                    )}
                    {familyDisplayName(family, all)} <span class="family-count">({count})</span>
                  </span>
                  <span class="family-slug">{family}</span>
                </h3>
                <div class="gallery-grid">
                  {defaultKey && <IconGalleryCard entry={defaultKey} label="default icon" />}
                  {icons.map((e) => <IconGalleryCard entry={e} />)}
                </div>
              </div>
            );
          })
        )}
      </section>
    );
  })}
</div>

<script>
  const filter = document.getElementById("icon-gallery-filter") as HTMLInputElement | null;
  const count = document.getElementById("icon-gallery-count");

  filter?.addEventListener("input", () => {
    const q = filter.value.trim().toLowerCase();
    let visible = 0;

    for (const card of document.querySelectorAll<HTMLElement>(".icon-card")) {
      const hit = !q || (card.dataset.search ?? "").includes(q);
      card.hidden = !hit;
      if (hit) visible++;
    }
    for (const group of document.querySelectorAll<HTMLElement>(".gallery-family")) {
      group.hidden = !group.querySelector(".icon-card:not([hidden])");
    }
    for (const section of document.querySelectorAll<HTMLElement>(".gallery-class")) {
      section.hidden = !section.querySelector(".icon-card:not([hidden])");
    }
    if (count) count.textContent = `${visible} icons`;
  });
</script>

<style>
  .icon-gallery h2 {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .icon-gallery h2:first-of-type {
    margin-top: 0.5rem;
  }
  .icon-gallery h3 {
    margin: 1rem 0 0.5rem;
  }
  .icon-gallery p {
    margin: 0.5rem 0;
  }
  #icon-gallery-filter {
    width: 100%;
    max-width: 24rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
  #icon-gallery-count {
    margin-left: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .section-size {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.5rem;
  }
  .family-name {
    display: block;
  }
  .family-category-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #0d0d0d;
    border-radius: 0.3rem;
    padding: 0.2rem;
    margin-right: 0.4rem;
    vertical-align: middle;
  }
  .family-count {
    color: var(--sl-color-gray-3);
    font-weight: normal;
  }
  .family-slug {
    display: block;
    margin-top: 0.1rem;
    font-size: var(--sl-text-xs);
    font-weight: normal;
    color: var(--sl-color-gray-3);
  }
</style>
