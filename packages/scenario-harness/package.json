{
  "name": "@iracedeck/scenario-harness",
  "version": "2.1.1",
  "description": "Local development tool for playing Race Engineer / Pit Crew audio scenarios without launching iRacing. Boots the real event-bus / audio-service / audio-scenarios / sim-events-iracing translator with a mock SDK controller and serves a web UI for live state mutation, ad-hoc event injection, and audio activity monitoring.",
  "type": "module",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "9.1.3",
    "@fastify/websocket": "11.3.0",
    "@iracedeck/audio-assets": "workspace:*",
    "@iracedeck/audio-native": "workspace:*",
    "@iracedeck/audio-scenarios": "workspace:*",
    "@iracedeck/audio-service": "workspace:*",
    "@iracedeck/deck-core": "workspace:*",
    "@iracedeck/event-bus": "workspace:*",
    "@iracedeck/iracing-sdk": "workspace:*",
    "@iracedeck/logger": "workspace:*",
    "@iracedeck/sim-events-iracing": "workspace:*",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.5",
    "@types/node": "26.1.1",
    "rimraf": "6.1.3",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
