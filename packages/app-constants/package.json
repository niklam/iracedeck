{
  "name": "@iracedeck/app-constants",
  "version": "3.6.0-dev.0",
  "description": "The constants every layer and the Property Inspector's browser bundle share: setting-key names, value sets, settings-window ids, and the pure functions over them. Zero dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
