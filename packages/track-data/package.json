    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.5",
    "@types/node": "26.2.0",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
