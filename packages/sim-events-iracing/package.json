{
  "name": "@iracedeck/sim-events-iracing",
  "version": "1.15.0-beta.0",
  "description": "iRacing telemetry translator. Diffs sdkController ticks against previous state and publishes semantic events on @iracedeck/event-bus.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iracedeck/event-bus": "workspace:*",
    "@iracedeck/iracing-sdk": "workspace:*",
    "@iracedeck/logger": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.5",
    "@types/node": "25.6.0",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
