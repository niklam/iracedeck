{
  "name": "@iracedeck/track-store",
  "version": "3.9.0-dev.0",
  "description": "The per-track store: pit-lane landmarks learned from live telemetry, one file per TrackID shared by every deck host, merged on every debounced atomic write.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "dependencies": {
    "@iracedeck/logger": "workspace:*",
    "@iracedeck/settings": "workspace:*",
    "@iracedeck/track-data": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.5",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
