{
  "name": "@iracedeck/deck-core",
  "version": "3.6.0-dev.0",
  "description": "Platform-agnostic core interfaces and base classes for deck device plugins",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@iracedeck/app-constants": "workspace:*",
    "@iracedeck/icon-composer": "workspace:*",
    "@iracedeck/logger": "workspace:*",
    "@iracedeck/settings": "workspace:*",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "keysender": "2.4.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.4",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
