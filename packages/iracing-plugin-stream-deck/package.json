{
  "name": "@iracedeck/iracing-plugin-stream-deck",
  "version": "3.8.1",
  "description": "Stream Deck plugin for iRacing - Core driving and interface controls",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "rollup -c && pnpm run postbuild",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postbuild": "node ../../scripts/install-runtime-deps.mjs com.iracedeck.sd.core.sdPlugin/bin",
    "watch": "node ../../scripts/generate-changelog-data.mjs && rollup -c -w --watch.onEnd=\"streamdeck restart com.iracedeck.sd.core\"",
    "clean": "rimraf com.iracedeck.sd.core.sdPlugin/bin/plugin.js com.iracedeck.sd.core.sdPlugin/bin/plugin.js.map",
    "pack:plugin": "node ../../scripts/assert-release-build.mjs com.iracedeck.sd.core.sdPlugin/bin/config.json && streamdeck pack com.iracedeck.sd.core.sdPlugin --force -o ../../local/\"Stream Deck\" && rimraf com.iracedeck.sd.core.sdPlugin/assets/audio",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.2",
    "@iracedeck/app-constants": "workspace:*",
    "@iracedeck/deck-adapter-elgato": "workspace:*",
    "@iracedeck/deck-core": "workspace:*",
    "@iracedeck/iracing-actions": "workspace:*",
    "@iracedeck/logger": "workspace:*",
    "@iracedeck/plugin-runtime": "workspace:*",
    "@iracedeck/settings": "workspace:*"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.2",
    "@iracedeck/plugin-build": "workspace:*",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.5",
    "rimraf": "6.1.3",
    "rollup": "4.64.8",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "SEE LICENSE IN LICENSE"
}
