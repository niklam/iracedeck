# Node.js
node_modules/

# Stream Deck files
*.sdPlugin/bin
*.sdPlugin/logs
*.sdPlugin/.mock

# PI assets copied/compiled at build time (source of truth in @iracedeck/pi-components)
*.sdPlugin/ui/*.html
*.sdPlugin/ui/pi-components.js
*.sdPlugin/ui/sdpi-components.js

# Per-action static icons copied at build time (source of truth in @iracedeck/iracing-actions)
*.sdPlugin/imgs/actions/

# Audio assets (copied from @iracedeck/audio-assets at build time)
*.sdPlugin/assets/audio

# Font assets (rasterized at build time)
*.sdPlugin/assets/fonts

# License files copied from the repo root at build time (#905)
*.sdPlugin/LICENSE
*.sdPlugin/THIRD-PARTY-LICENSES.md

# Packaged plugin artifacts (streamdeck pack output / manual zips)
*.streamDeckPlugin
*.zip

