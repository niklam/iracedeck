{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "fuel-dial",
  "items": [
    {
      "key": "title",
      "type": "text",
      "rect": [0, 6, 200, 20],
      "alignment": "center",
      "font": { "size": 16, "weight": 600 }
    },
    {
      "key": "value",
      "type": "text",
      "rect": [0, 28, 200, 36],
      "alignment": "center",
      "font": { "size": 26, "weight": 700 }
    },
    {
      "key": "indicator",
      "type": "bar",
      "rect": [12, 76, 176, 14],
      "subtype": 0,
      "bar_bg_c": "#333333",
      "range": { "min": 0, "max": 100 }
    }
  ]
}
