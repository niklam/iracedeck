{
  "name": "@iracedeck/settings-window",
  "version": "3.6.0-dev.0",
  "description": "The settings window: the loopback server and its request guard, the app-window launcher, the command handler, the warning banner, the settings-channel publisher and Explorer reveal.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "dependencies": {
    "@iracedeck/app-constants": "workspace:*",
    "@iracedeck/app-updates": "workspace:*",
    "@iracedeck/callout-script": "workspace:*",
    "@iracedeck/logger": "workspace:*",
    "@iracedeck/settings": "workspace:*",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.4",
    "@types/ws": "8.18.2",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
