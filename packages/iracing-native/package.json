{
  "name": "@iracedeck/iracing-native",
  "version": "3.5.0-dev.0",
  "description": "Native Node.js addon for iRacing SDK - Win32 memory-mapped file and window messaging",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "install": "echo Run build manually in iracing-native to avoid extra builds",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "files": [
    "dist",
    "build/Release/*.node",
    "src/*.cc"
  ],
  "devDependencies": {
    "@types/node": "26.6.4",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "iracing",
    "native",
    "node-addon",
    "win32",
    "memory-mapped-file"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
