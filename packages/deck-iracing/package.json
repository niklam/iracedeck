{
  "name": "@iracedeck/deck-iracing",
  "version": "3.6.0-dev.0",
  "description": "iRacing's side of the deck layer's sim-connection seam: SimIRacingConnection, the SimIRacingAction base, the SDK singleton and the iRacing helpers actions share.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "dependencies": {
    "@iracedeck/deck-core": "workspace:*",
    "@iracedeck/iracing-sdk": "workspace:*",
    "@iracedeck/logger": "workspace:*",
    "@iracedeck/settings": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.4",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
