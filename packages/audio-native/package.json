{
  "name": "@iracedeck/audio-native",
  "version": "2.3.0-dev.0",
  "description": "Native Node.js addon for miniaudio-based multi-channel audio mixer",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "install": "echo Run build manually in audio-native to avoid extra builds",
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "build/Release/*.node",
    "src/*.cc",
    "src/*.h"
  ],
  "devDependencies": {
    "@types/node": "26.1.2",
    "node-addon-api": "8.9.0",
    "node-gyp": "13.0.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "iracedeck",
    "audio",
    "miniaudio",
    "node-addon",
    "mixer"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
