{
  "name": "@iracedeck/plugin-build",
  "version": "3.6.0-dev.0",
  "description": "Build-only: createPluginRollupConfig(options), the one Rollup config the three deck plugins share, and the externals list their bin folders install.",
  "type": "module",
  "exports": {
    ".": "./src/plugin-rollup.mjs",
    "./externals": "./src/externals.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/test-package.mjs",
    "test:watch": "node ../../scripts/test-package.mjs --watch"
  },
  "dependencies": {
    "@iracedeck/app-constants": "workspace:*",
    "@iracedeck/audio-assets": "workspace:*",
    "@iracedeck/pi-components": "workspace:*",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.4",
    "rollup": "4.64.0",
    "vitest": "5.0.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
