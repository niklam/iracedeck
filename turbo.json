{
  "$schema": "https://v2-8-1.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "build/**",
        "bin/**",
        "browser/pi-components.js",
        "browser/ulanzi-pi-bridge.js",
        "browser/settings-window-bridge.js",
        "browser/pi-settings-bridge.js",
        "com.iracedeck.sd.sdPlugin/**",
        "com.iracedeck.sd.*.sdPlugin/**",
        "com.ulanzi.*.ulanziPlugin/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@iracedeck/audio-assets#build": {
      "dependsOn": ["@iracedeck/callout-script#build"],
      "inputs": ["voice/**", "src/build/**", "src/presets.mjs"],
      "outputs": [".cache/**"]
    },
    "@iracedeck/audio-assets#stage:dev-voices": {
      "dependsOn": ["@iracedeck/callout-script#build", "@iracedeck/audio-assets#build"],
      "cache": false,
      "env": ["IRACEDECK_DEV_VOICES"],
      "inputs": [
        "voice/**",
        "configs/**",
        "scripts/pack-voice.mjs",
        "scripts/stage-dev-voices.mjs",
        "src/build/**",
        "src/presets.mjs",
        "$TURBO_ROOT$/dev.local.json",
        "$TURBO_ROOT$/scripts/lib/dev-local.mjs"
      ]
    },
    "@iracedeck/iracing-plugin-mirabox#build": {
      "dependsOn": ["^build", "@iracedeck/audio-assets#stage:dev-voices"],
      "env": ["IRACEDECK_DEV_VOICES"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/dev.local.json",
        "$TURBO_ROOT$/feature-flags.local.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/scripts/lib/dev-local.mjs",
        "$TURBO_ROOT$/scripts/lib/rollup-logs.mjs",
        "$TURBO_ROOT$/scripts/lib/runtime-deps.mjs"
      ],
      "outputs": ["com.iracedeck.sd.*.sdPlugin/**"]
    },
    "@iracedeck/iracing-plugin-stream-deck#build": {
      "dependsOn": ["^build", "@iracedeck/audio-assets#stage:dev-voices"],
      "env": ["IRACEDECK_DEV_VOICES"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/dev.local.json",
        "$TURBO_ROOT$/feature-flags.local.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/scripts/lib/dev-local.mjs",
        "$TURBO_ROOT$/scripts/lib/rollup-logs.mjs",
        "$TURBO_ROOT$/scripts/lib/runtime-deps.mjs"
      ],
      "outputs": ["com.iracedeck.sd.*.sdPlugin/**"]
    },
    "@iracedeck/iracing-plugin-ulanzi#build": {
      "dependsOn": ["^build", "@iracedeck/audio-assets#stage:dev-voices"],
      "env": ["IRACEDECK_DEV_VOICES"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/dev.local.json",
        "$TURBO_ROOT$/feature-flags.local.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/scripts/lib/dev-local.mjs",
        "$TURBO_ROOT$/scripts/lib/rollup-logs.mjs",
        "$TURBO_ROOT$/scripts/lib/runtime-deps.mjs"
      ],
      "outputs": ["com.ulanzi.*.ulanziPlugin/**"]
    },
    "@iracedeck/website#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/icons/**",
        "$TURBO_ROOT$/packages/iracing-actions/icons/**",
        "$TURBO_ROOT$/packages/iracing-actions/src/**",
        "$TURBO_ROOT$/packages/iracing-plugin-stream-deck/com.iracedeck.sd.core.sdPlugin/manifest.json"
      ]
    },
    "@iracedeck/website#build": {
      "dependsOn": ["^build"],
      "env": ["PUBLIC_IRACEDECK_VERSION"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/lib/changelog-*.mjs",
        "$TURBO_ROOT$/scripts/lib/voice-catalog-data.mjs",
        "$TURBO_ROOT$/packages/audio-assets/catalog/**",
        "$TURBO_ROOT$/packages/icons/**",
        "$TURBO_ROOT$/packages/iracing-actions/icons/**",
        "$TURBO_ROOT$/packages/iracing-actions/src/**",
        "$TURBO_ROOT$/packages/iracing-plugin-stream-deck/com.iracedeck.sd.core.sdPlugin/manifest.json"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
