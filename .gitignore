# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
yarn.lock
*.log

# pnpm
# Note: pnpm-lock.yaml should be committed

# Build output
/dist/
/packages/*/dist/
/build/
/packages/*/build/

# Astro/Starlight generated files
/packages/website/.astro/

# Stream Deck plugin packages (built artifacts)
*.streamDeckPlugin

# TypeScript
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
.cache/

# Environment variables
.env
.env.local
.env.*.local

# Platform feature flag local override (dev-only, merges over platform-features.json at build time)
feature-flags.local.json

# Debug
*.pdb

# Python
Python/

# Turbo
.turbo/

# Local scripts
scripts/local/

# Local data (snapshots, scratch files)
local/*
!local/.gitkeep

# Git worktrees (parallel implementation)
.worktrees/

# Radio-effect spike (local samples + generated outputs)
scripts/radio-effect/input/*
!scripts/radio-effect/input/.gitkeep
scripts/radio-effect/output/*
!scripts/radio-effect/output/.gitkeep

# Claude Code
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Serena local project metadata
.serena/

# Superpowers brainstorming artifacts
.superpowers/

# Superpowers implementation plans - written for every implementation, never committed
# Policy: docs/superpowers/specs/2026-08-25-issue-621-process-docs-policy.md
docs/superpowers/plans/*
!docs/superpowers/plans/.gitkeep

# Release packaging output (plugins and voice-pack archives); CI-only, but a local dry run of scripts/publish-voice-packs.mjs writes here too
packed/
