{
  "companyAnnouncements": [
    "Let's build something amazing for the racers!",
    "Ooh, you're so handsome!",
    "I want to be like you!"
  ],
  "cleanupPeriodDays": 5,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [],
    "ask": [],
    "allow": [
      "Bash(cd:*)",
      "Bash(dir:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr edit:*)",
      "Bash(git check-ignore:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(grep:*)",
      "Bash(pnpm build:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(* --version)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/session-start.mjs\"",
            "timeout": 30,
            "statusMessage": "Reading worktrees, plugin links and origin/master"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/pre-bash.mjs\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Skill|Agent|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/pre-tools.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/post-edit.mjs\"",
            "timeout": 180,
            "statusMessage": "Running the generator for the edited file"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/post-bash.mjs\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
